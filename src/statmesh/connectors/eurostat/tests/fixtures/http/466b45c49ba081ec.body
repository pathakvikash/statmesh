ode List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Weekly</c:Name><c:Name xml:lang="de">Wöchentlich</c:Name><c:Name xml:lang="fr">Hebdomadaire</c:Name></s:Code><s:Code id="B" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:FREQ(3.9).B"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Daily - business week</c:Name><c:Name xml:lang="de">Täglich - pro Geschäftswoche</c:Name><c:Name xml:lang="fr">Jours ouvrable</c:Name></s:Code><s:Code id="D" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:FREQ(3.9).D"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Daily</c:Name><c:Name xml:lang="de">Täglich</c:Name><c:Name xml:lang="fr">Journalier</c:Name></s:Code><s:Code id="H" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:FREQ(3.9).H"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Hourly</c:Name><c:Name xml:lang="de">Stündlich</c:Name><c:Name xml:lang="fr">Horaire</c:Name></s:Code><s:Code id="I" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:FREQ(3.9).I"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c: