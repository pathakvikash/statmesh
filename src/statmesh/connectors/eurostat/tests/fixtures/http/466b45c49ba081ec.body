<s:Codelist xmlns:s="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/structure" xmlns:m="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/message" xmlns:c="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/common" agencyID="ESTAT" id="AGE" isFinal="true" urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=ESTAT:AGE(18.0)" version="18.0"><c:Annotations><c:Annotation><c:AnnotationTitle>2026-11-03T23:00:00+0100</c:AnnotationTitle><c:AnnotationType>LAST_UPDATED</c:AnnotationType></c:Annotation><c:Annotation><c:AnnotationTitle>C</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE_LIST</c:AnnotationType><c:AnnotationText xml:lang="en">Combined code list, contains standard codes and codes not associated with the concept of the code list</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationType>ARTEFACT_SOURCE</c:AnnotationType><c:AnnotationText xml:lang="en">Eurostat Standard Code Lists</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationType>EXPLAN_LABEL</c:AnnotationType><c:AnnotationText xml:lang="en">The standard code list on age has been defined on the basis of the best practices used in the main domains supplying statistics according to the age breakdown (demography, Labour Force Survey, etc.), taking into account the 1982 UN document - Provisional guidelines on standard international age classifications. The code list covers single years of age, 5-year and 10-year age classes; it includes as well all the additional aggregates required for the needs of all statistical domains covered by the Reference database. In every age class the limits are included, unless explicitly stated; codes and labels are defined as follows: Y_LT15 Less than 15 years (i.e. 15 years excluded); Y_LE15 15 years or less (i.e. 15 years included); Y15-24 From 15 to 24 years (i.e. from 15 years included to 24 years included (i.e. less than 25)); Y_GT25 Over 25 years (i.e. 25 years excluded); Y_GE25 25 years or over (i.e. 25 years included)</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>N</c:AnnotationTitle><c:AnnotationType>DERIVED</c:AnnotationType><c:AnnotationText xml:lang="en">Not derived</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Age class</c:Name><c:Name xml:lang="de">Altersklasse</c:Name><c:Name xml:lang="fr">Classe d'âge</c:Name><c:Description xml:lang="en">This code list contains periods of time, i.e. the length of time that a person or an animal has lived or a plant or an entity related to human beings has existed. Age is usually measured in completed years, months, weeks, days, hours or minutes of life, as appropriate. Apart from that, the age of a means of transport is defined as: Length of time after the first registration of a means of transport as new.</c:Description><s:Code id="TOTAL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).TOTAL"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Total</c:Name><c:Name xml:lang="de">Insgesamt</c:Name><c:Name xml:lang="fr">Total</c:Name></s:Code><s:Code id="LFD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).LFD"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Late foetal death</c:Name><c:Name xml:lang="de">Später Fetaltod</c:Name><c:Name xml:lang="fr">Mort foetale tardive</c:Name></s:Code><s:Code id="LFD1" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).LFD1"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Late foetal death (group 1)</c:Name><c:Name xml:lang="de">Totgeburt (Gruppe 1)</c:Name><c:Name xml:lang="fr">Mort-né (groupe 1)</c:Name></s:Code><s:Code id="LFD2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).LFD2"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Late foetal death (group 2)</c:Name><c:Name xml:lang="de">Totgeburt (Gruppe 2)</c:Name><c:Name xml:lang="fr">Mort-né (groupe 2)</c:Name></s:Code><s:Code id="MN0" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).MN0"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Zero minutes</c:Name><c:Name xml:lang="de">Null Minuten</c:Name><c:Name xml:lang="fr">Zéro minutes</c:Name></s:Code><s:Code id="MN1-9" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).MN1-9"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">From 1 to 9 minutes</c:Name><c:Name xml:lang="de">1 bis 9 Minuten</c:Name><c:Name xml:lang="fr">De 1 à 9 minutes</c:Name></s:Code><s:Code id="MN1-14" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).MN1-14"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">From 1 to 14 minutes</c:Name><c:Name xml:lang="de">1 bis 14 Minuten</c:Name><c:Name xml:lang="fr">De 1 à 14 minutes</c:Name></s:Code><s:Code id="MN1-59" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).MN1-59"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">From 1 to 59 minutes</c:Name><c:Name xml:lang="de">1 bis 59 Minuten</c:Name><c:Name xml:lang="fr">De 1 à 59 minutes</c:Name></s:Code><s:Code id="MN1-74" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).MN1-74"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">From 1 to 74 minutes</c:Name><c:Name xml:lang="de">1 bis 74 Minuten</c:Name><c:Name xml:lang="fr">De 1 à 74 minutes</c:Name></s:Code><s:Code id="MN1-149" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).MN1-149"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">From 1 to 149 minutes</c:Name><c:Name xml:lang="de">1 bis 149 Minuten</c:Name><c:Name xml:lang="fr">De 1 à 149 minutes</c:Name></s:Code><s:Code id="Y15-74" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:AGE(18.0).Y15-74"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">From 15 to 74 years</c:Name><c:Name xml:lang="de">15 bis 74 Jahre</c:Name><c:Name xml:lang="fr">De 15 à 74 ans</c:Name></s:Code></s:Codelist>
<s:Codelist xmlns:s="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/structure" xmlns:m="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/message" xmlns:c="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/common" agencyID="ESTAT" id="UNIT" isFinal="true" urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=ESTAT:UNIT(84.0)" version="84.0"><c:Annotations><c:Annotation><c:AnnotationTitle>2026-10-21T23:00:00+0200</c:AnnotationTitle><c:AnnotationType>LAST_UPDATED</c:AnnotationType></c:Annotation><c:Annotation><c:AnnotationTitle>C</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE_LIST</c:AnnotationType><c:AnnotationText xml:lang="en">Combined code list, contains standard codes and codes not associated with the concept of the code list</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationType>ARTEFACT_SOURCE</c:AnnotationType><c:AnnotationText xml:lang="en">Eurostat Standard Code Lists</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>N</c:AnnotationTitle><c:AnnotationType>DERIVED</c:AnnotationType><c:AnnotationText xml:lang="en">Not derived</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Unit of measure</c:Name><c:Name xml:lang="de">Maßeinheit</c:Name><c:Name xml:lang="fr">Unité de mesure</c:Name><c:Description xml:lang="en">This code list specifies the standard measurement unit that is used to count inventoried items and express them in specific quantities.</c:Description><s:Code id="TOTAL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:UNIT(84.0).TOTAL"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Total</c:Name><c:Name xml:lang="de">Insgesamt</c:Name><c:Name xml:lang="fr">Total</c:Name></s:Code><s:Code id="NR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:UNIT(84.0).NR"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Number</c:Name><c:Name xml:lang="de">Anzahl</c:Name><c:Name xml:lang="fr">Nombre</c:Name></s:Code><s:Code id="NR_HAB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:UNIT(84.0).NR_HAB"><c:Annotations><c:Annotation><c:AnnotationTitle>M</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Code not associated with the concept of the code list, but following Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Number per inhabitant</c:Name><c:Name xml:lang="de">Anzahl pro Einwohner</c:Name><c:Name xml:lang="fr">Nombre par habitant</c:Name></s:Code><s:Code id="NR_HHAB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:UNIT(84.0).NR_HHAB"><c:Annotations><c:Annotation><c:AnnotationTitle>M</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Code not associated with the concept of the code list, but following Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Number per hundred inhabitants</c:Name><c:Name xml:lang="de">Anzahl pro hundert Einwohner</c:Name><c:Name xml:lang="fr">Nombre par centaine d'habitants</c:Name></s:Code><s:Code id="NR_HTHAB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:UNIT(84.0).NR_HTHAB"><c:Annotations><c:Annotation><c:AnnotationTitle>M</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Code not associated with the concept of the code list, but following Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Number per hundred thousand persons</c:Name><c:Name xml:lang="de">Anzahl pro hunderttausend Personen</c:Name><c:Name xml:lang="fr">Nombre par centaine de milliers de personnes</c:Name></s:Code><s:Code id="THS" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:UNIT(84.0).THS"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Thousand</c:Name><c:Name xml:lang="de">Tausend</c:Name><c:Name xml:lang="fr">Millier</c:Name></s:Code><s:Code id="MIO" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:UNIT(84.0).MIO"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Million</c:Name><c:Name xml:lang="de">Million</c:Name><c:Name xml:lang="fr">Million</c:Name></s:Code><s:Code id="BN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:UNIT(84.0).BN"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Billion</c:Name><c:Name xml:lang="de">Milliarde</c:Name><c:Name xml:lang="fr">Milliard</c:Name></s:Code><s:Code id="CT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:UNIT(84.0).CT"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Euro cent</c:Name><c:Name xml:lang