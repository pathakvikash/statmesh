<s:Codelist xmlns:s="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/structure" xmlns:m="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/message" xmlns:c="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/common" agencyID="ESTAT" id="SEX" isFinal="true" urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=ESTAT:SEX(2.0)" version="2.0"><c:Annotations><c:Annotation><c:AnnotationTitle>2026-08-12T23:00:00+0200</c:AnnotationTitle><c:AnnotationType>LAST_UPDATED</c:AnnotationType></c:Annotation><c:Annotation><c:AnnotationTitle>C</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE_LIST</c:AnnotationType><c:AnnotationText xml:lang="en">Combined code list, contains standard codes and codes not associated with the concept of the code list</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationType>ARTEFACT_SOURCE</c:AnnotationType><c:AnnotationText xml:lang="en">Eurostat Standard Code Lists</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>N</c:AnnotationTitle><c:AnnotationType>DERIVED</c:AnnotationType><c:AnnotationText xml:lang="en">Not derived</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Sex</c:Name><c:Name xml:lang="de">Geschlecht</c:Name><c:Name xml:lang="fr">Sexe</c:Name><c:Description xml:lang="en">This code list provides information about the state of being male or female and refers to their biological and physiological characteristics.</c:Description><s:Code id="T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:SEX(2.0).T"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Total</c:Name><c:Name xml:lang="de">Insgesamt</c:Name><c:Name xml:lang="fr">Total</c:Name></s:Code><s:Code id="M" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:SEX(2.0).M"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Males</c:Name><c:Name xml:lang="de">Männer</c:Name><c:Name xml:lang="fr">Hommes</c:Name></s:Code><s:Code id="F" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:SEX(2.0).F"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Females</c:Name><c:Name xml:lang="de">Frauen</c:Name><c:Name xml:lang="fr">Femmes</c:Name></s:Code><s:Code id="DIFF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:SEX(2.0).DIFF"><c:Annotations><c:Annotation><c:AnnotationTitle>M</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Code not associated with the concept of the code list, but following Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Absolute difference between males and females</c:Name><c:Name xml:lang="de">Absolute Differenz zwischen Männern und Frauen</c:Name><c:Name xml:lang="fr">Différence absolue entre hommes et femmes</c:Name></s:Code><s:Code id="OTH" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:SEX(2.0).OTH"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Other</c:Name><c:Name xml:lang="de">Andere</c:Name><c:Name xml:lang="fr">Autre</c:Name></s:Code><s:Code id="NAP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:SEX(2.0).NAP"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Not applicable</c:Name><c:Name xml:lang="de">Nicht anwendbar</c:Name><c:Name xml:lang="fr">Non applicable</c:Name></s:Code><s:Code id="NRP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:SEX(2.0).NRP"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">No response</c:Name><c:Name xml:lang="de">Keine Antwort</c:Name><c:Name xml:lang="fr">Sans réponse</c:Name></s:Code><s:Code id="UNK" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:SEX(2.0).UNK"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Unknown</c:Name><c:Name xml:lang="de">Unbekannt</c:Name><c:Name xml:lang="fr">Inconnu</c:Name></s:Code></s:Codelist>
<s:Codelist xmlns:s="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/structure" xmlns:m="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/message" xmlns:c="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/common" agencyID="ESTAT" id="GEO" isFinal="true" urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=ESTAT:GEO(28.0)" version="28.0"><c:Annotations><c:Annotation><c:AnnotationTitle>2026-03-25T23:00:00+0100</c:AnnotationTitle><c:AnnotationType>LAST_UPDATED</c:AnnotationType></c:Annotation><c:Annotation><c:AnnotationTitle>C</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE_LIST</c:AnnotationType><c:AnnotationText xml:lang="en">Combined code list, contains standard codes and codes not associated with the concept of the code list</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationType>ARTEFACT_SOURCE</c:AnnotationType><c:AnnotationText xml:lang="en">Eurostat Standard Code Lists</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationType>EXPLAN_LABEL</c:AnnotationType><c:AnnotationText xml:lang="en">The geographical standard code list provides codes on geographical entities at the level of aggregates, countries, regions and organizations; the labels are available in EN, DE and FR and they are in line with the EU Interinstitutional Style Guide. The work is based on various international sources:  Interinstitutional Style Guide, ISO 3166 country codes (3166-1 alpha-2), UN standard country and area codes classification. The structure follows the UN standard country or area code classification (M49) and adopts in most of the cases the proposed geographical order. In case of conflict, the most appropriate solution in the interest of the ESS has been chosen. The country codes correspond to the ISO 3166 classification with the exception of: United Kingdom where the code UK was adopted (instead of GB) and Greece where the code EL was adopted (instead of GR) in order to comply with the Interinstitutional Style Guide. The presentation of the code list has been enhanced with additional information on the composition of the aggregates and on the dependency status of various geographical entities (mainly overseas territories). ISO 3166-1-alpha-2 - ISO 3166 International Standard for country codes; NUTS</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>N</c:AnnotationTitle><c:AnnotationType>DERIVED</c:AnnotationType><c:AnnotationText xml:lang="en">Not derived</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">Geopolitical entity (reporting)</c:Name><c:Name xml:lang="de">Geopolitische Meldeeinheit</c:Name><c:Name xml:lang="fr">Entité géopolitique (déclarante)</c:Name><c:Description xml:lang="en">This code list defines the reporting geopolitical entities.</c:Description><s:Code id="EUR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:GEO(28.0).EUR"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationType>EXPLAN_LABEL</c:AnnotationType><c:AnnotationText xml:lang="en">This aggregate covers following countries and territories: BE, BG, CZ, DK, DE, EE, IE, EL, ES, FR, HR, IT, CY, LV, LT, LU, HU, MT, NL, AT, PL, PT, RO, SI, SK, FI, SE, IS, LI, NO, CH, UK, BA, ME, MD, MK, AL, RS, TR, UA, XK, BY, RU, FO, GG, IM, JE, AD, GI, VA, SM and MC.</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>AGG</c:AnnotationTitle><c:AnnotationType>LEVEL</c:AnnotationType></c:Annotation></c:Annotations><c:Name xml:lang="en">Europe</c:Name><c:Name xml:lang="de">Europa</c:Name><c:Name xml:lang="fr">Europe</c:Name></s:Code><s:Code id="EU" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:GEO(28.0).EU"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>EUR</c:AnnotationTitle><c:AnnotationType>EC_CORPORATE_CODE</c:AnnotationType><c:AnnotationURL>http://publications.europa.eu/resource/authority/country/EUR</c:AnnotationURL></c:Annotation><c:Annotation><c:AnnotationTitle>AGG</c:AnnotationTitle><c:AnnotationType>LEVEL</c:AnnotationType></c:Annotation></c:Annotations><c:Name xml:lang="en">European Union (EU6-1958, EU9-1973, EU10-1981, EU12-1986, EU15-1995, EU25-2004, EU27-2007, EU28-2013, EU27-2020)</c:Name><c:Name xml:lang="de">Europäische Union (EU6-1958, EU9-1973, EU10-1981, EU12-1986, EU15-1995, EU25-2004, EU27-2007, EU28-2013, EU27-2020)</c:Name><c:Name xml:lang="fr">Union européenne (UE6-1958, UE9-1973, UE10-1981, UE12-1986, UE15-1995, UE25-2004, UE27-2007, UE28-2013, UE27-2020)</c:Name></s:Code><s:Code id="EU_V" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:GEO(28.0).EU_V"><c:Annotations><c:Annotation><c:AnnotationTitle>M</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Code not associated with the concept of the code list, but following Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>AGG</c:AnnotationTitle><c:AnnotationType>LEVEL</c:AnnotationType></c:Annotation></c:Annotations><c:Name xml:lang="en">European Union (aggregate changing according to the context)</c:Name><c:Name xml:lang="de">Europäische Union (Aggregat ändert sich je nach Anwendungsbereich)</c:Name><c:Name xml:lang="fr">Union européenne (agrégat variable en fonction du contexte)</c:Name></s:Code><s:Code id="EU_V_NO" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:GEO(28.0).EU_V_NO"><c:Annotations><c:Annotation><c:AnnotationTitle>M</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Code not associated with the concept of the code list, but following Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>AGG</c:AnnotationTitle><c:AnnotationType>LEVEL</c:AnnotationType></c:Annotation></c:Annotations><c:Name xml:lang="en">European Union (aggregate changing according to the context) and Norway</c:Name><c:Name xml:lang="de">Europäische Union (Aggregat ändert sich je nach Anwendungsbereich) und Norwegen</c:Name><c:Name xml:lang="fr">Union européenne (agrégat variable en fonction du contexte) et Norvège</c:Name></s:Code><s:Code id="EU27_2020_EFTA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:GEO(28.0).EU27_2020_EFTA"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>AGG</c:AnnotationTitle><c:AnnotationType>LEVEL</c:AnnotationType></c:Annotation></c:Annotations><c:Name xml:lang="en">European Union - 27 countries (from 2020) and European Free Trade Association (EFTA) countries</c:Name><c:Name xml:lang="de">Europäische Union - 27 Länder (ab 2020) und Länder der Europäischen Freihandelsassoziation (EFTA)</c:Name><c:Name xml:lang="fr">Union européenne - 27 pays (à partir de 2020) et pays de l'Association Européenne de Libre Echange (AELE)</c:Name></s:Code><s:Code id="EU27_2020_IS_K" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:GEO(28.0).EU27_2020_IS_K"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>AGG</c:AnnotationTitle><c:AnnotationType>LEVEL</c:AnnotationType></c:Annotation></c:Annotations><c:Name xml:lang="en">European Union - 27 countries (from 2020) and Iceland under the Kyoto Protocol</c:Name><c:Name xml:lang="de">Europäische Union - 27 Länder (ab 2020) und Island unter dem Kyoto-Protokoll</c:Name><c:Name xml:lang="fr">Union européenne - 27 pays (à partir de 2020) et l'Islande dans le cadre du Protocole de Kyoto</c:Name></s:Code><s:Code id="EU27_2020" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:GEO(28.0).EU27_2020"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationType>EXPLAN_LABEL</c:AnnotationType><c:AnnotationText xml:lang="en">This aggregate covers following countries: BE, BG, CZ, DK, DE, EE, IE, EL, ES, FR, HR, IT, CY, LV, LT, LU, HU, MT, NL, AT, PL, PT, RO, SI, SK, FI, SE</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>EUR</c:AnnotationTitle><c:AnnotationType>EC_CORPORATE_CODE</c:AnnotationType><c:AnnotationURL>http://publications.europa.eu/resource/authority/country/EUR</c:AnnotationURL></c:Annotation><c:Annotation><c:AnnotationTitle>AGG</c:AnnotationTitle><c:AnnotationType>LEVEL</c:AnnotationType></c:Annotation></c:Annotations><c:Name xml:lang="en">European Union - 27 countries (from 2020)</c:Name><c:Name xml:lang="de">Europäische Union - 27 Länder (ab 2020)</c:Name><c:Name xml:lang="fr">Union européenne - 27 pays (à partir de 2020)</c:Name></s:Code><s:Code id="EU27_2020_X_DK" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:GEO(28.0).EU27_2020_X_DK"><c:Annotations><c:Annotation><c:AnnotationTitle>Y</c:AnnotationTitle><c:AnnotationType>IS_STANDARD_CODE</c:AnnotationType><c:AnnotationText xml:lang="en">Standard code, follows Eurostat Standard Code List Guidelines</c:AnnotationText></c:Annotation><c:Annotation><c:AnnotationTitle>AGG</c:AnnotationTitle><c:AnnotationType>LEVEL</c:AnnotationType></c:Annotation></c:Annotations><c:Name xml:lang="en">European Union - 27 countries (from 2020) except Denmark</c:Name><c:Name xml: