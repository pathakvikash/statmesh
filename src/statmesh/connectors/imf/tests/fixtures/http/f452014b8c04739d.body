        <str:Concept id="TYPE_OF_TRANSFORMATION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF.STA:CS_CPI(5.0.0).TYPE_OF_TRANSFORMATION">
          <com:Name xml:lang="en">Type of Transformation</com:Name>
          <com:Description xml:lang="en">Represents the specific calculations or computations applied to source data, along with the standard unit used to express the resulting new data elements or indicators. </com:Description>
