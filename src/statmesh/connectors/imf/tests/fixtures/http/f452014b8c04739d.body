            <str:Enumeration>
              <Ref agencyID="IMF.STA" id="CL_CPI_TYPE_OF_TRANSFORMATION" version="5.0.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
