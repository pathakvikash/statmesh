        <str:Code id="AZN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CURRENCY(2.3.0).AZN">
          <com:Name xml:lang="ar">مانات أذربيجاني</com:Name>
          <com:Name xml:lang="ru">Азербайджанский манат</com:Name>
          <com:Name xml:lang="ja">アゼルバイジャン・マナト</com:Name>
          <com:Name xml:lang="en">Azerbaijani manat</com:Name>
          <com:Name xml:lang="fr">Manat azerbaïdjanais</com:Name>
          <com:Name xml:lang="es">Manat azerbaiyano</com:Name>
          <com:Name xml:lang="zh">阿塞拜疆马纳特</com:Name>
        </str:Code>
        <str:Code id="BSD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CURRENCY(2.3.0).BSD">
          <com:Name xml:lang="ar">دولار باهامي</com:Name>
          <com:Name xml:lang="ru">Багамский доллар</com:Name>
          <com:Name xml:lang="ja">バハマ・ドル</com:Name>
          <com:Name xml:lang="en">Bahamian dollar</com:Name>
          <com:Name xml:lang="fr">Dollar bahaméen</com:Name>
          <com:Name xml:lang="es">Dólar bahameño</com:Name>
          <com:Name xml:lang="zh">巴哈马元</com:Name>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CURRENCY(2.3.0)._T">
