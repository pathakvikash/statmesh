      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_DECIMALS(1.0.3)" agencyID="IMF" id="CL_DECIMALS" version="1.0.3" isFinal="true" isExternalReference="false" isPartial="false">
