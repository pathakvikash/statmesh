<?xml version='1.0' encoding='UTF-8'?>
<mes:Structure xmlns:mes="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/message" xmlns:str="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/structure" xmlns:com="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/common" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/message ../../schemas/SDMXMessage.xsd">
  <mes:Header>
    <mes:ID>IDREF2743</mes:ID>
    <mes:Test>false</mes:Test>
    <mes:Prepared>2026-11-19T08:45:03.872626364Z</mes:Prepared>
    <mes:Sender id="IMF"/>
  </mes:Header>
  <mes:Structures>
    <str:Dataflows>
      <str:Dataflow urn="urn:sdmx:org.sdmx.infomodel.datastructure.Dataflow=IMF.STA:CPI(5.0.0)" agencyID="IMF.STA" id="CPI" version="5.0.0" isFinal="true" isExternalReference="false">
        <com:Annotations>
          <com:Annotation id="@IMF">
            <com:AnnotationTitle>H_CPI_BY_COMPONENT</com:AnnotationTitle>
            <com:AnnotationType>DATAFLOW_PRESENTATION</com:AnnotationType>
            <com:AnnotationText xml:lang="en">presentation_title=Consumer Price Index (CPI) by Component; presentation_description=The CPI is a measure of the average change in prices of goods and services consumed by households over a period of time. The data is presented in a table, with each country's CPI broken down by component. The components include food and beverages, housing, transportation, apparel, recreation, education and communication, medical care, and other goods and services.</com:AnnotationText>
          </com:Annotation>
          <com:Annotation id="@IMF">
            <com:AnnotationTitle/>
            <com:AnnotationType>DEFAULT_PRESENTATION </com:AnnotationType>
          </com:Annotation>
          <com:Annotation id="dataEngineSettings"/>
          <com:Annotation id="origin"/>
          <com:Annotation id="DataEngine">
            <com:AnnotationTitle>timeseries_v2</com:AnnotationTitle>
          </com:Annotation>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Consumer Price Index (CPI)</com:Name>
        <com:Description xml:lang="en">The Consumer Price Index (CPI) dataset includes the national consumer price indexes by economy. In addition to the all items, headline index, detailed indexes by Division (e.g. Food and Non-alcoholic beverages, Clothing, etc.), their associated weights, and contributions to national annual inflation are published where available. In addition to the national CPIs, the CPI dataset includes the Harmonised Indices of Consumer Prices (HICPs) compiled by Eurostat for Europe. Consumer price indexes measure the relative changes over time in the prices of goods and services purchased by households, which households use directly, or indirectly, to satisfy their own needs and wants.</com:Description>
        <str:Structure>
          <Ref agencyID="IMF.STA" id="DSD_CPI" version="5.0.0" package="datastructure" class="DataStructure"/>
        </str:Structure>
      </str:Dataflow>
    </str:Dataflows>
    <str:Codelists>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_FUNCTIONAL_CAT(2.4.1)" agencyID="IMF" id="CL_FUNCTIONAL_CAT" version="2.4.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Functional category</com:Name>
        <com:Description xml:lang="en">A classification used to categorize investments based on their purpose or function, such as equity investments, debt investments, or other investments.</com:Description>
        <str:Code id="AFXRA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1).AFXRA">
          <com:Name xml:lang="en">Allocated foreign exchange reserves</com:Name>
          <com:Description xml:lang="en">Those foreign exchange reserves for which the currency of denomination has been identified and reported in the Currency Composition of Official Foreign Exchange Reserves (COFER).</com:Description>
        </str:Code>
        <str:Code id="D" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1).D">
          <com:Name xml:lang="en">Direct investment</com:Name>
          <com:Description xml:lang="en">Direct investment is a category of cross-border investment associated with an investor (or its affiliated enterprise) in one economy having control or significant degree of influence over the management of an investee enterprise resident in another economy.</com:Description>
        </str:Code>
        <str:Code id="R" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1).R">
          <com:Name xml:lang="en">Reserve assets</com:Name>
          <com:Description xml:lang="en">External assets that are readily available to and controlled by monetary authorities for meeting balance of payments financing needs, for intervention in exchange markets to affect the currency exchange rate, and for other related purposes (such as maintaining confidence in the currency and the economy, and serving as a basis for foreign borrowing). They can include monetary gold, Special Drawing Rights (SDRs), reserve positions in the IMF, and other reserve assets. Reserve assets must be denominated and settled in foreign currency.</com:Description>
        </str:Code>
        <str:Code id="F7" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1).F7">
          <com:Name xml:lang="en">Financial derivatives (other than reserves) and employee stock options</com:Name>
          <com:Description xml:lang="en">Financial derivatives are negotiable financial instruments linked to another specific financial instrument, indicator, or commodity, through which specific risks (e.g., interest rate risk, foreign exchange risk, equity and commodity price risk, credit risk) can be traded in their own right in financial markets.  Employee stock options are options to buy the equity of a company, offered to employees of the company as a form of remuneration and often at a discount to the market value. If the financial derivative is linked to a reserve asset it is excluded from the value of this indicator.</com:Description>
        </str:Code>
        <str:Code id="TFXRA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1).TFXRA">
          <com:Name xml:lang="en">Total foreign exchange reserves</com:Name>
          <com:Description xml:lang="en">Total of Reserve assets as reported in the International Liquidity database (formerly International Financial Statistics)</com:Description>
        </str:Code>
        <str:Code id="O" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1).O">
          <com:Name xml:lang="en">Other investment</com:Name>
          <com:Description xml:lang="en">Other investment represents a residual investment category that includes positions and transactions other than those included in direct investment, portfolio investment, financial derivatives and employee stock options, and reserve assets.</com:Description>
        </str:Code>
        <str:Code id="P" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1).P">
          <com:Name xml:lang="en">Portfolio investment</com:Name>
          <com:Description xml:lang="en">Portfolio investment reflects cross-border transactions and positions involving debt or equity securities, other than those included in direct investment or reserve assets.</com:Description>
        </str:Code>
        <str:Code id="UFXRA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1).UFXRA">
          <com:Name xml:lang="en">Unallocated foreign exchange reserves</com:Name>
          <com:Description xml:lang="en">In the context of the Currency Composition of Official Foreign Exchange Reserves (COFER), Unallocated Foreign Exchange Reserves (FXR) is a residual category consisting of the difference between Total FXR sourced from the IMF's International Liquidity database and the total allocated reserves reported in COFER. It has two components: (i) the total FXR of nonreporting countries; and (ii) the discrepancy (if any) between the Total FXR of COFER-reporting countries and the total Allocated FXR reported in COFER.</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1)._T">
          <com:Name xml:lang="en">All functional categories</com:Name>
          <com:Description xml:lang="en">All categories of investment including direct investment, portfolio investment, financial derivatives, employee stock options, reserve assets, and other investments.</com:Description>
        </str:Code>
        <str:Code id="TXD_P" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FUNCTIONAL_CAT(2.4.1).TXD_P">
          <com:Name xml:lang="en">All functional categories (total) - sum of (direct investment, portfolio investment)</com:Name>
          <com:Description xml:lang="en">The combined total of direct investment and portfolio investment, representing the sum of these two categories.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_UNIT(2.13.0)" agencyID="IMF" id="CL_UNIT" version="2.13.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Unit of Measure</com:Name>
        <com:Description xml:lang="en">This codelist represents the standard unit used to quantify a particular data element or indicator. It encompasses various units, including currency, physical units, percentages, and other standardized measures.</com:Description>
        <str:Code id="1000HA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).1000HA">
          <com:Name xml:lang="en">1000 hectares</com:Name>
          <com:Description xml:lang="en">A unit of area equal to 1,000 hectares (10,000,000 square meters).</com:Description>
        </str:Code>
        <str:Code id="BBL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).BBL">
          <com:Name xml:lang="en">Barrel</com:Name>
          <com:Description xml:lang="en">Unit of volume for crude oil and other petroleum products. Equal to 42 US gallons.</com:Description>
        </str:Code>
        <str:Code id="BBL_DY" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).BBL_DY">
          <com:Name xml:lang="en">Barrels per day</com:Name>
          <com:Description xml:lang="en">Unit of measurement used in the oil and gas industry to describe the rate of production or consumption of petroleum products.</com:Description>
        </str:Code>
        <str:Code id="BP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).BP">
          <com:Name xml:lang="en">Basis points</com:Name>
          <com:Description xml:lang="en">Basis points refers to hundredths of 1 percentage point.</com:Description>
        </str:Code>
        <str:Code id="CAR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).CAR">
          <com:Name xml:lang="en">Carat</com:Name>
          <com:Description xml:lang="en">The carat is a unit of mass equal to 200 mg, used for measuring gemstones and pearls. Also used to indicate the proportion of gold in an alloy out of 24 parts (e.g., 18K gold is 18/24 parts gold).</com:Description>
        </str:Code>
        <str:Code id="CM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).CM">
          <com:Name xml:lang="en">Centimeter</com:Name>
          <com:Description xml:lang="en">A unit of length in the metric system, equal to one hundredth of a meter.</com:Description>
        </str:Code>
        <str:Code id="CBM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).CBM">
          <com:Name xml:lang="en">Cubic meter</com:Name>
          <com:Description xml:lang="en">A unit of volume equal to a cube one meter long on each side.</com:Description>
        </str:Code>
        <str:Code id="DY" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).DY">
          <com:Name xml:lang="en">Days</com:Name>
          <com:Description xml:lang="en">A period of twenty-four hours as a unit of time.</com:Description>
        </str:Code>
        <str:Code id="DC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).DC">
          <com:Name xml:lang="en">Degrees Celsius</com:Name>
          <com:Description xml:lang="en">The degree Celsius (symbol: °C) can refer to a specific point on the Celsius temperature scale or to a difference or range between two temperatures.</com:Description>
        </str:Code>
        <str:Code id="GAL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).GAL">
          <com:Name xml:lang="en">Gallon</com:Name>
          <com:Description xml:lang="en">A unit of liquid capacity equal to 3.79 liters.</com:Description>
        </str:Code>
        <str:Code id="IX" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT(2.13.0).IX">
          <com:Name xml:lang="en">Index</com:Name>
          <com:Description xml:lang="en">A statistical measure that expresses the relative change in a variable in the current period compared to the index reference period.</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CURRENCY(2.3.0)._T">
          <com:Name xml:lang="en">All currencies</com:Name>
          <com:Description xml:lang="en">Total of All Currencies, e.g. sum of all denominated currencies.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_ACCOUNTS(2.5.1)" agencyID="IMF" id="CL_ACCOUNTS" version="2.5.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Macroeconomic and financial accounts</com:Name>
        <com:Description xml:lang="en">A framework for organizing macroeconomic and financial data into a set of integrated accounts and tables that provide a comprehensive overview of an economy.</com:Description>
        <str:Code id="KA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).KA">
          <com:Name xml:lang="en">Capital account</com:Name>
          <com:Description xml:lang="en">The capital account records acquisitions and disposals of non-financial assets as a result of transactions with other units, internal bookkeeping transactions linked to production (such as changes in inventories and depreciation) and the redistribution of wealth by means of capital transfers. In the context of the external accounts, the capital account shows (a) capital transfers receivable and payable between residents and nonresidents and (b) the acquisition and disposal of nonproduced, nonfinancial assets between residents and nonresidents.</com:Description>
        </str:Code>
        <str:Code id="KAFA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).KAFA">
          <com:Name xml:lang="en">Capital and financial account</com:Name>
          <com:Description xml:lang="en">The capital account records acquisitions and disposals of non-financial assets as a result of transactions with other units, internal bookkeeping transactions linked to production (such as changes in inventories and depreciation) and the redistribution of wealth by means of capital transfers. In the context of the external accounts, the capital account shows (a) capital transfers receivable and payable between residents and nonresidents and (b) the acquisition and disposal of nonproduced, nonfinancial assets between residents and nonresidents. The financial account records all transactions in financial assets and liabilities. In the external accounts, only transactions between residents and non-residents are included.</com:Description>
        </str:Code>
        <str:Code id="CA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).CA">
          <com:Name xml:lang="en">Current account</com:Name>
          <com:Description xml:lang="en">The current account covers the transactions in goods, services, earned income and transfer income for institutional sectors and between residents and non-residents.</com:Description>
        </str:Code>
        <str:Code id="CKAFA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).CKAFA">
          <com:Name xml:lang="en">Current, capital and financial account</com:Name>
          <com:Description xml:lang="en">The current account covers the transactions in goods, services, earned income and transfer income for institutional sectors and between residents and non-residents. The capital account records acquisitions and disposals of non-financial assets as a result of transactions with other units, internal bookkeeping transactions linked to production (such as changes in inventories and depreciation) and the redistribution of wealth by means of capital transfers. In the context of the external accounts, the capital account shows (a) capital transfers receivable and payable between residents and nonresidents and (b) the acquisition and disposal of nonproduced, nonfinancial assets between residents and nonresidents. The financial account records all transactions in financial assets and liabilities. In the external accounts, only transactions between residents and non-residents are included.</com:Description>
        </str:Code>
        <str:Code id="FA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).FA">
          <com:Name xml:lang="en">Financial account</com:Name>
          <com:Description xml:lang="en">The financial account records all transactions in financial assets and liabilities. In the external accounts, only transactions between residents and non-residents are included.</com:Description>
        </str:Code>
        <str:Code id="CC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).CC">
          <com:Name xml:lang="en">Currency composition of International Investment Position</com:Name>
          <com:Description xml:lang="en">The breakdown of a country's international investment position by the currency in which the assets and liabilities are denominated.</com:Description>
        </str:Code>
        <str:Code id="MS" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).MS">
          <com:Name xml:lang="en">Monetary survey</com:Name>
          <com:Description xml:lang="en">An aggregate financial statement that consolidates the accounts of the central bank and other depository corporations, showing the sources and uses of funds.</com:Description>
        </str:Code>
        <str:Code id="IMFA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).IMFA">
          <com:Name xml:lang="en">Fund Accounts</com:Name>
          <com:Description xml:lang="en">A system of accounting used by non-profit organizations and governments to track the use of funds restricted for specific purposes.</com:Description>
        </str:Code>
        <str:Code id="IIP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).IIP">
          <com:Name xml:lang="en">International Investment Position (IIP)</com:Name>
          <com:Description xml:lang="en">Statement drawn up at a particular point in time of the value of financial assets of residents of an economy that are claims on non-residents or are gold bullion held as reserve assets and of the liabilities of residents of an economy to non-residents.</com:Description>
        </str:Code>
        <str:Code id="ALLC_S" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1).ALLC_S">
          <com:Name xml:lang="en">Allocated shares</com:Name>
          <com:Description xml:lang="en">Represents shares of ownership or equity that have been formally assigned or distributed to specific individuals or entities.</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTS(2.5.1)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">The sum of all relevant components or categories.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_S_ADJUSTMENT(1.0.2)" agencyID="IMF" id="CL_S_ADJUSTMENT" version="1.0.2" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Seasonal Adjustment</com:Name>
        <com:Description xml:lang="en">This codelist represents a set of codes identifying the statistical techniques employed to remove seasonal patterns or fluctuations from time series data.</com:Description>
        <str:Code id="SA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2).SA">
          <com:Name xml:lang="en">Seasonally adjusted (SA)</com:Name>
          <com:Description xml:lang="en">Time series that have been adjusted for seasonal variations, including trading-day (working-day) effects and other regular calendar variations if present.</com:Description>
        </str:Code>
        <str:Code id="SAF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2).SAF">
          <com:Name xml:lang="en">Seasonally adjusted factors</com:Name>
          <com:Description xml:lang="en">The seasonally adjusted component is the result of the extraction of the seasonal component (including the calendar effects component) from a time series. If neither seasonal nor calendar influences are present in the original data, the seasonally adjusted series is given by the original data.</com:Description>
        </str:Code>
        <str:Code id="NSA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2).NSA">
          <com:Name xml:lang="en">Not seasonally adjusted (NSA)</com:Name>
          <com:Description xml:lang="en">Time series that have not been adjusted for seasonal variations, including trading-day (working-day) effects and other regular calendar variations if present.</com:Description>
        </str:Code>
        <str:Code id="TC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2).TC">
          <com:Name xml:lang="en">Trend cycle data</com:Name>
          <com:Description xml:lang="en">Trend estimates are derived from seasonally adjusted estimates via an averaging process which attempts to remove the irregular component of the time series. This allows the underlying direction of a time series to be identified.</com:Description>
        </str:Code>
        <str:Code id="WD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2).WD">
          <com:Name xml:lang="en">Working day adjusted</com:Name>
          <com:Description xml:lang="en">Working-day adjustment is a part of the calendar adjustment which focusses on the changing number of working days (Monday - Friday) in the various months and their effect on statistical indicators (e.g. industrial production, production in construction) for these months. (source: Eurostat)</com:Description>
        </str:Code>
        <str:Code id="_Z" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2)._Z">
          <com:Name xml:lang="en">Not applicable</com:Name>
          <com:Description xml:lang="en">Not applicable</com:Description>
        </str:Code>
        <str:Code id="T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2).T">
          <com:Name xml:lang="en">Trend</com:Name>
          <com:Description xml:lang="en">Trend estimates are derived from seasonally adjusted estimates via an averaging process which attempts to remove the irregular component of the time series. This allows the underlying direction of a time series to be identified.</com:Description>
        </str:Code>
        <str:Code id="C" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2).C">
          <com:Name xml:lang="en">Trend-cycle data, calendar adjusted</com:Name>
          <com:Description xml:lang="en">Trend-cycle data, calendar adjusted estimates are derived from seasonally adjusced estimates via an averaging process which attempts to remove the irregular components of che time series. This allows The underlying direccion of a time series to be idencified. The data are adjusted for variations in the calendar.</com:Description>
        </str:Code>
        <str:Code id="R" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2).R">
          <com:Name xml:lang="en">Trend-cycle data, not calendar adjusted</com:Name>
          <com:Description xml:lang="en">Trend-cycle data, calendar adjusted estimates are derived from seasonally adjusced estimates via an averaging process which attempts to remove the irregular components of che time series. This allows The underlying direccion of a time series to be idencified. The data are not adjusted for variations in the calendar.</com:Description>
        </str:Code>
        <str:Code id="K" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_S_ADJUSTMENT(1.0.2).K">
          <com:Name xml:lang="en">Calendar component</com:Name>
          <com:Description xml:lang="en">Calendar component</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_TRADE_FLOW(2.1.0)" agencyID="IMF" id="CL_TRADE_FLOW" version="2.1.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Trade flow</com:Name>
        <com:Description xml:lang="en">Data related to the movement of goods and services between countries, including exports and imports.</com:Description>
        <str:Code id="G" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).G">
          <com:Name xml:lang="en">Goods</com:Name>
          <com:Description xml:lang="en">Physical, tangible products that are traded internationally.</com:Description>
        </str:Code>
        <str:Code id="M" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).M">
          <com:Name xml:lang="en">Total imports</com:Name>
          <com:Description xml:lang="en">Total imports reflects the change in the economic ownership of products from non-residents to residents of the compiling economy, irrespective of physical movement of goods across national borders.</com:Description>
        </str:Code>
        <str:Code id="M1" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).M1">
          <com:Name xml:lang="en">Imports</com:Name>
          <com:Description xml:lang="en">Imports of goods are recorded at the time when they enter the economic territory of a country.</com:Description>
        </str:Code>
        <str:Code id="M11" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).M11">
          <com:Name xml:lang="en">Imports of manufactures</com:Name>
          <com:Description xml:lang="en">The total value of manufactured goods sold by foreign sellers to domestic purchasers</com:Description>
        </str:Code>
        <str:Code id="M1NOIL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).M1NOIL">
          <com:Name xml:lang="en">Imports of non-oil related products</com:Name>
          <com:Description xml:lang="en">The total value of non-oil-related products bought by a country from foreign sellers.</com:Description>
        </str:Code>
        <str:Code id="M1OIL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).M1OIL">
          <com:Name xml:lang="en">Imports of oil related products</com:Name>
          <com:Description xml:lang="en">The total value of oil-related products bought by a country from foreign sellers.</com:Description>
        </str:Code>
        <str:Code id="M2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).M2">
          <com:Name xml:lang="en">Re-imports</com:Name>
          <com:Description xml:lang="en">Re-imports are domestic goods imported in the same state as previously exported, without any substantial transformation occurring on the goods while they were outside the territory.</com:Description>
        </str:Code>
        <str:Code id="M3" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).M3">
          <com:Name xml:lang="en">Import of goods for inward processing</com:Name>
          <com:Description xml:lang="en">Import of goods for the purpose of processing and re-exporting them.</com:Description>
        </str:Code>
        <str:Code id="M4" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).M4">
          <com:Name xml:lang="en">Import of goods after outward processing</com:Name>
          <com:Description xml:lang="en">Import of goods that were sent abroad for processing and then imported back.</com:Description>
        </str:Code>
        <str:Code id="M5" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRADE_FLOW(2.1.0).M5">
          <com:Name xml:lang="en">Intra-firm imports</com:Name>
          <com:Description xml:lang="en">Imports of goods or services between different branches of the same multinational company.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_PRICES(2.3.0)" agencyID="IMF" id="CL_PRICES" version="2.3.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Prices</com:Name>
        <com:Description xml:lang="en">This codelist represents different types of prices or price adjustments, including those that have been adjusted for inflation (real or constant prices) and those that have not (nominal or current prices). It also includes various methods for adjusting prices for inflation, such as using deflators or converting to a constant base period.</com:Description>
        <str:Code id="Q" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0).Q">
          <com:Name xml:lang="en">Constant prices</com:Name>
          <com:Description xml:lang="en">Values that have had the effect of price changes removed, expressed as time series in constant prices (fixed base) or chain-linked volume terms, or as non-time series in previous year's prices</com:Description>
        </str:Code>
        <str:Code id="P" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0).P">
          <com:Name xml:lang="en">Closing price</com:Name>
          <com:Description xml:lang="en">An adjusted deflator index that has been recalibrated to a new base period.</com:Description>
        </str:Code>
        <str:Code id="V" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0).V">
          <com:Name xml:lang="en">Current prices</com:Name>
          <com:Description xml:lang="en">Values expressed without any adjustment for price changes.</com:Description>
        </str:Code>
        <str:Code id="PI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0).PI">
          <com:Name xml:lang="en">Price index</com:Name>
          <com:Description xml:lang="en">A measure that examines the weighted average of prices of a basket of consumer goods and services.</com:Description>
        </str:Code>
        <str:Code id="BEEOP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0).BEEOP">
          <com:Name xml:lang="en">Breakeven external oil price</com:Name>
          <com:Description xml:lang="en">The oil price at which a country's external balances are neither in surplus nor deficit.</com:Description>
        </str:Code>
        <str:Code id="BEFOP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0).BEFOP">
          <com:Name xml:lang="en">Breakeven fiscal oil price</com:Name>
          <com:Description xml:lang="en">The oil price at which a country's fiscal balance is neither in surplus nor deficit.</com:Description>
        </str:Code>
        <str:Code id="VL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0).VL">
          <com:Name xml:lang="en">Volume</com:Name>
          <com:Description xml:lang="en">The quantity of goods or services produced or traded, often measured in terms of physical units or monetary value.</com:Description>
        </str:Code>
        <str:Code id="VAL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0).VAL">
          <com:Name xml:lang="en">Value</com:Name>
          <com:Description xml:lang="en">The value of a product reflects its price multipled by its quantity.</com:Description>
        </str:Code>
        <str:Code id="_Z" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0)._Z">
          <com:Name xml:lang="en">Not applicable</com:Name>
          <com:Description xml:lang="en">Terms or data that do not apply to the current context or situation.</com:Description>
        </str:Code>
        <str:Code id="UP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_PRICES(2.3.0).UP">
          <com:Name xml:lang="en">Unit prices</com:Name>
          <com:Description xml:lang="en">The unitary price of an item or commodity.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_CONF_STATUS(1.0.0)" agencyID="IMF" id="CL_CONF_STATUS" version="1.0.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Confidentiality Status</com:Name>
        <com:Description xml:lang="en">This classification provides information about the sensitivity and confidentiality status of the data. (Source:SDMX)</com:Description>
        <str:Code id="A" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).A">
          <com:Name xml:lang="en">Primary confidentiality due to small counts</com:Name>
        </str:Code>
        <str:Code id="C" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).C">
          <com:Name xml:lang="en">Confidential statistical information</com:Name>
        </str:Code>
        <str:Code id="D" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).D">
          <com:Name xml:lang="en">Secondary confidentiality set by the sender, not for publication</com:Name>
        </str:Code>
        <str:Code id="E" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).E">
          <com:Name xml:lang="en">Not for publication, restricted for internal use only (equivalent to the code N) until the embargo time elapses; Free for publication (equivalent to the code F) after the embargo time elapses.</com:Name>
        </str:Code>
        <str:Code id="F" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).F">
          <com:Name xml:lang="en">Free (free for publication)</com:Name>
        </str:Code>
        <str:Code id="G" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).G">
          <com:Name xml:lang="en">Primary confidentiality due to dominance by one or two units</com:Name>
        </str:Code>
        <str:Code id="M" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).M">
          <com:Name xml:lang="en">Primary confidentiality due to data declared confidential based on other measures of concentration</com:Name>
        </str:Code>
        <str:Code id="N" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).N">
          <com:Name xml:lang="en">Not for publication, restricted for internal use only</com:Name>
        </str:Code>
        <str:Code id="O" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).O">
          <com:Name xml:lang="en">Primary confidentiality due to dominance by one unit</com:Name>
        </str:Code>
        <str:Code id="S" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CONF_STATUS(1.0.0).S">
          <com:Name xml:lang="en">Secondary confidentiality set and managed by the receiver, not for publication</com:Name>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_UNIT_MULT(1.0.2)" agencyID="IMF" id="CL_UNIT_MULT" version="1.0.2" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="dataEngineSettings"/>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Unit Multiplier</com:Name>
        <com:Description xml:lang="en">This code list provides code values for indicating the magnitude in the units of measurement. More information about this code list and SDMX code lists in general (e.g. list of generic codes for expressing general concepts like "Total", "Unknown", etc.; syntaxes for the creation of further codes; general guidelines for the creation of SDMX code lists) can be found at this address: https://sdmx.org/?page_id=4345.</com:Description>
        <str:Code id="0" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).0">
          <com:Name xml:lang="ar">الوحدات</com:Name>
          <com:Name xml:lang="ru">Единицы</com:Name>
          <com:Name xml:lang="pt">Unidades</com:Name>
          <com:Name xml:lang="ja">一</com:Name>
          <com:Name xml:lang="en">Units</com:Name>
          <com:Name xml:lang="fr">Unités</com:Name>
          <com:Name xml:lang="es">Unidades</com:Name>
          <com:Name xml:lang="zh">个</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس صفر (10^صفر)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять в нулевой степени (10^0)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de zero (10^0)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の0乗 (10^0)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of zero (10^0)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance zéro (10^0)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de cero (10^0)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的零次方（10^0）</com:Description>
        </str:Code>
        <str:Code id="1" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).1">
          <com:Name xml:lang="ar">العشرات</com:Name>
          <com:Name xml:lang="ru">Десятки</com:Name>
          <com:Name xml:lang="pt">Dezenas</com:Name>
          <com:Name xml:lang="ja">十</com:Name>
          <com:Name xml:lang="en">Tens</com:Name>
          <com:Name xml:lang="fr">Dizaines</com:Name>
          <com:Name xml:lang="es">Decenas</com:Name>
          <com:Name xml:lang="zh">十</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس 1 (10^1)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять в первой степени (10^1)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de um (10^1)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の1乗 (10^1)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of one (10^1)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance un (10^1)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de uno (10^1)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的1次方（10^1）</com:Description>
        </str:Code>
        <str:Code id="2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).2">
          <com:Name xml:lang="ar">المئات</com:Name>
          <com:Name xml:lang="ru">Сотни</com:Name>
          <com:Name xml:lang="pt">Centenas</com:Name>
          <com:Name xml:lang="ja">百</com:Name>
          <com:Name xml:lang="en">Hundreds</com:Name>
          <com:Name xml:lang="fr">Centaines</com:Name>
          <com:Name xml:lang="es">Centenas</com:Name>
          <com:Name xml:lang="zh">百</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس 2 (10^2)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять во второй степени (10^2)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de dois (10^2)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の2乗 (10^2)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of two (10^2)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance deux (10^2)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de dos (10^2)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的2次方（10^2）</com:Description>
        </str:Code>
        <str:Code id="3" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).3">
          <com:Name xml:lang="ar">الآلاف</com:Name>
          <com:Name xml:lang="ru">Тысячи</com:Name>
          <com:Name xml:lang="pt">Milhares</com:Name>
          <com:Name xml:lang="ja">千</com:Name>
          <com:Name xml:lang="en">Thousands</com:Name>
          <com:Name xml:lang="fr">Milliers</com:Name>
          <com:Name xml:lang="es">Miles</com:Name>
          <com:Name xml:lang="zh">千</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس 3 (10^3)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять в третьей степени (10^3)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de três (10^3)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の3乗 (10^3)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of three (10^3)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance trois (10^3)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de tres (10^3)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的3次方（10^3）</com:Description>
        </str:Code>
        <str:Code id="4" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).4">
          <com:Name xml:lang="ar">عشرات الآلاف </com:Name>
          <com:Name xml:lang="ru">Десятки тысяч</com:Name>
          <com:Name xml:lang="pt">Dezenas de milhares</com:Name>
          <com:Name xml:lang="ja">万</com:Name>
          <com:Name xml:lang="en">Tens of thousands</com:Name>
          <com:Name xml:lang="fr">Dizaines de milliers</com:Name>
          <com:Name xml:lang="es">Decenas de miles</com:Name>
          <com:Name xml:lang="zh">万</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس 4 (10^4)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять в четвертой степени (10^4)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de quatro (10^4)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の4乗 (10^4)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of four (10^4)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance quatre (10^4)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de cuatro (10^4)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的4次方（10^4）</com:Description>
        </str:Code>
        <str:Code id="5" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).5">
          <com:Name xml:lang="ar">مئات الآلاف</com:Name>
          <com:Name xml:lang="ru">Сотни тысяч</com:Name>
          <com:Name xml:lang="pt">Centenas de milhares</com:Name>
          <com:Name xml:lang="ja">十万</com:Name>
          <com:Name xml:lang="en">Hundreds of thousands</com:Name>
          <com:Name xml:lang="fr">Centaines de milliers</com:Name>
          <com:Name xml:lang="es">Centenas de miles</com:Name>
          <com:Name xml:lang="zh">十万</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس 5 (10^5)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять в пятой степени (10^5)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de cinco (10^5)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の5乗 (10^5)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of five(10^5)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance cinq (10^5)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de cinco (10^5)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的5次方（10^5）</com:Description>
        </str:Code>
        <str:Code id="6" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).6">
          <com:Name xml:lang="ar">الملايين</com:Name>
          <com:Name xml:lang="ru">Миллионы</com:Name>
          <com:Name xml:lang="pt">Milhões</com:Name>
          <com:Name xml:lang="ja">百万</com:Name>
          <com:Name xml:lang="en">Millions</com:Name>
          <com:Name xml:lang="fr">Millions</com:Name>
          <com:Name xml:lang="es">Millones</com:Name>
          <com:Name xml:lang="zh">百万</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس 6 (10^6)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять в шестой степени (10^6)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de seis (10^6)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の6乗 (10^6)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of six (10^6)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance six (10^6)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de seis (10^6)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的6次方（10^6）</com:Description>
        </str:Code>
        <str:Code id="7" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).7">
          <com:Name xml:lang="ar">عشرات الملايين</com:Name>
          <com:Name xml:lang="ru">Десятки миллионов</com:Name>
          <com:Name xml:lang="pt">Dezenas de milhões</com:Name>
          <com:Name xml:lang="ja">千万</com:Name>
          <com:Name xml:lang="en">Tens of millions</com:Name>
          <com:Name xml:lang="fr">Dizaines de millions</com:Name>
          <com:Name xml:lang="es">Decenas de millones</com:Name>
          <com:Name xml:lang="zh">千万</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس 7 (10^7)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять в седьмой степени (10^7)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de sete (10^7)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の7乗 (10^7)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of seven (10^7)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance sept (10^7)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de siete (10^7)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的7次方（10^7）</com:Description>
        </str:Code>
        <str:Code id="8" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).8">
          <com:Name xml:lang="ar">مئات الملايين</com:Name>
          <com:Name xml:lang="ru">Сотни миллионов</com:Name>
          <com:Name xml:lang="pt">Centenas de milhões</com:Name>
          <com:Name xml:lang="ja">億</com:Name>
          <com:Name xml:lang="en">Hundreds of millions</com:Name>
          <com:Name xml:lang="fr">Centaines de millions</com:Name>
          <com:Name xml:lang="es">Cientos de millones</com:Name>
          <com:Name xml:lang="zh">亿</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس 8 (10^8)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять в восьмой степени (10^8)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de oito (10^8)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の8乗 (10^8)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of eight (10^8)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance huit (10^8)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de ocho (10^8)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的8次方（10^8）</com:Description>
        </str:Code>
        <str:Code id="9" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_UNIT_MULT(1.0.2).9">
          <com:Name xml:lang="ar">المليارات</com:Name>
          <com:Name xml:lang="ru">Миллиарды</com:Name>
          <com:Name xml:lang="pt">Milhares de milhões</com:Name>
          <com:Name xml:lang="ja">十億</com:Name>
          <com:Name xml:lang="en">Billions</com:Name>
          <com:Name xml:lang="fr">Milliards</com:Name>
          <com:Name xml:lang="es">Miles de millones</com:Name>
          <com:Name xml:lang="zh">十亿</com:Name>
          <com:Description xml:lang="ar">يُعبر عنها بالترميز العلمي بوصفها 10 أس 9 (10^9)</com:Description>
          <com:Description xml:lang="ru">В математических терминах представляется как десять в девятой степени (10^9)</com:Description>
          <com:Description xml:lang="pt">Representado em notação científica como dez elevado à potência de nove (10^9)</com:Description>
          <com:Description xml:lang="ja">科学的表記では、10の9乗 (10^9)と表記</com:Description>
          <com:Description xml:lang="en">In scientific notation, expressed as ten raised to the power of nine (10^9)</com:Description>
          <com:Description xml:lang="fr">En notation scientifique, exprimé comme dix élevé à la puissance neuf (10^9)</com:Description>
          <com:Description xml:lang="es">En notación científica, expresado como diez a la potencia de nueve (10^9)</com:Description>
          <com:Description xml:lang="zh">在科学记数法中，表示为10的9次方（10^9）</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_OBS_STATUS(1.1.0)" agencyID="IMF" id="CL_OBS_STATUS" version="1.1.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Observation Status</com:Name>
        <com:Description xml:lang="en">This codelist indicates the status of an observation within a dataset, such as whether it is a provisional value, an estimated value, a final figure, or a value where a time series break occurs. (Source: SDMX)</com:Description>
        <str:Code id="A" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).A">
          <com:Name xml:lang="en">Normal value</com:Name>
          <com:Description xml:lang="en">To be used as default value if no value is provided or when no special coded qualification is assumed. Usually, it can be assumed that the source agency assigns sufficient confidence to the provided observation and/or the value is not expected to be dramatically revised.</com:Description>
        </str:Code>
        <str:Code id="B" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).B">
          <com:Name xml:lang="en">Time series break</com:Name>
          <com:Description xml:lang="en">Observations are characterised as such when different content exists or a different methodology has been applied to this observation as compared with the preceding one (the one given for the previous period).</com:Description>
        </str:Code>
        <str:Code id="D" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).D">
          <com:Name xml:lang="en">Definition differs</com:Name>
          <com:Description xml:lang="en">Used to indicate slight deviations from the established methodology (footnote-type information); these divergences do not imply a break in time series.</com:Description>
        </str:Code>
        <str:Code id="E" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).E">
          <com:Name xml:lang="en">Estimated value</com:Name>
          <com:Description xml:lang="en">Observation obtained through an estimation methodology (e.g. to produce back-casts) or based on the use of a limited amount of data or ad hoc sampling and through additional calculations (e.g. to produce a value at an early stage of the production stage while not all data are available). It may also be used in case of experimental data (e.g. in the context of a pilot ahead of a full scale production process) or in case of data of (anticipated/assessed) low quality. If needed, additional information can be provided through free text using the COMMENT_OBS attribute at the observation level or at a higher level. This code is to be used when the estimation is done by a sender agency. When the imputation is carried out by a receiver agency in order to replace or fill gaps in reported data series, the flag to use is I "Value imputed by a receiving agency".</com:Description>
        </str:Code>
        <str:Code id="F" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).F">
          <com:Name xml:lang="en">Forecast value</com:Name>
          <com:Description xml:lang="en">Value deemed to assess the magnitude which a quantity will assume at some future point of time (as distinct from "estimated value" which attempts to assess the magnitude of an already existent quantity).</com:Description>
        </str:Code>
        <str:Code id="G" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).G">
          <com:Name xml:lang="en">Experimental value</com:Name>
          <com:Description xml:lang="en">Data collected on the basis of definitions or (alternative) collection methods under development. Data not of guaranteed quality as normally expected from provider.</com:Description>
        </str:Code>
        <str:Code id="K" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).K">
          <com:Name xml:lang="en">Data included in another category</com:Name>
          <com:Description xml:lang="en">This code is used when data for a given category are missing and are included in another category, sub-total or total. Generally where code "K" is used there should be a corresponding code "W - Includes data from another category" assigned to the over-covered category. Implementers and data reporters should use the COMMENT_OBS observation-level attribute to specify under which category the data are included.</com:Description>
        </str:Code>
        <str:Code id="W" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).W">
          <com:Name xml:lang="en">Includes data from another category</com:Name>
          <com:Description xml:lang="en">This code is used when data include another category, or go beyond the scope of the data collection and are therefore over-covered. Generally, where code "W" is used there should be a corresponding code "K - Data included in another category" assigned to the category which is under-covered. Implementers and data reporters should use the COMMENT_OBS observation-level attribute to specify which additional data are included.</com:Description>
        </str:Code>
        <str:Code id="O" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).O">
          <com:Name xml:lang="en">Missing value</com:Name>
          <com:Description xml:lang="en">This code is to be used when no breakdown is made between the reasons why data are missing. Data can be missing due to many reasons: data cannot exist, data exist but are not collected (e.g. because they are below a certain threshold or subject to a derogation clause), data are unreliable, etc.</com:Description>
        </str:Code>
        <str:Code id="M" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OBS_STATUS(1.1.0).M">
          <com:Name xml:lang="en">Missing value; data cannot exist</com:Name>
          <com:Description xml:lang="en">Used to denote empty cells resulting from the impossibility to collect a statistical value (e.g. a particular education level or type of institution may be not applicable to a given country's education system).</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_LANGUAGE(1.1.0)" agencyID="IMF" id="CL_LANGUAGE" version="1.1.0" isFinal="true" isExternalReference="false" isPartial="false">
