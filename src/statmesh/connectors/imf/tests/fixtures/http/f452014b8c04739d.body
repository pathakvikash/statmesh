      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_METHODOLOGY(2.8.0)" agencyID="IMF" id="CL_METHODOLOGY" version="2.8.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Methodology</com:Name>
        <com:Description xml:lang="en">This codelist identifies the specific statistical methodologies and conceptual frameworks used in the collection, processing, analysis, and presentation of data within a dataset.</com:Description>
        <str:Code id="BPM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).BPM">
          <com:Name xml:lang="en">Balance of Payments Statistics (BOP) Statistics</com:Name>
          <com:Description xml:lang="en">A statistical framework for recording and classifying international transactions.</com:Description>
        </str:Code>
        <str:Code id="BPM6" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).BPM6">
          <com:Name xml:lang="en">Balance of Payments and International Investment Position Manual, Sixth Edition (BPM6)</com:Name>
          <com:Description xml:lang="en">Updated in 2009, BPM6 incorporates changes in the global economy like globalization and financial innovation. It provides a more integrated approach to balance of payments and international investment position statistics.</com:Description>
        </str:Code>
        <str:Code id="BPM6MI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).BPM6MI">
          <com:Name xml:lang="en">Balance of Payments and International Investment Position Manual 6th Edition (BPM6): Memorandum Items</com:Name>
          <com:Description xml:lang="en">Refers to additional items in BPM6 that provide supplementary information.</com:Description>
        </str:Code>
        <str:Code id="BPM6SC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).BPM6SC">
          <com:Name xml:lang="en">Balance of Payments and International Investment Position Manual 6th Edition (BPM6): Standard Component</com:Name>
          <com:Description xml:lang="en">Refers to the core components of the BPM6 framework.</com:Description>
        </str:Code>
        <str:Code id="BPM6SI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).BPM6SI">
          <com:Name xml:lang="en">Balance of Payments and International Investment Position Manual 6th Edition (BPM6): Supplementary Items</com:Name>
          <com:Description xml:lang="en">Refers to additional items in BPM6 that provide supplementary information.</com:Description>
        </str:Code>
        <str:Code id="IIP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).IIP">
          <com:Name xml:lang="en">International Investment Position (IIP)</com:Name>
          <com:Description xml:lang="en">Statistics that measure a country's stock of foreign assets and liabilities.</com:Description>
        </str:Code>
        <str:Code id="IIPSC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).IIPSC">
          <com:Name xml:lang="en">International Investment Position (IIP): Standard Component</com:Name>
          <com:Description xml:lang="en">Refers to the core components of the IIP framework.</com:Description>
        </str:Code>
        <str:Code id="IIPSI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).IIPSI">
          <com:Name xml:lang="en">International Investment Position (IIP): Supplementary Items</com:Name>
          <com:Description xml:lang="en">Refers to additional items in the IIP framework that provide supplementary information.</com:Description>
        </str:Code>
        <str:Code id="BPM5" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).BPM5">
          <com:Name xml:lang="en">Balance of Payments and International Investment Position Manual, Fifth Edition (BPM5)</com:Name>
          <com:Description xml:lang="en">A comprehensive guide to compiling balance of payments and international investment position statistics, published in 1993. It provides a framework for recording and classifying international transactions.</com:Description>
        </str:Code>
        <str:Code id="CPC21" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).CPC21">
          <com:Name xml:lang="en">Central Product Classification (CPC)</com:Name>
          <com:Description xml:lang="en">https://unstats.un.org/unsd/classifications/unsdclassifications/cpcv21.pdf</com:Description>
        </str:Code>
        <str:Code id="CPI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_METHODOLOGY(2.8.0).CPI">
          <com:Name xml:lang="en">Consumer Price Statistics</com:Name>
          <com:Description xml:lang="en">A statistical method for measuring changes in the prices of consumer goods and services.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_COMMODITY(2.2.0)" agencyID="IMF" id="CL_COMMODITY" version="2.2.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Commodity</com:Name>
        <com:Description xml:lang="en">Comprehensive list of all the different commodity codes used in IMF.</com:Description>
        <str:Code id="PRAWM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PRAWM">
          <com:Name xml:lang="en">Agricultural raw materials</com:Name>
          <com:Description xml:lang="en">Agricultural Raw Materials Index, 2016 = 100, includes Timber, Cotton, Wool, Rubber, and Hides Price Indices. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        <str:Code id="PAGRI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PAGRI">
          <com:Name xml:lang="en">Agriculture</com:Name>
          <com:Description xml:lang="en">Agriculture Price Index, 2016 = 100, includes Food and Beverages and Agriculture Raw Materials Price Indices. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        <str:Code id="PALLFNF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PALLFNF">
          <com:Name xml:lang="en">All commodities</com:Name>
          <com:Description xml:lang="en">All Commodity Price Index, 2016 = 100, includes both Fuel and Non-Fuel Price Indices. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        <str:Code id="PEXGMETA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PEXGMETA">
          <com:Name xml:lang="en">All metals excluding gold</com:Name>
          <com:Description xml:lang="en">All Metals EX GOLD Index, 2016 = 100: includes Metal Price Index (Base Metals) and ONLY Silver, Palladium, Platinum. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        <str:Code id="PALLMETA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PALLMETA">
          <com:Name xml:lang="en">All metals</com:Name>
          <com:Description xml:lang="en">All Metals Index, 2016 = 100: includes Metal Price Index (Base Metals) and Precious Metals Index. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        <str:Code id="PALUM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PALUM">
          <com:Name xml:lang="en">Aluminum</com:Name>
          <com:Description xml:lang="en">Aluminum, 99.5% minimum purity, LME spot price, CIF UK ports, US$ per metric ton. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        <str:Code id="PBANSOP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PBANSOP">
          <com:Name xml:lang="en">Bananas</com:Name>
          <com:Description xml:lang="en">Bananas, Central American and Ecuador, FOB U.S. Ports, US$ per metric ton. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        <str:Code id="PBARL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PBARL">
          <com:Name xml:lang="en">Barley</com:Name>
          <com:Description xml:lang="en">Barley, Canadian no.1 Western Barley, spot price, US$ per metric ton. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        <str:Code id="PBEEF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PBEEF">
          <com:Name xml:lang="en">Beef</com:Name>
          <com:Description xml:lang="en">Beef, Australian and New Zealand 85% lean fores, CIF U.S. import price, US cents per pound. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        <str:Code id="PBEVE" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COMMODITY(2.2.0).PBEVE">
          <com:Name xml:lang="en">Beverages</com:Name>
          <com:Description xml:lang="en">Beverage Price Index, 2016 = 100, includes Coffee, Tea, and Cocoa. This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across different datasets, differences can occur due to differences in compilation methodology, reference year, splicing series to preserve time-series continuity, and when the data were collected, processed, and published.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_DERIVATION_TYPE(1.2.1)" agencyID="IMF" id="CL_DERIVATION_TYPE" version="1.2.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Derivation Type </com:Name>
        <com:Description xml:lang="en">This codelist identifies the specific method used to derive a new data element or indicator from source data, such as raw data, IMF staff calculations, IMF staff estimates, or IMF staff projections.</com:Description>
        <str:Code id="SEME" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).SEME">
          <com:Name xml:lang="en">Staff estimates using group mean imputation methods</com:Name>
          <com:Description xml:lang="en">Staff estimates using group mean imputation methods.</com:Description>
        </str:Code>
        <str:Code id="SEHI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).SEHI">
          <com:Name xml:lang="en">Staff estimates using historical imputation methods</com:Name>
          <com:Description xml:lang="en">Staff estimates using historical imputation methods.</com:Description>
        </str:Code>
        <str:Code id="R" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).R">
          <com:Name xml:lang="en">Raw data (no derivation)</com:Name>
          <com:Description xml:lang="en">Non-transformed data (also called original data) refers to data in its original form, before any mathematical or statistical operations have been applied to change its values or distribution.</com:Description>
        </str:Code>
        <str:Code id="SC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).SC">
          <com:Name xml:lang="en">IMF Staff calculations (derived value)</com:Name>
          <com:Description xml:lang="en">Data that results from direct calculations or transformations performed on raw data by IMF staff. These calculations are usually straightforward and transparent, with the published numbers easily traceable back to the source data.</com:Description>
        </str:Code>
        <str:Code id="SCC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).SCC">
          <com:Name xml:lang="en">IMF Staff calculations (derived from counterpart data)</com:Name>
          <com:Description xml:lang="en">Data resulting from direct application of counterpart data by IMF staff to the official information reported by other countries.</com:Description>
        </str:Code>
        <str:Code id="SE" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).SE">
          <com:Name xml:lang="en">IMF Staff estimates</com:Name>
          <com:Description xml:lang="en">Data derived through calculations or transformations on available source data, where some necessary information might be missing. In these cases, IMF staff uses estimates to fill in the gaps and produce the published numbers.</com:Description>
        </str:Code>
        <str:Code id="SP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).SP">
          <com:Name xml:lang="en">IMF Staff projections</com:Name>
          <com:Description xml:lang="en">Forecasts of future values for a time series, constructed using various techniques such as statistical modeling, trend analysis, and expert judgment. These projections are based on historical data, current economic conditions, and other relevant factors.</com:Description>
        </str:Code>
        <str:Code id="M" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).M">
          <com:Name xml:lang="en">Mixed-type data</com:Name>
          <com:Description xml:lang="en">Data that combines both raw and derived data. This could occur when some components of a dataset are directly reported while others are calculated or estimated.</com:Description>
        </str:Code>
        <str:Code id="O" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).O">
          <com:Name xml:lang="en">Reported official data</com:Name>
          <com:Description xml:lang="en">Official data reported to the IMF by country authorities without any modifications or adjustments made by IMF staff.</com:Description>
        </str:Code>
        <str:Code id="OU" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DERIVATION_TYPE(1.2.1).OU">
          <com:Name xml:lang="en">Reported official data converted to US dollar</com:Name>
          <com:Description xml:lang="en">Official data reported to the IMF by country authorities in a country's domestic currency, which IMF staff then converts to US dollars using appropriate exchange rates.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_FREQ(1.2.0)" agencyID="IMF" id="CL_FREQ" version="1.2.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Frequency</com:Name>
        <com:Description xml:lang="en">This code list provides a set of values indicating the "frequency" of the data (e.g. weekly, monthly, quarterly). The concept “frequency” may refer to various stages in the production process, e.g. data collection or data dissemination. For example, a time series could be disseminated at annual frequency but the underlying data are compiled monthly. The code list is applicable for all different uses of "frequency". This code list was formally adopted on 4 December 2013. More information about and supporting material for this code list and SDMX code lists in general (e.g. list of generic codes for expressing general concepts like "Total", "Unknown", etc.; syntaxes for the creation of further codes; general guidelines for the creation of SDMX code lists) can be found at this address: https://sdmx.org/?page_id=4345.</com:Description>
        <str:Code id="A" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).A">
          <com:Name xml:lang="ar">سنوية</com:Name>
          <com:Name xml:lang="ru">Годовые</com:Name>
          <com:Name xml:lang="pt">Anual</com:Name>
          <com:Name xml:lang="ja">年次</com:Name>
          <com:Name xml:lang="en">Annual</com:Name>
          <com:Name xml:lang="fr">Annuel</com:Name>
          <com:Name xml:lang="es">Anual</com:Name>
          <com:Name xml:lang="zh">每年</com:Name>
          <com:Description xml:lang="ar">تُستخدم لتوصيف البيانات التي يتم جمعها أو نشرها على أساس سنوي.</com:Description>
          <com:Description xml:lang="ru">Используется для данных, собираемых или распространяемых каждый год.</com:Description>
          <com:Description xml:lang="pt">Utilizado para dados compilados ou divulgados anualmente.</com:Description>
          <com:Description xml:lang="ja">毎年収集または公表されるデータに使用。</com:Description>
          <com:Description xml:lang="en">To be used for data collected or disseminated every year.</com:Description>
          <com:Description xml:lang="fr">À utiliser pour les données recueillies ou diffusées chaque année.</com:Description>
          <com:Description xml:lang="es">Se usa para datos recopilados o divulgados cada año.</com:Description>
          <com:Description xml:lang="zh">用于每年收集或发布的数据。</com:Description>
        </str:Code>
        <str:Code id="D" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).D">
          <com:Name xml:lang="ar">يومية</com:Name>
          <com:Name xml:lang="ru">Ежедневные</com:Name>
          <com:Name xml:lang="pt">Diário</com:Name>
          <com:Name xml:lang="ja">日次</com:Name>
          <com:Name xml:lang="en">Daily</com:Name>
          <com:Name xml:lang="fr">Quotidien</com:Name>
          <com:Name xml:lang="es">Diaria</com:Name>
          <com:Name xml:lang="zh">每日</com:Name>
          <com:Description xml:lang="ar">تُستخدم لتوصيف البيانات التي يتم جمعها أو نشرها على أساس يومي.</com:Description>
          <com:Description xml:lang="ru">Используется для данных, собираемых или распространяемых каждый день.</com:Description>
          <com:Description xml:lang="pt">Utilizado para dados compilados ou divulgados diariamente.</com:Description>
          <com:Description xml:lang="ja">毎日収集または公表されるデータに使用。</com:Description>
          <com:Description xml:lang="en">To be used for data collected or disseminated every day.</com:Description>
          <com:Description xml:lang="fr">À utiliser pour les données recueillies ou diffusées chaque jour.</com:Description>
          <com:Description xml:lang="es">Se usa para datos recopilados o divulgados cada día.</com:Description>
          <com:Description xml:lang="zh">用于每天收集或发布的数据。</com:Description>
        </str:Code>
        <str:Code id="M" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).M">
          <com:Name xml:lang="ar">شهرية</com:Name>
          <com:Name xml:lang="ru">Месячные</com:Name>
          <com:Name xml:lang="pt">Mensal</com:Name>
          <com:Name xml:lang="ja">月次</com:Name>
          <com:Name xml:lang="en">Monthly</com:Name>
          <com:Name xml:lang="fr">Mensuel</com:Name>
          <com:Name xml:lang="es">Mensual</com:Name>
          <com:Name xml:lang="zh">每月</com:Name>
          <com:Description xml:lang="ar">تُستخدم لتوصيف البيانات التي يتم جمعها أو نشرها على أساس شهري.</com:Description>
          <com:Description xml:lang="ru">Используется для данных, собираемых или распространяемых каждый месяц.</com:Description>
          <com:Description xml:lang="pt">Utilizado para dados compilados ou divulgados mensalmente.</com:Description>
          <com:Description xml:lang="ja">毎月収集または公表されるデータに使用。</com:Description>
          <com:Description xml:lang="en">To be used for data collected or disseminated every month.</com:Description>
          <com:Description xml:lang="fr">À utiliser pour les données recueillies ou diffusées chaque mois.</com:Description>
          <com:Description xml:lang="es">Se usa para datos recopilados o divulgados cada mes.</com:Description>
          <com:Description xml:lang="zh">用于每月收集或发布的数据。</com:Description>
        </str:Code>
        <str:Code id="Q" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).Q">
          <com:Name xml:lang="ar">ربع سنوية</com:Name>
          <com:Name xml:lang="ru">Квартальные</com:Name>
          <com:Name xml:lang="pt">Trimestral</com:Name>
          <com:Name xml:lang="ja">四半期</com:Name>
          <com:Name xml:lang="en">Quarterly</com:Name>
          <com:Name xml:lang="fr">Trimestriel</com:Name>
          <com:Name xml:lang="es">Trimestral</com:Name>
          <com:Name xml:lang="zh">每季度</com:Name>
          <com:Description xml:lang="ar">تُستخدم لتوصيف البيانات التي يتم جمعها أو نشرها على أساس ربع سنوي.</com:Description>
          <com:Description xml:lang="ru">Используется для данных, собираемых или распространяемых каждый квартал.</com:Description>
          <com:Description xml:lang="pt">Utilizado para dados compilados ou divulgados trimestralmente.</com:Description>
          <com:Description xml:lang="ja">四半期ごとに収集または公表されるデータに使用。</com:Description>
          <com:Description xml:lang="en">To be used for data collected or disseminated every quarter.</com:Description>
          <com:Description xml:lang="fr">À utiliser pour les données recueillies ou diffusées chaque trimestre.</com:Description>
          <com:Description xml:lang="es">Se usa para datos recopilados o divulgados cada trimestre.</com:Description>
          <com:Description xml:lang="zh">用于每季度收集或发布的数据。</com:Description>
        </str:Code>
        <str:Code id="S" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).S">
          <com:Name xml:lang="ar">نصف سنوية</com:Name>
          <com:Name xml:lang="ru">Полугодовые, шестимесячные</com:Name>
          <com:Name xml:lang="pt">Semestral</com:Name>
          <com:Name xml:lang="ja">半期</com:Name>
          <com:Name xml:lang="en">Half-yearly, semester</com:Name>
          <com:Name xml:lang="fr">Semestriel</com:Name>
          <com:Name xml:lang="es">Semestral</com:Name>
          <com:Name xml:lang="zh">每半年</com:Name>
          <com:Description xml:lang="ar">تُستخدم لتوصيف البيانات التي يتم جمعها أو نشرها على أساس نصف سنوي.</com:Description>
          <com:Description xml:lang="ru">Используется для данных, собираемых или распространяемых каждые шесть месяцев.</com:Description>
          <com:Description xml:lang="pt">Utilizado para dados compilados ou divulgados semestralmente.</com:Description>
          <com:Description xml:lang="ja">半期ごとに収集または公表されるデータに使用。</com:Description>
          <com:Description xml:lang="en">To be used for data collected or disseminated every semester.</com:Description>
          <com:Description xml:lang="fr">À utiliser pour les données recueillies ou diffusées chaque semestre.</com:Description>
          <com:Description xml:lang="es">Se usa para datos recopilados o divulgados cada semestre.</com:Description>
          <com:Description xml:lang="zh">用于每半年收集或发布的数据。</com:Description>
        </str:Code>
        <str:Code id="W" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).W">
          <com:Name xml:lang="ar">أسبوعية</com:Name>
          <com:Name xml:lang="ru">Недельные</com:Name>
          <com:Name xml:lang="pt">Semanal</com:Name>
          <com:Name xml:lang="ja">週次</com:Name>
          <com:Name xml:lang="en">Weekly</com:Name>
          <com:Name xml:lang="fr">Hebdomadaire</com:Name>
          <com:Name xml:lang="es">Semanal</com:Name>
          <com:Name xml:lang="zh">每周</com:Name>
          <com:Description xml:lang="ar">تُستخدم لتوصيف البيانات التي يتم جمعها أو نشرها على أساس أسبوعي.</com:Description>
          <com:Description xml:lang="ru">Используется для данных, собираемых или распространяемых каждую неделю.</com:Description>
          <com:Description xml:lang="pt">Utilizado para dados compilados ou divulgados semanalmente.</com:Description>
          <com:Description xml:lang="ja">毎週収集または公表されるデータに使用。</com:Description>
          <com:Description xml:lang="en">To be used for data collected or disseminated every week.</com:Description>
          <com:Description xml:lang="fr">À utiliser pour les données recueillies ou diffusées chaque semaine.</com:Description>
          <com:Description xml:lang="es">Se usa para datos recopilados o divulgados cada semana.</com:Description>
          <com:Description xml:lang="zh">用于每周收集或发布的数据。</com:Description>
        </str:Code>
        <str:Code id="A2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).A2">
          <com:Name xml:lang="en">Biennial</com:Name>
          <com:Description xml:lang="en">To be used for data collected or disseminated every two years.</com:Description>
        </str:Code>
        <str:Code id="A3" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).A3">
          <com:Name xml:lang="en">Triennial</com:Name>
          <com:Description xml:lang="en">To be used for data collected or disseminated every three years.</com:Description>
        </str:Code>
        <str:Code id="A4" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).A4">
          <com:Name xml:lang="en">Quadrennial</com:Name>
          <com:Description xml:lang="en">To be used for data collected or disseminated every four years.</com:Description>
        </str:Code>
        <str:Code id="A5" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FREQ(1.2.0).A5">
          <com:Name xml:lang="en">Quinquennial</com:Name>
          <com:Description xml:lang="en">To be used for data collected or disseminated every five years.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_CIVIL_STATUS(1.0.1)" agencyID="IMF" id="CL_CIVIL_STATUS" version="1.0.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Civil (or Marital) Status</com:Name>
        <com:Description xml:lang="en">This codelist identifies the legal status of an individual regarding marriage, such as single, married, widowed, or divorced.</com:Description>
        <str:Code id="S" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CIVIL_STATUS(1.0.1).S">
          <com:Name xml:lang="ar">شخص أعزب</com:Name>
          <com:Name xml:lang="ru">Холостой/незамужняя</com:Name>
          <com:Name xml:lang="pt">Pessoa solteira</com:Name>
          <com:Name xml:lang="ja">独身者</com:Name>
          <com:Name xml:lang="en">Single person</com:Name>
          <com:Name xml:lang="fr">Personne célibataire</com:Name>
          <com:Name xml:lang="es">Persona soltera</com:Name>
          <com:Name xml:lang="zh">单身人士</com:Name>
          <com:Description xml:lang="ar">يشمل هذا الرمز الأشخاص الذين لم يسبق لهم الزواج أو الدخول في شراكة مسجلة.</com:Description>
          <com:Description xml:lang="ru">Этот код включает лиц, которые никогда не состояли в браке или зарегистрированном партнерстве.</com:Description>
          <com:Description xml:lang="pt">Este código inclui pessoas que nunca foram casadas ou em união de facto registrada.</com:Description>
          <com:Description xml:lang="ja">このコードには、結婚または登録パートナーシップをしたことがない人が含まれます。</com:Description>
          <com:Description xml:lang="en">This code includes persons who have never been married or in registered partnership.</com:Description>
          <com:Description xml:lang="fr">Ce code inclut les personnes qui n'ont jamais été mariées ou en partenariat enregistré.</com:Description>
          <com:Description xml:lang="es">Este código incluye a las personas que nunca han estado casadas o en una pareja de hecho registrada.</com:Description>
          <com:Description xml:lang="zh">此代码包括从未结婚或登记伴侣关系的人。</com:Description>
        </str:Code>
        <str:Code id="M" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CIVIL_STATUS(1.0.1).M">
          <com:Name xml:lang="ar">شخص متزوج</com:Name>
          <com:Name xml:lang="ru">Женатый/замужняя</com:Name>
          <com:Name xml:lang="pt">Pessoa casada</com:Name>
          <com:Name xml:lang="ja">既婚者</com:Name>
          <com:Name xml:lang="en">Married person</com:Name>
          <com:Name xml:lang="fr">Personne mariée</com:Name>
          <com:Name xml:lang="es">Persona casada</com:Name>
          <com:Name xml:lang="zh">已婚人士</com:Name>
          <com:Description xml:lang="ar">يشمل هذا الرمز الأشخاص الذين يعيشون في زواج من نفس الجنس وكذلك في زواج من جنسين مختلفين. يستثني هذا الرمز الأشخاص المنفصلين قانونًا.</com:Description>
          <com:Description xml:lang="ru">Этот код охватывает как лиц, живущих в однополом браке, так и в разнополом браке. Этот код исключает лиц, находящихся в законном разводе.</com:Description>
          <com:Description xml:lang="pt">Este código abrange tanto as pessoas que vivem em casamento entre pessoas do mesmo sexo como as que vivem em casamento entre pessoas de sexo diferente. Este código exclui as pessoas legalmente separadas.</com:Description>
          <com:Description xml:lang="ja">このコードは、同性婚と異性婚の両方の当事者を対象としています。このコードは、法的に別居している人を除外します。</com:Description>
          <com:Description xml:lang="en">This code covers both persons living in a same-sex marriage as well as in an opposite-sex marriage. This code excludes legally separated persons.</com:Description>
          <com:Description xml:lang="fr">Ce code couvre les personnes vivant dans un mariage homosexuel ainsi que dans un mariage hétérosexuel. Ce code exclut les personnes légalement séparées.</com:Description>
          <com:Description xml:lang="es">Este código cubre tanto a las personas que viven en un matrimonio entre personas del mismo sexo como a las que viven en un matrimonio entre personas de distinto sexo. Este código excluye a las personas legalmente separadas.</com:Description>
          <com:Description xml:lang="zh">此代码涵盖同性婚姻和异性婚姻中的双方。此代码不包括合法分居的人。</com:Description>
        </str:Code>
        <str:Code id="W" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CIVIL_STATUS(1.0.1).W">
          <com:Name xml:lang="ar">شخص أرمل</com:Name>
          <com:Name xml:lang="ru">Вдова/вдовец</com:Name>
          <com:Name xml:lang="pt">Pessoa viúva</com:Name>
          <com:Name xml:lang="ja">配偶者と死別した人</com:Name>
          <com:Name xml:lang="en">Widowed person</com:Name>
          <com:Name xml:lang="fr">Personne veuve</com:Name>
          <com:Name xml:lang="es">Persona viuda</com:Name>
          <com:Name xml:lang="zh">丧偶人士</com:Name>
          <com:Description xml:lang="ar">يشمل هذا الرمز الأشخاص الذين انتهى زواجهم بوفاة الشريك ولم يتزوجوا مرة أخرى أو في شراكة مسجلة.</com:Description>
          <com:Description xml:lang="ru">Этот код включает лиц, чей брак был расторгнут смертью партнера и которые не вступили в повторный брак или зарегистрированное партнерство.</com:Description>
          <com:Description xml:lang="pt">Este código inclui pessoas cujo casamento terminou com a morte do parceiro e que não voltaram a casar ou em união de facto registrada.</com:Description>
          <com:Description xml:lang="ja">このコードには、配偶者の死亡により婚姻が終了し、再婚または登録パートナーシップをしていない人が含まれます。</com:Description>
          <com:Description xml:lang="en">This code includes persons whose marriage ended with the death of the partner and who are not remarried or in a registered partnership.</com:Description>
          <com:Description xml:lang="fr">Ce code inclut les personnes dont le mariage a pris fin par le décès du partenaire et qui ne sont pas remariées ou en partenariat enregistré.</com:Description>
          <com:Description xml:lang="es">Este código incluye a las personas cuyo matrimonio terminó con la muerte de la pareja y que no se han vuelto a casar ni están en una pareja de hecho registrada.</com:Description>
          <com:Description xml:lang="zh">此代码包括因伴侣去世而婚姻终止且未再婚或登记伴侣关系的人。</com:Description>
        </str:Code>
        <str:Code id="D" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CIVIL_STATUS(1.0.1).D">
          <com:Name xml:lang="ar">شخص مطلق</com:Name>
          <com:Name xml:lang="ru">Разведенный/разведенная</com:Name>
          <com:Name xml:lang="pt">Pessoa divorciada</com:Name>
          <com:Name xml:lang="ja">離婚者</com:Name>
          <com:Name xml:lang="en">Divorced person</com:Name>
          <com:Name xml:lang="fr">Personne divorcée</com:Name>
          <com:Name xml:lang="es">Persona divorciada</com:Name>
          <com:Name xml:lang="zh">离婚人士</com:Name>
          <com:Description xml:lang="ar">يشمل هذا الرمز الأشخاص الذين انتهى زواجهم بإجراءات الطلاق ولم يتزوجوا مرة أخرى أو في شراكة مسجلة.</com:Description>
          <com:Description xml:lang="ru">Этот код включает лиц, чей брак был расторгнут в результате процедуры развода и которые не вступили в повторный брак или зарегистрированное партнерство.</com:Description>
          <com:Description xml:lang="pt">Este código inclui pessoas cujo casamento terminou com um processo de divórcio e que não voltaram a casar ou em união de facto registrada.</com:Description>
          <com:Description xml:lang="ja">このコードには、離婚手続きにより婚姻が終了し、再婚または登録パートナーシップをしていない人が含まれます。</com:Description>
          <com:Description xml:lang="en">This code includes persons whose marriage ended with a divorce procedure and who are not remarried or in a registered partnership.</com:Description>
          <com:Description xml:lang="fr">Ce code inclut les personnes dont le mariage a pris fin par une procédure de divorce et qui ne sont pas remariées ou en partenariat enregistré.</com:Description>
          <com:Description xml:lang="es">Este código incluye a las personas cuyo matrimonio terminó con un procedimiento de divorcio y que no se han vuelto a casar ni están en una pareja de hecho registrada.</com:Description>
          <com:Description xml:lang="zh">此代码包括因离婚程序而婚姻终止且未再婚或登记伴侣关系的人。</com:Description>
        </str:Code>
        <str:Code id="L" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CIVIL_STATUS(1.0.1).L">
          <com:Name xml:lang="ar">شخص منفصل قانونيًا</com:Name>
          <com:Name xml:lang="ru">Лицо, состоящее в законном раздельном проживании</com:Name>
          <com:Name xml:lang="pt">Pessoa separada legalmente</com:Name>
          <com:Name xml:lang="ja">法的に別居している人</com:Name>
          <com:Name xml:lang="en">Legally separated person</com:Name>
          <com:Name xml:lang="fr">Personne séparée légalement</com:Name>
          <com:Name xml:lang="es">Persona separada legalmente</com:Name>
          <com:Name xml:lang="zh">依法分居人士</com:Name>
          <com:Description xml:lang="ar">يشمل هذا الرمز الأشخاص المنفصلين: فهم ما زالوا متزوجين، لكنهم منفصلون "رسميًا".</com:Description>
          <com:Description xml:lang="ru">Этот код включает лиц, которые находятся в разводе: они все еще состоят в браке, но "официально" разлучены.</com:Description>
          <com:Description xml:lang="pt">Este código inclui pessoas que estão separadas: ainda estão casadas, mas "oficialmente" separadas.</com:Description>
          <com:Description xml:lang="ja">このコードには、別居している人が含まれます。彼らはまだ結婚していますが、「公式に」別居しています。</com:Description>
          <com:Description xml:lang="en">This code includes persons who are separated: they are still married, but "officially" separated.</com:Description>
          <com:Description xml:lang="fr">Ce code inclut les personnes séparées : elles sont toujours mariées, mais séparées « officiellement ».</com:Description>
          <com:Description xml:lang="es">Este código incluye a las personas que están separadas: todavía están casadas, pero "oficialmente" separadas.</com:Description>
          <com:Description xml:lang="zh">此代码包括分居的人：他们仍然结婚，但“正式”分居。</com:Description>
        </str:Code>
        <str:Code id="P" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CIVIL_STATUS(1.0.1).P">
          <com:Name xml:lang="ar">شخص في شراكة مسجلة</com:Name>
          <com:Name xml:lang="ru">Лицо, состоящее в зарегистрированном партнерстве</com:Name>
          <com:Name xml:lang="pt">Pessoa em união de facto/registada</com:Name>
          <com:Name xml:lang="ja">登録されたパートナーシップの関係にある人</com:Name>
          <com:Name xml:lang="en">Person in registered partnership</com:Name>
          <com:Name xml:lang="fr">Personne en partenariat enregistré</com:Name>
          <com:Name xml:lang="es">Persona en unión registrada</com:Name>
          <com:Name xml:lang="zh">在册伴侣关系人士</com:Name>
          <com:Description xml:lang="ar">يشمل هذا الرمز الأشخاص الذين يعيشون في شراكة مسجلة من جنسين مختلفين وكذلك في شراكة مسجلة من نفس الجنس. تشمل الشراكات المسجلة أيضًا الزيجات العرفية التي تعتبر قانونية وملزمة بموجب القانون الوطني. يستثني هذا الرمز الأشخاص الذين تم حل شراكتهم المسجلة بشكل قانوني.</com:Description>
          <com:Description xml:lang="ru">Этот код охватывает как лиц, живущих в зарегистрированном партнерстве с лицом противоположного пола, так и в зарегистрированном партнерстве с лицом того же пола. Зарегистрированные партнерства также включают традиционные союзы, которые являются законными и обязательными в соответствии с национальным законодательством. Этот код исключает лиц, чье зарегистрированное партнерство было юридически расторгнуто.</com:Description>
          <com:Description xml:lang="pt">Este código abrange tanto as pessoas que vivem em união de facto registrada entre pessoas de sexo diferente como as que vivem em união de facto registrada entre pessoas do mesmo sexo. As uniões de facto registradas também incluem as uniões consuetudinárias que são legais e vinculativas ao abrigo da lei nacional. Este código exclui as pessoas cuja união de facto registrada foi legalmente dissolvida.</com:Description>
          <com:Description xml:lang="ja">このコードは、異性登録パートナーシップと、同性登録パートナーシップの両方の当事者を対象としています。登録パートナーシップには、国内法で合法かつ拘束力のある慣習的な組合も含まれます。このコードは、登録パートナーシップが法的に解消された人を除外します。</com:Description>
          <com:Description xml:lang="en">This code covers both persons living in an opposite-sex registered partnership as well as in a same-sex registered partnership. Registered partnerships also include customary unions that are legal and binding under national law. This code excludes persons whose registered partnership was legally dissolved.</com:Description>
          <com:Description xml:lang="fr">Ce code couvre les personnes vivant dans un partenariat enregistré hétérosexuel ainsi que dans un partenariat enregistré homosexuel. Les partenariats enregistrés comprennent également les unions coutumières qui sont légales et contraignantes en vertu du droit national. Ce code exclut les personnes dont le partenariat enregistré a été légalement dissous.</com:Description>
          <com:Description xml:lang="es">Este código cubre tanto a las personas que viven en una pareja de hecho registrada entre personas de distinto sexo como a las que viven en una pareja de hecho registrada entre personas del mismo sexo. Las parejas de hecho registradas también incluyen las uniones consuetudinarias que son legales y vinculantes en virtud del derecho nacional. Este código excluye a las personas cuya pareja de hecho registrada se disolvió legalmente.</com:Description>
          <com:Description xml:lang="zh">此代码涵盖异性登记伴侣关系和同性登记伴侣关系中的双方。登记伴侣关系还包括根据国家法律具有法律约束力的习惯结合。此代码不包括登记伴侣关系已合法解除的人。</com:Description>
        </str:Code>
        <str:Code id="Q" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CIVIL_STATUS(1.0.1).Q">
          <com:Name xml:lang="ar">شخص انتهت شراكته المسجلة بوفاة الشريك</com:Name>
          <com:Name xml:lang="ru">Лицо, зарегистрированное партнерство которого прекратилось в связи со смертью партнера</com:Name>
          <com:Name xml:lang="pt">Pessoa cuja união de facto/registada terminou com a morte do parceiro/a</com:Name>
          <com:Name xml:lang="ja">登録されたパートナーシップがパートナーの死によって終了した人</com:Name>
          <com:Name xml:lang="en">Person whose registered partnership ended with the death of the partner</com:Name>
          <com:Name xml:lang="fr">Personne dont le partenariat enregistré a pris fin par le décès du partenaire</com:Name>
          <com:Name xml:lang="es">Persona cuya unión registrada terminó con la muerte del compañero/a</com:Name>
          <com:Name xml:lang="zh">登记伴侣关系因伴侣死亡而终止的人士</com:Name>
          <com:Description xml:lang="ar">يشمل هذا الرمز الأشخاص الذين انتهت شراكتهم المسجلة بوفاة الشريك ولم يتزوجوا مرة أخرى أو في شراكة مسجلة.</com:Description>
          <com:Description xml:lang="ru">Этот код включает лиц, чье зарегистрированное партнерство было расторгнуто смертью партнера и которые не вступили в повторный брак или зарегистрированное партнерство.</com:Description>
          <com:Description xml:lang="pt">Este código inclui pessoas cuja união de facto registrada terminou com a morte do parceiro e que não voltaram a casar ou em união de facto registrada.</com:Description>
          <com:Description xml:lang="ja">このコードには、パートナーの死亡により登録パートナーシップが終了し、再婚または登録パートナーシップをしていない人が含まれます。</com:Description>
          <com:Description xml:lang="en">This code includes persons whose registered partnership ended with the death of the partner and who are not remarried or in a registered partnership.</com:Description>
          <com:Description xml:lang="fr">Ce code inclut les personnes dont le partenariat enregistré a pris fin par le décès du partenaire et qui ne sont pas remariées ou en partenariat enregistré.</com:Description>
          <com:Description xml:lang="es">Este código incluye a las personas cuya pareja de hecho registrada terminó con la muerte de la pareja y que no se han vuelto a casar ni están en una pareja de hecho registrada.</com:Description>
          <com:Description xml:lang="zh">此代码包括因伴侣去世而登记伴侣关系终止且未再婚或登记伴侣关系的人。</com:Description>
        </str:Code>
        <str:Code id="E" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CIVIL_STATUS(1.0.1).E">
          <com:Name xml:lang="ar">شخص تم حل شراكته المسجلة قانونيًا</com:Name>
          <com:Name xml:lang="ru">Лицо, зарегистрированное партнерство которого было расторгнуто в судебном порядке</com:Name>
          <com:Name xml:lang="pt">Pessoa cuja união de facto/registada foi legalmente dissolvida</com:Name>
          <com:Name xml:lang="ja">登録されたパートナーシップが法的に解消された人</com:Name>
          <com:Name xml:lang="en">Person whose registered partnership was legally dissolved</com:Name>
          <com:Name xml:lang="fr">Personne dont le partenariat enregistré a été légalement dissous</com:Name>
          <com:Name xml:lang="es">Persona cuya unión registrada fue legalmente disuelta</com:Name>
          <com:Name xml:lang="zh">登记伴侣关系依法解除的人士</com:Name>
          <com:Description xml:lang="ar">يشمل هذا الرمز الأشخاص الذين انتهت شراكتهم المسجلة بإجراء قانوني ولم يتزوجوا مرة أخرى أو في شراكة مسجلة.</com:Description>
          <com:Description xml:lang="ru">Этот код включает лиц, чье зарегистрированное партнерство было расторгнуто в результате судебного разбирательства и которые не вступили в повторный брак или зарегистрированное партнерство.</com:Description>
          <com:Description xml:lang="pt">Este código inclui pessoas cuja união de facto registrada terminou com um processo legal e que não voltaram a casar ou em união de facto registrada.</com:Description>
          <com:Description xml:lang="ja">このコードには、法的手続きにより登録パートナーシップが終了し、再婚または登録パートナーシップをしていない人が含まれます。</com:Description>
          <com:Description xml:lang="en">This code includes persons whose registered partnership ended with a legal procedure and who are not remarried or in a registered partnership.</com:Description>
          <com:Description xml:lang="fr">Ce code inclut les personnes dont le partenariat enregistré a pris fin par une procédure légale et qui ne sont pas remariées ou en partenariat enregistré.</com:Description>
          <com:Description xml:lang="es">Este código incluye a las personas cuya pareja de hecho registrada terminó con un procedimiento legal y que no se han vuelto a casar ni están en una pareja de hecho registrada.</com:Description>
          <com:Description xml:lang="zh">此代码包括因法律程序而登记伴侣关系终止且未再婚或登记伴侣关系的人。</com:Description>
        </str:Code>
      </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_NA_STO(2.5.0)" agencyID="IMF" id="CL_NA_STO" version="2.5.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">NA Stocks, Transactions, Other Flows</com:Name>
        <com:Description xml:lang="en">This codelist represents the different classifications of data items used in the System of National Accounts (SNA) framework, distinguishing between stocks (levels at a point in time), transactions (changes over a period), and other flows.</com:Description>
        <str:Code id="DG1" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).DG1">
          <com:Name xml:lang="en">Grants in cash</com:Name>
          <com:Description xml:lang="en">Grants provided in monetary form.</com:Description>
        </str:Code>
        <str:Code id="DG2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).DG2">
          <com:Name xml:lang="en">Grants in kind</com:Name>
          <com:Description xml:lang="en">Grants provided as goods or services rather than cash.</com:Description>
        </str:Code>
        <str:Code id="DK" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).DK">
          <com:Name xml:lang="en">Taxes on property</com:Name>
          <com:Description xml:lang="en">Taxes levied on ownership or transfer of property (land, buildings, etc.).</com:Description>
        </str:Code>
        <str:Code id="DK2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).DK2">
          <com:Name xml:lang="en">Recurrent taxes on wealth: taxes on property</com:Name>
          <com:Description xml:lang="en">Taxes levied regularly on the value of wealth, including property.</com:Description>
        </str:Code>
        <str:Code id="DK3" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).DK3">
          <com:Name xml:lang="en">Other recurrent taxes on property: taxes on property</com:Name>
          <com:Description xml:lang="en">Recurrent property taxes not classified as wealth taxes, such as annual property taxes.</com:Description>
        </str:Code>
        <str:Code id="EMP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).EMP">
          <com:Name xml:lang="en">Total employment</com:Name>
          <com:Description xml:lang="en">The total number of employed persons.</com:Description>
        </str:Code>
        <str:Code id="F" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).F">
          <com:Name xml:lang="en">Transactions in financial assets and liabilities</com:Name>
          <com:Description xml:lang="en">All transactions involving changes in financial assets (e.g., stocks, bonds) and liabilities (e.g., loans).</com:Description>
        </str:Code>
        <str:Code id="FI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).FI">
          <com:Name xml:lang="en">Factor Income</com:Name>
          <com:Description xml:lang="en">Income earned from factors of production (labor, capital).</com:Description>
        </str:Code>
        <str:Code id="GB8ZG" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).GB8ZG">
          <com:Name xml:lang="en">Gross operating balance</com:Name>
          <com:Description xml:lang="en">The surplus or deficit from production activities before deducting interest and other property income.</com:Description>
        </str:Code>
        <str:Code id="GB8ZN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0).GB8ZN">
          <com:Name xml:lang="en">Net operating balance</com:Name>
          <com:Description xml:lang="en">The gross operating balance less consumption of fixed capital (depreciation).</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_NA_STO(2.5.0)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">The sum of all relevant components or categories.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_INT_TTC(2.7.1)" agencyID="IMF" id="CL_INT_TTC" version="2.7.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Interest Rate types, terms and conditions</com:Name>
        <com:Description xml:lang="en">A classification of interest rates based on their type (fixed or floating), terms (maturity), and other conditions (e.g., collateralization, reference rates).</com:Description>
        <str:Code id="FILIBOR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).FILIBOR">
          <com:Name xml:lang="en">3- or 6-month London interbank offered interest rate (LIBOR)</com:Name>
          <com:Description xml:lang="en">The average interest rate, determined by a daily survey of major global banks, at which banks in London lend unsecured short-term funds to other banks in the London interbank market. The rate is quoted for various maturities, including 3- and 6-month periods.</com:Description>
        </str:Code>
        <str:Code id="FILIBOR_R" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).FILIBOR_R">
          <com:Name xml:lang="en">3- or 6-month London interbank offered interest rate (LIBOR), real</com:Name>
          <com:Description xml:lang="en">The 3- or 6-month LIBOR, adjusted for inflation, to reflect constant purchasing power. This is typically calculated by subtracting the expected inflation rate from the nominal LIBOR rate.</com:Description>
        </str:Code>
        <str:Code id="FIST" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).FIST">
          <com:Name xml:lang="en">3-month bond yield (or nearest equivalent)</com:Name>
          <com:Description xml:lang="en">The return on investment for a 3-month government bond or a bond of similar maturity.</com:Description>
        </str:Code>
        <str:Code id="INT3EURIBOR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).INT3EURIBOR">
          <com:Name xml:lang="en">3-month Euro Interbank offered rate (EURIBOR)</com:Name>
          <com:Description xml:lang="en">The average unsecured interbank lending rate in the Euro area for a three-month maturity, based on daily bank submissions.</com:Description>
        </str:Code>
        <str:Code id="MFS129" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).MFS129">
          <com:Name xml:lang="en">3-Month interbank rate</com:Name>
          <com:Description xml:lang="en">The average interbank lending rate for a three-month maturity, based on daily bank submissions.</com:Description>
        </str:Code>
        <str:Code id="3LIBOR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).3LIBOR">
          <com:Name xml:lang="en">3-month London Interbank offered rate (LIBOR)</com:Name>
          <com:Description xml:lang="en">The average unsecured interbank lending rate in London for a three-month maturity, based on daily submissions from major global banks.</com:Description>
        </str:Code>
        <str:Code id="LIBOR_R" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).LIBOR_R">
          <com:Name xml:lang="en">6-month London interbank offered interest rate (LIBOR), real</com:Name>
          <com:Description xml:lang="en">The 6-month LIBOR, adjusted for inflation, to reflect constant purchasing power. This is typically calculated by subtracting the expected inflation rate from the nominal LIBOR rate.</com:Description>
        </str:Code>
        <str:Code id="LIBOR_RA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).LIBOR_RA">
          <com:Name xml:lang="en">6-month London interbank offered interest rate (LIBOR), real, Archive</com:Name>
          <com:Description xml:lang="en">The archived interest rate for real 6-month LIBOR.</com:Description>
        </str:Code>
        <str:Code id="MFS130" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).MFS130">
          <com:Name xml:lang="en">Average cost of funds</com:Name>
          <com:Description xml:lang="en">The average interest rate that financial institutions pay to borrow money.</com:Description>
        </str:Code>
        <str:Code id="BY" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_TTC(2.7.1).BY">
          <com:Name xml:lang="en">Bond yield</com:Name>
          <com:Description xml:lang="en">The rate of return implied by a bond’s price, coupon payments, and time to maturity.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_TOPIC(2.3.1)" agencyID="IMF" id="CL_TOPIC" version="2.3.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Topic</com:Name>
        <com:Description xml:lang="en">This codelist provides a high-level categorization of the resource's subject matter, indicating the main area or domain to which the data pertains.</com:Description>
        <str:Code id="DEM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).DEM">
          <com:Name xml:lang="ar">الديموغرافية والاجتماعية</com:Name>
          <com:Name xml:lang="ru">Демографические и социальные</com:Name>
          <com:Name xml:lang="ja">人口統計・社会</com:Name>
          <com:Name xml:lang="en">Demographic and social</com:Name>
          <com:Name xml:lang="fr">Démographique et social</com:Name>
          <com:Name xml:lang="es">Demográfico y social</com:Name>
          <com:Name xml:lang="zh">人口与社会</com:Name>
          <com:Description xml:lang="en">Population demographics, social indicators, and labor market statistics.</com:Description>
        </str:Code>
        <str:Code id="J20" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).J20">
          <com:Name xml:lang="ar">أسواق العمل</com:Name>
          <com:Name xml:lang="ru">Рынки труда</com:Name>
          <com:Name xml:lang="ja">労働市場</com:Name>
          <com:Name xml:lang="en">Labor markets</com:Name>
          <com:Name xml:lang="fr">Marchés du travail</com:Name>
          <com:Name xml:lang="es">Mercados laborales</com:Name>
          <com:Name xml:lang="zh">劳动力市场</com:Name>
          <com:Description xml:lang="en">The labor market, encompassing employment, unemployment, labor force participation, wages, and other labor-related indicators.</com:Description>
          </str:Code>
        <str:Code id="J21" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).J21">
          <com:Name xml:lang="ar">القوى العاملة</com:Name>
          <com:Name xml:lang="ru">Рабочая сила</com:Name>
          <com:Name xml:lang="ja">労働力</com:Name>
          <com:Name xml:lang="en">Labor force</com:Name>
          <com:Name xml:lang="fr">Population active</com:Name>
          <com:Name xml:lang="es">Población activa</com:Name>
          <com:Name xml:lang="zh">劳动力</com:Name>
          <com:Description xml:lang="en">The total number of people employed and unemployed who are willing and able to work. This provides insights into the size and composition of the workforce and is used to analyze labor market trends and calculate unemployment rates.</com:Description>
          </str:Code>
        <str:Code id="J64" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).J64">
          <com:Name xml:lang="ar">البطالة</com:Name>
          <com:Name xml:lang="ru">Безработица</com:Name>
          <com:Name xml:lang="ja">失業</com:Name>
          <com:Name xml:lang="en">Unemployment</com:Name>
          <com:Name xml:lang="fr">Chômage</com:Name>
          <com:Name xml:lang="es">Desempleo</com:Name>
          <com:Name xml:lang="zh">失业</com:Name>
          <com:Description xml:lang="en">The number of people who are actively seeking employment but cannot find a job. This is used to calculate the unemployment rate, a key indicator of economic performance and social well-being.</com:Description>
          </str:Code>
        <str:Code id="E24" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).E24">
          <com:Name xml:lang="ar">العمالة</com:Name>
          <com:Name xml:lang="ru">Занятость</com:Name>
          <com:Name xml:lang="ja">雇用</com:Name>
          <com:Name xml:lang="en">Employment</com:Name>
          <com:Name xml:lang="fr">Emploi</com:Name>
          <com:Name xml:lang="es">Empleo</com:Name>
          <com:Name xml:lang="zh">就业</com:Name>
          <com:Description xml:lang="en">The number of people currently employed, including information on the types of jobs, industries, and occupations.</com:Description>
          </str:Code>
        <str:Code id="J30" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).J30">
          <com:Name xml:lang="ar">الأجور</com:Name>
          <com:Name xml:lang="ru">Заработная плата</com:Name>
          <com:Name xml:lang="ja">賃金</com:Name>
          <com:Name xml:lang="en">Wages</com:Name>
          <com:Name xml:lang="fr">Salaires</com:Name>
          <com:Name xml:lang="es">Salarios</com:Name>
          <com:Name xml:lang="zh">工资</com:Name>
          <com:Description xml:lang="en">The earnings of employees, including hourly wages, salaries, and other forms of compensation. This is used to analyze income inequality, measure labor costs, and assess the standard of living.</com:Description>
          </str:Code>
        <str:Code id="J10" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).J10">
          <com:Name xml:lang="ar">السكان والتركيبة السكانية</com:Name>
          <com:Name xml:lang="ru">Население и демография</com:Name>
          <com:Name xml:lang="ja">人口と人口統計</com:Name>
          <com:Name xml:lang="en">Population and demographics</com:Name>
          <com:Name xml:lang="fr">Population et données démographiques</com:Name>
          <com:Name xml:lang="es">Población y demografía</com:Name>
          <com:Name xml:lang="zh">人口与人口统计学</com:Name>
          <com:Description xml:lang="en">The size, structure, and distribution of a population.</com:Description>
          </str:Code>
        <str:Code id="J10_P" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).J10_P">
          <com:Name xml:lang="ar">عدد السكان</com:Name>
          <com:Name xml:lang="ru">Население</com:Name>
          <com:Name xml:lang="ja">人口</com:Name>
          <com:Name xml:lang="en">Population</com:Name>
          <com:Name xml:lang="fr">Population</com:Name>
          <com:Name xml:lang="es">Población</com:Name>
          <com:Name xml:lang="zh">人口</com:Name>
          <com:Description xml:lang="en">The total number of people residing in a specific geographic area, such as a country, region, or city. This is essential for demographic analysis, resource allocation, and policy planning.</com:Description>
          </str:Code>
        <str:Code id="J11" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).J11">
          <com:Name xml:lang="ar">التغير الديموغرافي</com:Name>
          <com:Name xml:lang="ru">Демографические изменения</com:Name>
          <com:Name xml:lang="ja">人口動態変化</com:Name>
          <com:Name xml:lang="en">Demographic change</com:Name>
          <com:Name xml:lang="fr">Changement démographique</com:Name>
          <com:Name xml:lang="es">Cambio demográfico</com:Name>
          <com:Name xml:lang="zh">人口变化</com:Name>
          <com:Description xml:lang="en">The changes in the size, composition, and distribution of a population over time. This includes information on birth rates, death rates, age structure, migration patterns, and other demographic factors.</com:Description>
          </str:Code>
        <str:Code id="F22" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TOPIC(2.3.1).F22">
          <com:Name xml:lang="ar">الهجرة</com:Name>
          <com:Name xml:lang="ru">Миграция</com:Name>
          <com:Name xml:lang="ja">移住</com:Name>
          <com:Name xml:lang="en">Migration</com:Name>
          <com:Name xml:lang="fr">Migration</com:Name>
          <com:Name xml:lang="es">Migración</com:Name>
          <com:Name xml:lang="zh">迁移</com:Name>
          <com:Description xml:lang="en">The movement of people across geographical boundaries, including both internal and international migration.</com:Description>
          </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_VALUATION(2.4.1)" agencyID="IMF" id="CL_VALUATION" version="2.4.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Valuation</com:Name>
        <com:Description xml:lang="en">This codelist defines refers to the rules and conventions used for recording monetary flows and stocks in macroeconomic statistics. Standard national accounts valuations include the basic price (what the seller receives) and the purchaser's price (what the purchaser pays). The purchaser's price is the basic price, plus taxes less subsidies on products, plus invoiced transportation and insurance services, plus distribution margin. International trade in goods considers the free on board (fob) price and cost-insurance-freight price, among others. Other valuation types include prices used in financial markets (e.g., buy and sell prices).</com:Description>
        <str:Code id="NV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).NV">
          <com:Name xml:lang="en">Nominal value</com:Name>
          <com:Description xml:lang="en">Outstanding amount that at any moment in time the debtor owes to the creditor. It reflects the funds originally advanced, plus any subsequent advances, plus interest that has accrued, less any repayments (2016 MFSMCG definition).</com:Description>
        </str:Code>
        <str:Code id="MV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).MV">
          <com:Name xml:lang="en">Market value</com:Name>
          <com:Description xml:lang="en">The price at which an asset would change hands if it sold on the open market. Market prices for transactions are defined as amounts of money that willing buyers pay to acquire something from willing sellers; the exchanges are made between independent parties and on the basis of commercial considerations only, sometimes called “at arm’s length.”</com:Description>
        </str:Code>
        <str:Code id="FV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).FV">
          <com:Name xml:lang="en">Face value</com:Name>
          <com:Description xml:lang="en">The amount of principal to be repaid (for example, the redemption amount of a bond). Sometimes called initial contractual value, for loans, the face value is the original amount of the loan as stated in the loan contract. If the loan is not fully disbursed, then the face value will include future disbursements, just as the face value of a zero-coupon bond includes interest that has not yet accrued.</com:Description>
        </str:Code>
        <str:Code id="BV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).BV">
          <com:Name xml:lang="en">Book value</com:Name>
          <com:Description xml:lang="en">Valuation used in business accounts, generally referring to the value recorded in the enterprise records. Book values may have different meanings because their values are influenced by the timing of acquisition, company takeovers, frequency of revaluations and tax and other regulations.</com:Description>
        </str:Code>
        <str:Code id="IV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).IV">
          <com:Name xml:lang="en">Fair value</com:Name>
          <com:Description xml:lang="en">Valuation that reflects the market-equivalent value of an asset or liability. It is defined as the price at which an asset could be exchanged, or a liability settled, between knowledgeable, willing parties in an arm's-length transaction.</com:Description>
        </str:Code>
        <str:Code id="F" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).F">
          <com:Name xml:lang="en">Factor cost</com:Name>
          <com:Description xml:lang="en">Gross value added at factor cost is derived by subtracting "other taxes, less subsidies, on production" from gross value added at basic prices.</com:Description>
        </str:Code>
        <str:Code id="CIF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).CIF">
          <com:Name xml:lang="en">Cost insurance freight (CIF)</com:Name>
          <com:Description xml:lang="en">The c.i.f. price (i.e. cost, insurance and freight price) is the price of a good delivered at the frontier of the importing country, including any insurance and freight charges incurred to that point, or the price of a service delivered to a resident, before the payment of any import duties or other taxes on imports or trade and transport margins within the country.</com:Description>
        </str:Code>
        <str:Code id="FOB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).FOB">
          <com:Name xml:lang="en">Free on board (FOB)</com:Name>
          <com:Description xml:lang="en">The f.o.b. price (free on board price) of exports and imports of goods is the market value of the goods at the point of uniform valuation, (the customs frontier of the economy from which they are exported).  It is equal to the c.i.f. price less the costs of transportation and insurance charges, between the customs frontier of the exporting (importing) country and that of the importing (exporting) country.</com:Description>
        </str:Code>
        <str:Code id="FRFV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).FRFV">
          <com:Name xml:lang="en">Fixed rate, face value</com:Name>
          <com:Description xml:lang="en">A debt instrument with a fixed interest rate and valued at its face value (the amount to be repaid).</com:Description>
        </str:Code>
        <str:Code id="FRNV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).FRNV">
          <com:Name xml:lang="en">Fixed rate, nominal value</com:Name>
          <com:Description xml:lang="en">A debt instrument with a fixed interest rate and valued at its nominal value (the original issue price).</com:Description>
        </str:Code>
        <str:Code id="O" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_VALUATION(2.4.1).O">
          <com:Name xml:lang="en">Previous year's replacement costs</com:Name>
          <com:Description xml:lang="en">The cost to replace an asset in the previous year, used for valuation purposes.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_OVERLAP(1.0.0)" agencyID="IMF" id="CL_OVERLAP" version="1.0.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">IMF Data Overlap</com:Name>
        <com:Description xml:lang="en">This codelist indicates if there is a potential overlap in the coverage of a particular indicator with another indicator in other datasets published by the IMF.</com:Description>
        <str:Code id="OL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_OVERLAP(1.0.0).OL">
          <com:Name xml:lang="en">Overlapping Indicator</com:Name>
          <com:Description xml:lang="en">This indicator appears in other datasets published by the IMF. While every effort is made to ensure that estimates for the same indicator are consistent across datasets, differences can occur due to variations in sources and methods, splicing series to preserve time-series continuity, and timing differences in the collection, processing and publication of the indicator.</com:Description>
        </str:Code>
      </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_INT_ACC_ITEM(2.8.1)" agencyID="IMF" id="CL_INT_ACC_ITEM" version="2.8.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">International accounts item</com:Name>
        <com:Description xml:lang="en">A classification of transactions in the balance of payments, such as trade in goods, services, income, and financial flows.</com:Description>
        <str:Code id="_Z" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1)._Z">
          <com:Name xml:lang="en">Not applicable</com:Name>
          <com:Description xml:lang="en">Not applicable.</com:Description>
        </str:Code>
        <str:Code id="AFA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1).AFA">
          <com:Name xml:lang="en">Acquisition of foreign assets</com:Name>
          <com:Description xml:lang="en">The purchase or obtaining of assets located outside the domestic economy, including investments, real estate, or business entities.</com:Description>
        </str:Code>
        <str:Code id="AMTSCH" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1).AMTSCH">
          <com:Name xml:lang="en">Scheduled amortization</com:Name>
          <com:Description xml:lang="en">This refers to the planned repayments of principal on outstanding loans during a specific period</com:Description>
        </str:Code>
        <str:Code id="AMTSCHB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1).AMTSCHB">
          <com:Name xml:lang="en">Scheduled amortization, before adjustments for exceptional financing</com:Name>
          <com:Description xml:lang="en">This refers to the planned repayments of principal on outstanding loans during a specific period. It excludes any adjustments made for exceptional financing, such as debt rescheduling or forgiveness.</com:Description>
        </str:Code>
        <str:Code id="ANRA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1).ANRA">
          <com:Name xml:lang="en">Acquisition of other nonreserve assets</com:Name>
          <com:Description xml:lang="en">Purchasing assets that do not qualify as reserve assets, such as non-financial assets or financial assets not held for transaction motives or international liquidity.</com:Description>
        </str:Code>
        <str:Code id="BINVISIBLES" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1).BINVISIBLES">
          <com:Name xml:lang="en">Balance on invisibles</com:Name>
          <com:Description xml:lang="en">The net balance of transactions that do not result in the transfer of tangible goods, including services, primary income, and secondary income flows.</com:Description>
        </str:Code>
        <str:Code id="CAB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1).CAB">
          <com:Name xml:lang="en">Current account balance</com:Name>
          <com:Description xml:lang="en">The current account balance is the balance of current transactions (transactions in goods and services, earned income and transfer income) between residents and non-residents. The term current account balance is used in the external accounts and is expressed from the perspective of resident units. The term current external balance is used in the national accounts and is expressed from the perspective of the non-resident units, and therefore with the opposite sign.</com:Description>
        </str:Code>
        <str:Code id="CAB_XGRT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1).CAB_XGRT">
          <com:Name xml:lang="en">Current account balance, excluding grants</com:Name>
          <com:Description xml:lang="en">The current account balance is the balance of current transactions (transactions in goods and services, earned income and transfer income) between residents and non-residents. The term current account balance is used in the external accounts and is expressed from the perspective of resident units. The term current external balance is used in the national accounts and is expressed from the perspective of the non-resident units, and therefore with the opposite sign. It excludes grants.</com:Description>
        </str:Code>
        <str:Code id="CCA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1).CCA">
          <com:Name xml:lang="en">Classic comparative advantage</com:Name>
          <com:Description xml:lang="en">A country had comparative advantage in specific service exports in 2000-04 and maintains comparative advantage in 2008-13, on average.</com:Description>
        </str:Code>
        <str:Code id="CFAB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1).CFAB">
          <com:Name xml:lang="en">Capital and financial account balance</com:Name>
          <com:Description xml:lang="en">The combined net balance of the capital account and the financial account, showing the net flow of capital and financial transactions between residents and non-residents.</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INT_ACC_ITEM(2.8.1)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">The sum of all relevant components or categories.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_STATISTICAL_MEASURES(1.7.0)" agencyID="IMF" id="CL_STATISTICAL_MEASURES" version="1.7.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Statistical Measures</com:Name>
        <com:Description xml:lang="en">This codelist describe characteristics of a group of data. They summarize the distribution, central tendency, or spread of multiple values.</com:Description>
        <str:Code id="MAX" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).MAX">
          <com:Name xml:lang="en">Maximum value</com:Name>
          <com:Description xml:lang="en">In a dataset or set of numbers, the maximum value refers to the largest or highest value present.</com:Description>
        </str:Code>
        <str:Code id="MEAN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).MEAN">
          <com:Name xml:lang="en">Mean</com:Name>
          <com:Description xml:lang="en">The mean is a measure of central tendency, calculated by summing all values in a dataset and dividing by the number of values.</com:Description>
        </str:Code>
        <str:Code id="MIN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).MIN">
          <com:Name xml:lang="en">Minimum value</com:Name>
          <com:Description xml:lang="en">The minimum value is the smallest or lowest value within a dataset. It represents the lower limit of the data range.</com:Description>
        </str:Code>
        <str:Code id="SD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).SD">
          <com:Name xml:lang="en">Standard deviation</com:Name>
          <com:Description xml:lang="en">A statistical measure that quantifies the amount of variation or dispersion of a set of values from their average (mean).</com:Description>
        </str:Code>
        <str:Code id="FV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).FV">
          <com:Name xml:lang="en">Individual forecast</com:Name>
          <com:Description xml:lang="en">An estimated future value or outcome of a random variable for a specific individual observation expressed as a conditional expectation or probability.</com:Description>
        </str:Code>
        <str:Code id="MED" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).MED">
          <com:Name xml:lang="en">Median</com:Name>
          <com:Description xml:lang="en">The median is the middle value in a data set when the values are arranged in ascending or descending order.</com:Description>
        </str:Code>
        <str:Code id="LAG1O" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).LAG1O">
          <com:Name xml:lang="en">Lag 1 (Opening)</com:Name>
          <com:Description xml:lang="en">A value for a variable that refers to a one-period delay of that variable relative to its current value.</com:Description>
        </str:Code>
        <str:Code id="60MA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).60MA">
          <com:Name xml:lang="en">60-day moving average</com:Name>
          <com:Description xml:lang="en">A statistical measure that smooths time-series data by calculating the average of a variable over the most recent 60 days, updating the average each day.</com:Description>
        </str:Code>
        <str:Code id="60MMA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).60MMA">
          <com:Name xml:lang="en">60-month moving average</com:Name>
          <com:Description xml:lang="en">An average of a variable over the most recent 60 months, updating the average each month to track long-term trends.</com:Description>
        </str:Code>
        <str:Code id="RT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_STATISTICAL_MEASURES(1.7.0).RT">
          <com:Name xml:lang="en">Rate</com:Name>
          <com:Description xml:lang="en">A measure that expresses the frequency of occurrence of an event or phenomenon in relation to another quantity.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_ORGANIZATION(2.11.0)" agencyID="IMF" id="CL_ORGANIZATION" version="2.11.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Organization</com:Name>
        <com:Description xml:lang="en">This codelist identifies and categorizes institutions relevant to economic, financial, and statistical data, providing standardized codes and corresponding names. It includes international organizations, central banks, and government institutions involved in data collection and dissemination.</com:Description>
        <str:Code id="_Z" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ORGANIZATION(2.11.0)._Z">
          <com:Name xml:lang="en">Not applicable</com:Name>
        </str:Code>
