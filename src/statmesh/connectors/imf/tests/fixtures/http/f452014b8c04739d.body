        </str:Code>
        <str:Code id="ETO" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DEPARTMENT(1.0.2).ETO">
          <com:Name xml:lang="ar">مكتب الأخلاقيات (ETO)</com:Name>
          <com:Name xml:lang="ru">Бюро по этике (ETO)</com:Name>
