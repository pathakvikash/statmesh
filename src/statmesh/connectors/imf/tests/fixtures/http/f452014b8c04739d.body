        </str:Code>
        <str:Code id="ACERD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ORGANIZATION(2.11.0).ACERD">
          <com:Name xml:lang="en">Ateneo Center for Economic Research and Development</com:Name>
          <com:Description xml:lang="en">https://www.ateneo.edu/</com:Description>
        </str:Code>
        <str:Code id="CAN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ORGANIZATION(2.11.0).CAN">
