      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_ACCOUNTING_ENTRY(2.2.2)" agencyID="IMF" id="CL_ACCOUNTING_ENTRY" version="2.2.2" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Accounting Entry</com:Name>
        <com:Description xml:lang="en">This codelist identifies whether a transaction represents a use of resources, a source of funds, an asset, a liability, or a change in equity.</com:Description>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">The sum of all relevant components or categories.</com:Description>
        </str:Code>
        <str:Code id="_X" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2)._X">
          <com:Name xml:lang="en">Not allocated/unspecified</com:Name>
          <com:Description xml:lang="en">Not specified or detailed.</com:Description>
        </str:Code>
        <str:Code id="_Z" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2)._Z">
          <com:Name xml:lang="en">Not applicable</com:Name>
          <com:Description xml:lang="en">Not applicable or relevant in the given context.</com:Description>
        </str:Code>
        <str:Code id="A" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2).A">
          <com:Name xml:lang="en">Assets</com:Name>
          <com:Description xml:lang="en">Assets is store of value, over which ownership rights are enforced and from which their owners may derive economic benefits by holding them over a period of time (2016 MFSMCG glossary).</com:Description>
        </str:Code>
        <str:Code id="ACO" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2).ACO">
          <com:Name xml:lang="en">Assets, Claims on</com:Name>
          <com:Description xml:lang="en">Assets, Claims on</com:Description>
        </str:Code>
        <str:Code id="ACOCT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2).ACOCT">
          <com:Name xml:lang="en">Assets, Claims on, Credit to</com:Name>
          <com:Description xml:lang="en">Assets, Claims on, Credit to</com:Description>
        </str:Code>
        <str:Code id="ACOOCO" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2).ACOOCO">
          <com:Name xml:lang="en">Assets, Claims on, Other claims on</com:Name>
          <com:Description xml:lang="en">Assets, Claims on, Other claims on</com:Description>
        </str:Code>
        <str:Code id="AD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2).AD">
          <com:Name xml:lang="en">Gross sales of assets (decrease)</com:Name>
          <com:Description xml:lang="en">The total value of asset sales, representing a decrease in asset holdings.</com:Description>
        </str:Code>
        <str:Code id="AG" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2).AG">
          <com:Name xml:lang="en">Assets (gross)</com:Name>
          <com:Description xml:lang="en">Gross assets refer to the total value of all assets owned or held by an individual, organization, or entity before accounting for any deductions, such as depreciation or liabilities</com:Description>
        </str:Code>
        <str:Code id="AI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2).AI">
          <com:Name xml:lang="en">Gross acquisition of assets (increase)</com:Name>
          <com:Description xml:lang="en">The total value of assets acquired, representing an increase in asset holdings.</com:Description>
        </str:Code>
        <str:Code id="EN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCOUNTING_ENTRY(2.2.2).EN">
          <com:Name xml:lang="en">Environment to economy</com:Name>
          <com:Description xml:lang="en">Financial flows or impacts from environmental resources or activities to the economy.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_COICOP_2018(1.0.1)" agencyID="IMF" id="CL_COICOP_2018" version="1.0.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">COICOP 2018</com:Name>
        <com:Description xml:lang="en">This codelist represents an updated and expanded version of the COICOP classification system, designed to better reflect the evolving consumption patterns of the 21st century. It includes 14 divisions, 50 groups, 153 classes, and 449 subclasses.</com:Description>
        <str:Code id="CP01" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP01">
          <com:Name xml:lang="en">Food and non-alcoholic beverages</com:Name>
          <com:Description xml:lang="en">Expenditures on food items intended for human consumption, excluding alcoholic beverages.</com:Description>
        </str:Code>
        <str:Code id="CP02" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP02">
          <com:Name xml:lang="en">Alcoholic beverages, tobacco and narcotics</com:Name>
          <com:Description xml:lang="en">Expenditures on alcoholic beverages, tobacco products, and narcotic substances.</com:Description>
        </str:Code>
        <str:Code id="CP03" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP03">
          <com:Name xml:lang="en">Clothing and footwear</com:Name>
          <com:Description xml:lang="en">Expenditures on garments, footwear, and accessories for personal use.</com:Description>
        </str:Code>
        <str:Code id="CP04" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP04">
          <com:Name xml:lang="en">Housing, water, electricity, gas and other fuels</com:Name>
          <com:Description xml:lang="en">Expenses related to housing, including rent, mortgage payments, utilities (water, electricity, gas), and fuels for heating.</com:Description>
        </str:Code>
        <str:Code id="CP05" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP05">
          <com:Name xml:lang="en">Furnishings, household equipment and routine household maintenance</com:Name>
          <com:Description xml:lang="en">Expenditures on furniture, appliances, household tools, and routine maintenance and repair services for the home.</com:Description>
        </str:Code>
        <str:Code id="CP06" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP06">
          <com:Name xml:lang="en">Health</com:Name>
          <com:Description xml:lang="en">Expenses related to medical and paramedical services, therapeutic appliances, and pharmaceutical products.</com:Description>
        </str:Code>
        <str:Code id="CP07" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP07">
          <com:Name xml:lang="en">Transport</com:Name>
          <com:Description xml:lang="en">Expenditures on transportation services, including public transport fares, vehicle purchases, and fuel costs.</com:Description>
        </str:Code>
        <str:Code id="CP08" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP08">
          <com:Name xml:lang="en">Information and communication</com:Name>
          <com:Description xml:lang="en">Spending on communication devices, internet access, postal services, and other information and communication technologies.</com:Description>
        </str:Code>
        <str:Code id="CP09" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP09">
          <com:Name xml:lang="en">Recreation, sport and culture</com:Name>
          <com:Description xml:lang="en">Expenses on recreational activities, sports events, cultural events, hobbies, and leisure equipment.</com:Description>
        </str:Code>
        <str:Code id="CP10" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1).CP10">
          <com:Name xml:lang="en">Education services</com:Name>
          <com:Description xml:lang="en">Payments for educational services at all levels, including tuition fees.</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_2018(1.0.1)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">The total sum of all individual consumption expenditures across all categories.</com:Description>
        </str:Code>
      </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_COUNTRY(1.6.0)" agencyID="IMF" id="CL_COUNTRY" version="1.6.0" isFinal="true" isExternalReference="false" isPartial="false">
