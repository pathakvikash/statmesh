      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF.STA:CL_CPI_TYPE_OF_TRANSFORMATION(5.0.0)" agencyID="IMF.STA" id="CL_CPI_TYPE_OF_TRANSFORMATION" version="5.0.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Consumer Price Index (CPI) Type of Transformation</com:Name>
        <str:Code id="IX" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF.STA:CL_CPI_TYPE_OF_TRANSFORMATION(5.0.0).IX">
          <com:Name xml:lang="en">Index</com:Name>
          <com:Description xml:lang="en">A statistical measure that expresses the relative change in a variable in the current period compared to the index reference period.</com:Description>
        </str:Code>
        <str:Code id="POP_PCH_PA_PT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF.STA:CL_CPI_TYPE_OF_TRANSFORMATION(5.0.0).POP_PCH_PA_PT">
          <com:Name xml:lang="en">Period average, Period-over-period percent change</com:Name>
          <com:Description xml:lang="en">Average percentage change of the data series over a defined period. A ratio expressed as a fraction of 100.</com:Description>
        </str:Code>
        <str:Code id="YOY_PCH_PA_PT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF.STA:CL_CPI_TYPE_OF_TRANSFORMATION(5.0.0).YOY_PCH_PA_PT">
          <com:Name xml:lang="en">Period average, Year-over-year (YOY) percent change</com:Name>
          <com:Description xml:lang="en">The percentage change over two consecutive years in the average value of an index for the current period compared to the previous period. This provides a measure of how the average relative value (compared to the base period) has changed over two consecutive periods. A ratio expressed as a fraction of 100.</com:Description>
        </str:Code>
        <str:Code id="WGT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF.STA:CL_CPI_TYPE_OF_TRANSFORMATION(5.0.0).WGT">
          <com:Name xml:lang="en">Weight</com:Name>
          <com:Description xml:lang="en">Weight refers to a numerical value assigned to each observation in a dataset to adjust its relative importance in calculations.</com:Description>
        </str:Code>
        <str:Code id="WGT_PT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF.STA:CL_CPI_TYPE_OF_TRANSFORMATION(5.0.0).WGT_PT">
          <com:Name xml:lang="en">Weight, Percent</com:Name>
          <com:Description xml:lang="en">Weight refers to a numerical value assigned to each observation in a dataset to adjust its relative importance in calculations. A ratio expressed as a fraction of 100.</com:Description>
        </str:Code>
        <str:Code id="SRP_IX" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF.STA:CL_CPI_TYPE_OF_TRANSFORMATION(5.0.0).SRP_IX">
          <com:Name xml:lang="en">Standard reference period (2010=100), Index</com:Name>
          <com:Description xml:lang="en">Standard Reference Period (SRP) is a consistent timeframe used for comparing data over time. A statistical measure that expresses the relative change in a variable in the current period compared to the index reference period.</com:Description>
        </str:Code>
        <str:Code id="SRP_POP_PCH_PA_PT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF.STA:CL_CPI_TYPE_OF_TRANSFORMATION(5.0.0).SRP_POP_PCH_PA_PT">
          <com:Name xml:lang="en">Standard reference period (2010=100), Period average, Period-over-period percent change</com:Name>
          <com:Description xml:lang="en">Standard Reference Period (SRP) is a consistent timeframe used for comparing data over time. Average percentage change of the data series over a defined period. A ratio expressed as a fraction of 100.</com:Description>
        </str:Code>
        <str:Code id="SRP_YOY_PCH_PA_PT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF.STA:CL_CPI_TYPE_OF_TRANSFORMATION(5.0.0).SRP_YOY_PCH_PA_PT">
          <com:Name xml:lang="en">Standard reference period (2010=100), Period average, Year-over-year (YOY) percent change</com:Name>
          <com:Description xml:lang="en">Standard Reference Period (SRP) is a consistent timeframe used for comparing data over time. The percentage change over two consecutive years in the average value of an index for the current period compared to the previous period. This provides a measure of how the average relative value (compared to the base period) has changed over two consecutive periods. A ratio expressed as a fraction of 100.</com:Description>
        </str:Code>
      </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_COICOP_1999(1.1.1)" agencyID="IMF" id="CL_COICOP_1999" version="1.1.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">COICOP 1999</com:Name>
        <com:Description xml:lang="en">This codelist represents a standardized classification system developed by the United Nations Statistics Division to categorize household consumption expenditures by purpose. It includes 14 divisions, 47 groups, and 117 classes.</com:Description>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1)._T">
          <com:Name xml:lang="en">All Items</com:Name>
          <com:Description xml:lang="en">All items in the context of the consumer price index indicates that the index includes prices for all items included in the consumer price index basket.  This includes prices related to food, beverages, clothing, housing, health, transport, communications, recreation, education, restaurants and hotels and other miscellanoues goods and services.</com:Description>
        </str:Code>
        <str:Code id="CP01" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1).CP01">
          <com:Name xml:lang="en">Food and non-alcoholic beverages</com:Name>
          <com:Description xml:lang="en">Food and non-alcoholic beverages consumer price index is produced using prices related to food items and non-alcoholic beverages such as fresh produce, packaged foods, and beverages excluding alcoholic drinks, aggregated by their respective consumer expenditure weights.</com:Description>
        </str:Code>
        <str:Code id="CP02" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1).CP02">
          <com:Name xml:lang="en">Alcoholic beverages, tobacco and narcotics</com:Name>
          <com:Description xml:lang="en">Alcoholic beverages, tobacco and narcotics consumer price index is produced using prices related to items such as beer, wine, spirits, cigarettes, tobacco products, and illicit drugs, aggregated by their respective consumer expenditure weights.</com:Description>
        </str:Code>
        <str:Code id="CP03" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1).CP03">
          <com:Name xml:lang="en">Clothing and footwear</com:Name>
          <com:Description xml:lang="en">Clothing and footwear consumer price index is produced using prices related to items such as apparel, footwear, accessories, and related products, aggregated by their respective consumer expenditure weights.</com:Description>
        </str:Code>
        <str:Code id="CP04" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1).CP04">
          <com:Name xml:lang="en">Housing, water, electricity, gas and other fuels</com:Name>
          <com:Description xml:lang="en">Housing, water, electricity, gas and other fuels consumer price index is produced using prices related to items such as housing-related services, including rent or mortgage payments, utilities such as water, electricity, gas, and other fuels, aggregated by their respective consumer expenditure weights.</com:Description>
        </str:Code>
        <str:Code id="CP05" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1).CP05">
          <com:Name xml:lang="en">Furnishings, household equipment and routine household maintenance</com:Name>
          <com:Description xml:lang="en">Furnishings, household equipment and routine household maintenance consumer price index is produced using prices related to items such as furniture, appliances, household supplies, and maintenance services, aggregated by their respective consumer expenditure weights.</com:Description>
        </str:Code>
        <str:Code id="CP06" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1).CP06">
          <com:Name xml:lang="en">Health</com:Name>
          <com:Description xml:lang="en">Health consumer price index is produced using prices related to items such as health-related products, including medical services, pharmaceuticals and healthcare products, aggregated by their respective consumer expenditure weights.</com:Description>
        </str:Code>
        <str:Code id="CP07" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1).CP07">
          <com:Name xml:lang="en">Transport</com:Name>
          <com:Description xml:lang="en">Transport consumer price index is produced using prices related to items such as transportation-related services, including vehicle purchases, fuel, public transportation fares, vehicle maintenance, and transportation services, aggregated by their respective consumer expenditure weights.</com:Description>
        </str:Code>
        <str:Code id="CP08" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1).CP08">
          <com:Name xml:lang="en">Communication</com:Name>
          <com:Description xml:lang="en">Communication consumer price index is produced using prices related to items such as communication-related services, including telephone services, internet subscriptions, postal services, and communication equipment, aggregated by their respective consumer expenditure weights.</com:Description>
        </str:Code>
        <str:Code id="CP09" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COICOP_1999(1.1.1).CP09">
          <com:Name xml:lang="en">Recreation and culture</com:Name>
          <com:Description xml:lang="en">Recreation and culture consumer price index is produced using prices related to items such as recreational and cultural activities, including leisure pursuits, entertainment, hobbies, cultural events, and recreational goods and services, aggregated by their respective consumer expenditure weights.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_INSTR_ASSET(2.15.2)" agencyID="IMF" id="CL_INSTR_ASSET" version="2.15.2" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Instrument and assets classification</com:Name>
        <com:Description xml:lang="en">Because of the symmetry of financial assets and liabilities, the term ‘instrument’ is used to relate to both the asset and the liability aspect of financial transactions, other flows and financial balance sheets.  (Source: Handbook of National Accounting, 2013)</com:Description>
        <str:Code id="_Z" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2)._Z">
          <com:Name xml:lang="en">Not applicable</com:Name>
          <com:Description xml:lang="en">Not relevant or not suitable to the context.</com:Description>
        </str:Code>
        <str:Code id="6M2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2).6M2">
          <com:Name xml:lang="en">Net financial worth</com:Name>
          <com:Description xml:lang="en">The difference between total financial assets and total financial liabilities.</com:Description>
        </str:Code>
        <str:Code id="6M2XPL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2).6M2XPL">
          <com:Name xml:lang="en">Net financial worth: excluding pension liabilities</com:Name>
          <com:Description xml:lang="en">The difference between total financial assets and total financial liabilities, excluding pension liabilities.</com:Description>
        </str:Code>
        <str:Code id="A" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2).A">
          <com:Name xml:lang="en">Financial assets</com:Name>
          <com:Description xml:lang="en">Economic resources owned by an entity that can provide future benefits.</com:Description>
        </str:Code>
        <str:Code id="AFA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2).AFA">
          <com:Name xml:lang="en">Acquisition of foreign assets</com:Name>
          <com:Description xml:lang="en">The purchase or acquisition of financial or non-financial assets located in foreign countries.</com:Description>
        </str:Code>
        <str:Code id="AG" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2).AG">
          <com:Name xml:lang="en">Total assets (gross)</com:Name>
          <com:Description xml:lang="en">The total value of all economic resources owned by an entity, before deducting any liabilities or depreciation. This includes both financial and non-financial assets.</com:Description>
        </str:Code>
        <str:Code id="AS" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2).AS">
          <com:Name xml:lang="en">Assets: short position</com:Name>
          <com:Description xml:lang="en">A position in financial markets where the value of assets sold exceeds the value of assets owned.</com:Description>
        </str:Code>
        <str:Code id="AXLNR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2).AXLNR">
          <com:Name xml:lang="en">Assets excluding land and natural resources</com:Name>
          <com:Description xml:lang="en">Economic resources owned by an entity, excluding land and natural resources.</com:Description>
        </str:Code>
        <str:Code id="B" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2).B">
          <com:Name xml:lang="en">Liabilities or debt to banks</com:Name>
          <com:Description xml:lang="en">Financial obligations owed to banking institutions.</com:Description>
        </str:Code>
        <str:Code id="BRASS" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2).BRASS">
          <com:Name xml:lang="en">Stock of reserves</com:Name>
          <com:Description xml:lang="en">The total amount of reserve assets held by a central bank or monetary authority. These assets typically include monetary gold, Special Drawing Rights (SDRs), foreign currency holdings, and reserve positions in the IMF.</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INSTR_ASSET(2.15.2)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">The sum of all relevant components or categories.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_INDEX_TYPE(2.6.0)" agencyID="IMF" id="CL_INDEX_TYPE" version="2.6.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Index type</com:Name>
        <com:Description xml:lang="en">This codelist represents different types of price indices and related measures.</com:Description>
        <str:Code id="BSI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).BSI">
          <com:Name xml:lang="en">Bank stock index</com:Name>
          <com:Description xml:lang="en">A financial index that tracks the performance of a basket of stocks issued by banking institutions. This index provides insights into the health and performance of the banking sector, reflecting changes in stock prices of banks in response to economic, regulatory, and market conditions.</com:Description>
        </str:Code>
        <str:Code id="CCPI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).CCPI">
          <com:Name xml:lang="en">Core consumer price index (CPI)</com:Name>
          <com:Description xml:lang="en">A measure of the price level of consumer goods and services, excluding volatile items such as food and energy.</com:Description>
        </str:Code>
        <str:Code id="CCPISVN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).CCPISVN">
          <com:Name xml:lang="en">Core consumer price index (CCPI) (SVN)</com:Name>
        </str:Code>
        <str:Code id="CECO" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).CECO">
          <com:Name xml:lang="en">Commodity price index, energy, crude oil (petroleum)</com:Name>
          <com:Description xml:lang="en">The Commodity Price Index for energy, crude oil (petroleum) is a measure that tracks the average price changes of crude oil over time.</com:Description>
        </str:Code>
        <str:Code id="CEMPI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).CEMPI">
          <com:Name xml:lang="en">Commodity net export price index</com:Name>
          <com:Description xml:lang="en">Represents the difference in the trends of export and import price indices for commodities. It is calculated by subtracting the Commodity Import Price Index from the Commodity Export Price Index. A positive value indicates that the prices of exports are increasing at a faster rate than the prices of imports, potentially leading to a favorable trade balance and contributing to economic growth.</com:Description>
        </str:Code>
        <str:Code id="CEPI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).CEPI">
          <com:Name xml:lang="en">Commodity export price index</com:Name>
          <com:Description xml:lang="en">A measure that tracks the changes over time in the prices of a basket of goods exported by a country. This index provides insight into the trends of export prices for commodities such as oil, metals, and agricultural products. An increase in the index suggests that the prices of exported commodities are rising, potentially leading to higher revenues for exporters.</com:Description>
        </str:Code>
        <str:Code id="CHICPIF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).CHICPIF">
          <com:Name xml:lang="en">Core HICP inflation forecast</com:Name>
          <com:Description xml:lang="en">The Core Harmonised Index of Consumer Prices (HICP) Inflation Forecast predicts the future rate of inflation, excluding volatile items such as energy, food, alcohol, and tobacco. This forecast helps in assessing underlying inflation trends and is crucial for monetary policy decisions and economic planning.</com:Description>
        </str:Code>
        <str:Code id="CMPI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).CMPI">
          <com:Name xml:lang="en">Commodity import price index</com:Name>
          <com:Description xml:lang="en">This index measures the changes in the prices of a basket of goods imported into a country over time. It reflects the cost trends of imported commodities, including energy sources, raw materials, and food products. A higher index indicates increasing import prices, which may affect domestic inflation rates and the purchasing power of consumers, as well as impact the costs for businesses relying on imported goods.</com:Description>
        </str:Code>
        <str:Code id="CPCE" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).CPCE">
          <com:Name xml:lang="en">Core PCE Price Index</com:Name>
          <com:Description xml:lang="en">The Core Personal Consumption Expenditures (PCE) Price Index is a measure of inflation that tracks changes in the prices of goods and services purchased by consumers, excluding food and energy prices.</com:Description>
        </str:Code>
        <str:Code id="CPI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_INDEX_TYPE(2.6.0).CPI">
          <com:Name xml:lang="en">Consumer price index (CPI)</com:Name>
          <com:Description xml:lang="en">The Consumer Price Index (CPI) is an index of the prices of consumption goods and services, as compared to a certain reference period.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_CURRENCY(2.3.0)" agencyID="IMF" id="CL_CURRENCY" version="2.3.0" isFinal="true" isExternalReference="false" isPartial="false">
