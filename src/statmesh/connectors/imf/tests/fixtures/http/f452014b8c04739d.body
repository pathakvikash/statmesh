          <com:Name xml:lang="fr">Département Asie et Pacifique (APD)</com:Name>
          <com:Name xml:lang="es">Departamento de Asia y el Pacífico (APD)</com:Name>
          <com:Name xml:lang="zh">亚洲和太平洋部 (Yàzhōu hé Tàipíngyáng Bù)</com:Name>
        </str:Code>
        <str:Code id="COM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DEPARTMENT(1.0.2).COM">
          <com:Name xml:lang="ar">إدارة الاتصالات (COM)</com:Name>
