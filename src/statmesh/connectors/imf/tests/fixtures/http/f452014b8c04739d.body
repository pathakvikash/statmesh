      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_FSENTRY(2.2.0)" agencyID="IMF" id="CL_FSENTRY" version="2.2.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Flow or stock entry</com:Name>
        <com:Description xml:lang="en">A classification that indicates whether a data point represents a flow (a quantity measured over a period of time) or a stock (a quantity measured at a specific point in time).</com:Description>
        <str:Code id="_Z" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0)._Z">
          <com:Name xml:lang="en">Not applicable</com:Name>
          <com:Description xml:lang="en">A term used when a particular concept or data item does not apply to the context in question.</com:Description>
        </str:Code>
        <str:Code id="BALANCES" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0).BALANCES">
          <com:Name xml:lang="en">Balancing items</com:Name>
          <com:Description xml:lang="en">Accounting constructs used to ensure that the accounts balance, representing the difference between total sources and uses.</com:Description>
        </str:Code>
        <str:Code id="CHGAL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0).CHGAL">
          <com:Name xml:lang="en">Holding gains in assets and liabilities</com:Name>
          <com:Description xml:lang="en">Categorization of gains in the value of assets and liabilities due to price changes.</com:Description>
        </str:Code>
        <str:Code id="CHGALA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0).CHGALA">
          <com:Name xml:lang="en">Holding gains in assets</com:Name>
          <com:Description xml:lang="en">Categorization of gains in the value of assetsdue to price changes.</com:Description>
        </str:Code>
        <str:Code id="CHGALL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0).CHGALL">
          <com:Name xml:lang="en">Holding gains in liabilities</com:Name>
          <com:Description xml:lang="en">Categorization of gains in the value of liabilities due to price changes.</com:Description>
        </str:Code>
        <str:Code id="COCVAL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0).COCVAL">
          <com:Name xml:lang="en">Other changes in the volume of assets and liabilities</com:Name>
          <com:Description xml:lang="en">Categorization of changes in the volume of assets and liabilities due to factors other than transactions and revaluations.</com:Description>
        </str:Code>
        <str:Code id="COCVALA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0).COCVALA">
          <com:Name xml:lang="en">Other changes in the volume of assets</com:Name>
          <com:Description xml:lang="en">Categorization of changes in the volume of assets due to factors other than transactions and revaluations.</com:Description>
        </str:Code>
        <str:Code id="COCVALL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0).COCVALL">
          <com:Name xml:lang="en">Other changes in the volume of liabilities</com:Name>
          <com:Description xml:lang="en">Categorization of changes in the volume of liabilities due to factors other than transactions and revaluations.</com:Description>
        </str:Code>
        <str:Code id="COEFAL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0).COEFAL">
          <com:Name xml:lang="en">Other economic flows (holding gains + other changes in volume) in assets and liabilities</com:Name>
          <com:Description xml:lang="en">Organizing and categorizing all non-transactional changes in the value and volume of assets and liabilities.</com:Description>
        </str:Code>
        <str:Code id="COEFALA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0).COEFALA">
          <com:Name xml:lang="en">Other economic flows (holding gains + other changes in volume) in assets</com:Name>
          <com:Description xml:lang="en">Organizing and categorizing all non-transactional changes in the value and volume of assets.</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FSENTRY(2.2.0)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">The sum of all relevant components or categories.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_CLASSIFICATION_TYPE(1.0.1)" agencyID="IMF" id="CL_CLASSIFICATION_TYPE" version="1.0.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Standard Classification Type</com:Name>
        <com:Description xml:lang="en">This codelist identifies the standardized classification systems used for categorizing and organizing data within a resource. Examples include industry classifications, product classifications, or occupational classifications.</com:Description>
        <str:Code id="CP18" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).CP18">
          <com:Name xml:lang="en">Classification of Individual Consumption According to Purpose (COICOP) 2018</com:Name>
          <com:Description xml:lang="en">https://unstats.un.org/unsd/classifications/unsdclassifications/COICOP_2018_-_pre-edited_white_cover_version_-_2018-12-26.pdf</com:Description>
        </str:Code>
        <str:Code id="CP99" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).CP99">
          <com:Name xml:lang="en">Classification of Individual Consumption According to Purpose (COICOP) 1999</com:Name>
          <com:Description xml:lang="en">https://unstats.un.org/unsd/classifications/Econ/Download/In%20Text/CPCprov_english.pdf</com:Description>
        </str:Code>
        <str:Code id="CPC21" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).CPC21">
          <com:Name xml:lang="en">Central Product Classification (CPC)</com:Name>
          <com:Description xml:lang="en">https://unstats.un.org/unsd/classifications/unsdclassifications/cpcv21.pdf</com:Description>
        </str:Code>
        <str:Code id="CPA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).CPA">
          <com:Name xml:lang="en">Statistical classification of products by activity (CPA) 2008</com:Name>
          <com:Description xml:lang="en">https://ec.europa.eu/eurostat/ramon/nomenclatures/index.cfm?TargetUrl=LST_NOM_DTL&amp;StrNom=CPA_2008&amp;StrLanguageCode=EN&amp;IntPcKey=&amp;StrLayoutCode=HIERARCHIC</com:Description>
        </str:Code>
        <str:Code id="ISIC3" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).ISIC3">
          <com:Name xml:lang="en">International Standard Industrial Classification of All Economic Activities, Rev. 3 (ISIC Rev. 3)</com:Name>
          <com:Description xml:lang="en">https://unstats.un.org/unsd/classifications/Econ/ISIC.cshtml</com:Description>
        </str:Code>
        <str:Code id="ISIC31" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).ISIC31">
          <com:Name xml:lang="en">International Standard Industrial Classification of All Economic Activities, Rev. 3.1 (ISIC Rev. 3.1) 2004</com:Name>
          <com:Description xml:lang="en">https://unstats.un.org/unsd/classifications/Econ/ISIC.cshtml</com:Description>
        </str:Code>
        <str:Code id="ISIC4" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).ISIC4">
          <com:Name xml:lang="en">International Standard Industrial Classification of All Economic Activities, Rev. 4 (ISIC Rev. 4) 2008</com:Name>
          <com:Description xml:lang="en">https://unstats.un.org/unsd/classifications/Econ/ISIC.cshtml</com:Description>
        </str:Code>
        <str:Code id="NACE2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).NACE2">
          <com:Name xml:lang="en">Statistical Classification of Economic Activities in the European Community, Rev. 2 (NACE Rev. 2) 2008</com:Name>
          <com:Description xml:lang="en">https://ec.europa.eu/eurostat/documents/3859598/5902521/KS-RA-07-015-EN.PDF
https://ec.europa.eu/eurostat/ramon/nomenclatures/index.cfm?TargetUrl=LST_NOM_DTL&amp;StrNom=NACE_REV2&amp;StrLanguageCode=EN</com:Description>
        </str:Code>
        <str:Code id="SITC4" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).SITC4">
          <com:Name xml:lang="en">Standard International Trade Classification, Rev. 4 (SITC Rev. 4) 2007</com:Name>
          <com:Description xml:lang="en">https://unstats.un.org/unsd/publications/catalogue?selectID=104</com:Description>
        </str:Code>
        <str:Code id="H5" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_CLASSIFICATION_TYPE(1.0.1).H5">
          <com:Name xml:lang="en">Harmonized Commodity Description and Coding Systems (HS), Rev. 5</com:Name>
          <com:Description xml:lang="en">https://unstats.un.org/unsd/tradekb/Knowledgebase/50018/Harmonized-Commodity-Description-and-Coding-Systems-HS</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_COFOG(2.0.0)" agencyID="IMF" id="CL_COFOG" version="2.0.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">COFOG</com:Name>
        <com:Description xml:lang="en">This codelist represents the Classification of the Functions of Government (COFOG) 1999, a standardized system for classifying government expenditures by their purpose.</com:Description>
        <str:Code id="GF0490" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0490">
          <com:Name xml:lang="en">Economic affairs n.e.c. (CS)</com:Name>
          <com:Description xml:lang="en">Economic affairs expenditures that do not fit into other specific categories.</com:Description>
          </str:Code>
        <str:Code id="GF0481" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0481">
          <com:Name xml:lang="en">R&amp;D General economic, commercial and labour affairs (CS)</com:Name>
          <com:Description xml:lang="en">Government spending on research and development related to general economic issues, commerce, and labor markets.</com:Description>
          </str:Code>
        <str:Code id="GF0482" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0482">
          <com:Name xml:lang="en">R&amp;D Agriculture, forestry, fishing and hunting (CS)</com:Name>
          <com:Description xml:lang="en">Government spending on research and development related to agriculture, forestry, fishing, and hunting.</com:Description>
          </str:Code>
        <str:Code id="GF0483" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0483">
          <com:Name xml:lang="en">R&amp;D Fuel and energy (CS)</com:Name>
          <com:Description xml:lang="en">Government spending on research and development related to energy production, distribution, and efficiency.</com:Description>
          </str:Code>
        <str:Code id="GF0484" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0484">
          <com:Name xml:lang="en">R&amp;D Mining, manufacturing and construction (CS)</com:Name>
          <com:Description xml:lang="en">Government spending on research and development related to the mining, manufacturing, and construction industries.</com:Description>
          </str:Code>
        <str:Code id="GF0485" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0485">
          <com:Name xml:lang="en">R&amp;D Transport (CS)</com:Name>
          <com:Description xml:lang="en">Government spending on research and development related to transportation technologies and infrastructure.</com:Description>
          </str:Code>
        <str:Code id="GF0486" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0486">
          <com:Name xml:lang="en">R&amp;D Communication (CS)</com:Name>
          <com:Description xml:lang="en">Government spending on research and development related to communication technologies and infrastructure.</com:Description>
          </str:Code>
        <str:Code id="GF0487" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0487">
          <com:Name xml:lang="en">R&amp;D Other industries (CS)</com:Name>
          <com:Description xml:lang="en">Government spending on research and development related to industries not categorized elsewhere.</com:Description>
          </str:Code>
        <str:Code id="GF0471" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0471">
          <com:Name xml:lang="en">Distributive trades, storage and warehousing (CS)</com:Name>
          <com:Description xml:lang="en">Government support for wholesale and retail trade, logistics, and warehousing, including infrastructure development and regulation.</com:Description>
          </str:Code>
        <str:Code id="GF0472" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0).GF0472">
          <com:Name xml:lang="en">Hotels and restaurants (CS)</com:Name>
          <com:Description xml:lang="en">Government support for the hospitality industry, including hotels, restaurants, and tourism.</com:Description>
          </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_COFOG(2.0.0)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">The sum of all government current and capital expenditures across all COFOG categories.</com:Description>
        </str:Code>
      </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_SEC_CLASSIFICATION(1.0.1)" agencyID="IMF" id="CL_SEC_CLASSIFICATION" version="1.0.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Security Classification</com:Name>
        <com:Description xml:lang="en">This codelist designates the level of sensitivity or confidentiality associated with data, dictating the protective measures required for its handling, storage, and transmission.</com:Description>
        <str:Code id="PUB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEC_CLASSIFICATION(1.0.1).PUB">
          <com:Name xml:lang="en">Public or Unrestricted</com:Name>
          <com:Description xml:lang="en">Information that has been published in full by the Fund and has been approved to be made available inside and outside the Fund without restriction is “Public” or “Unclassified.”</com:Description>
        </str:Code>
        <str:Code id="FOU" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEC_CLASSIFICATION(1.0.1).FOU">
          <com:Name xml:lang="en">For official use only</com:Name>
          <com:Description xml:lang="en">Information that is intended for all staff, without restriction, and in some cases, may be shared with national officials or other authorized individuals or institutions must be classified “For Official Use Only.” This may be information not authorized for public use but to which staff members may have access without demonstrating a particular direct interest in the matter in question. Such information must be marked accordingly when necessary to avoid being mistaken for unclassified information.</com:Description>
        </str:Code>
        <str:Code id="C" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEC_CLASSIFICATION(1.0.1).C">
          <com:Name xml:lang="en">Confidential</com:Name>
          <com:Description xml:lang="en">Information that is sensitive and to which access needs to be confined to those with a need to know about the matter in question must be classified “Confidential.” Given the desirability of broad dissemination of information within the Fund and of simplicity in the design of information handling systems, this classification should be used sparingly.</com:Description>
        </str:Code>
        <str:Code id="SC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEC_CLASSIFICATION(1.0.1).SC">
          <com:Name xml:lang="en">Strictly Confidential</com:Name>
          <com:Description xml:lang="en">Information to which access is to be limited to those having a strict need to know and which would not be adequately protected by the Confidential classification shall be classified “Strictly Confidential.” The classification “Strictly Confidential” should be used only exceptionally for information of the highest sensitivity. For example, Crown Jewels information must be classified as Strictly Confidential.</com:Description>
        </str:Code>
        <str:Code id="PC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEC_CLASSIFICATION(1.0.1).PC">
          <com:Name xml:lang="en">Personal and Confidential</com:Name>
          <com:Description xml:lang="en">Information that is both "Personal" and "Confidential."  Information that is sensitive and to which access needs to be confined to those with a need to know about the matter in question must be classified “Confidential.” Given the desirability of broad dissemination of information within the Fund and of simplicity in the design of information handling systems, this classification should be used sparingly.</com:Description>
        </str:Code>
        <str:Code id="PSC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEC_CLASSIFICATION(1.0.1).PSC">
          <com:Name xml:lang="en">Personal and Strictly Confidential</com:Name>
          <com:Description xml:lang="en">Information that is both "Personal" and "Strictly Confidential."  Information to which access is to be limited to those having a strict need to know and which would not be adequately protected by the Confidential classification shall be classified “Strictly Confidential.” The classification “Strictly Confidential” should be used only exceptionally for information of the highest sensitivity. </com:Description>
        </str:Code>
      </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_GFS_STO(2.9.1)" agencyID="IMF" id="CL_GFS_STO" version="2.9.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">GFS Stocks, Transactions, Other Flows</com:Name>
        <com:Description xml:lang="en">A classification of data items used in the Government Finance Statistics (GFS) framework, distinguishing between stocks (levels at a point in time), transactions (changes over a period), and other flows.</com:Description>
        <str:Code id="_Z" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1)._Z">
          <com:Name xml:lang="en">Not applicable</com:Name>
          <com:Description xml:lang="en">A term used to indicate that a specific item or category does not apply in the given context.</com:Description>
        </str:Code>
        <str:Code id="ATPD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1).ATPD">
          <com:Name xml:lang="en">Amortization of total public debt</com:Name>
          <com:Description xml:lang="en">The process of gradually paying off the total public debt through scheduled payments over time. This includes both principal repayments and interest payments on government debt.</com:Description>
        </str:Code>
        <str:Code id="BBAL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1).BBAL">
          <com:Name xml:lang="en">Budget balance</com:Name>
          <com:Description xml:lang="en">The difference between a government's total revenue and total expenditure over a specific period. A positive balance indicates a surplus, while a negative balance indicates a deficit.</com:Description>
        </str:Code>
        <str:Code id="CAB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1).CAB">
          <com:Name xml:lang="en">Cyclically adjusted balance</com:Name>
          <com:Description xml:lang="en">The cyclically adjusted balance is a measure of a government's budget balance that takes into account the effects of the economic cycle. It adjusts the actual budget balance for the impact of cyclical fluctuations in economic activity, such as changes in output, employment, and tax revenues, to provide a clearer picture of the underlying fiscal position. This adjustment helps policymakers assess the structural or underlying fiscal position of the government, independent of temporary fluctuations caused by the economic cycle. A positive cyclically adjusted balance indicates a structural surplus, while a negative cyclically adjusted balance indicates a structural deficit.</com:Description>
        </str:Code>
        <str:Code id="CAPB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1).CAPB">
          <com:Name xml:lang="en">Cyclically adjusted primary balance</com:Name>
          <com:Description xml:lang="en">The cyclically adjusted primary balance is similar to the cyclically adjusted balance but focuses specifically on the primary balance, which excludes interest payments on government debt. It adjusts the primary balance for the effects of the economic cycle to provide a measure of the structural fiscal position of the government, independent of cyclical fluctuations. Like the cyclically adjusted balance, a positive cyclically adjusted primary balance indicates a structural surplus, while a negative cyclically adjusted primary balance indicates a structural deficit.</com:Description>
        </str:Code>
        <str:Code id="CFC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1).CFC">
          <com:Name xml:lang="en">Consumption of fixed capital (CFC): major improvements, nonproduced assets</com:Name>
          <com:Description xml:lang="en">The decline in value of major improvements to nonproduced assets, such as land reclamation or infrastructure development, over time.</com:Description>
        </str:Code>
        <str:Code id="CIO_CA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1).CIO_CA">
          <com:Name xml:lang="en">Net cash inflow from operating activities</com:Name>
          <com:Description xml:lang="en">The net amount of cash generated from the government's regular operational activities, including tax collections and fees, minus operational expenses.</com:Description>
        </str:Code>
        <str:Code id="CIOA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1).CIOA">
          <com:Name xml:lang="en">Cash inflow from operating activities</com:Name>
          <com:Description xml:lang="en">The cash generated by a government's regular operational activities, including tax collections, fees, and other income.</com:Description>
        </str:Code>
        <str:Code id="CIT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1).CIT">
          <com:Name xml:lang="en">Corporate income tax (CIT)</com:Name>
          <com:Description xml:lang="en">A?corporate tax, also called?corporation tax?or?company tax, is a type of direct tax?levied on the income or capital of?corporations?and other similar legal entities. The tax is usually imposed at the national level, but it may also be imposed at state or local levels in some countries. Corporate taxes may be referred to as income tax or capital tax, depending on the nature of the tax.</com:Description>
        </str:Code>
        <str:Code id="CNWSFD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1).CNWSFD">
          <com:Name xml:lang="en">Total changes in net worth, stock-flow discrepancy</com:Name>
          <com:Description xml:lang="en">The difference between total changes in net worth and the stock-flow discrepancy, indicating potential errors or inconsistencies.</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GFS_STO(2.9.1)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">The sum of all relevant components or categories.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_MFS_INSTR(2.7.1)" agencyID="IMF" id="CL_MFS_INSTR" version="2.7.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Monetary and Financial Instruments</com:Name>
        <com:Description xml:lang="en">A classification of financial instruments used in monetary and financial statistics, including currency, deposits, loans, securities, and derivatives.</com:Description>
        <str:Code id="FMB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).FMB">
          <com:Name xml:lang="en">Broad money</com:Name>
          <com:Description xml:lang="en">Broad money is the sum of all liquid financial instruments held by money-holding sectors that are widely accepted in an economy as a medium of exchange, plus those that can be converted into a medium of exchange at short notice at, or close to, their full nominal value (2016 MFSMCG).</com:Description>
        </str:Code>
        <str:Code id="FISISP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).FISISP">
          <com:Name xml:lang="en">Stock market index S&amp;P500</com:Name>
          <com:Description xml:lang="en">The S&amp;P 500 is a stock market index that tracks the performance of 500 of the largest publicly traded companies in the United States, serving as a benchmark for the overall U.S. equity market.</com:Description>
        </str:Code>
        <str:Code id="FISI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).FISI">
          <com:Name xml:lang="en">Benchmark stock market index</com:Name>
          <com:Description xml:lang="en">A benchmark stock market index is a standard measure that tracks the performance of a specific group of stocks, serving as a reference point for evaluating the returns of investment portfolios or the overall market.</com:Description>
        </str:Code>
        <str:Code id="FISI2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).FISI2">
          <com:Name xml:lang="en">Benchmark stock market index, US NASDAQ Stock Composite</com:Name>
          <com:Description xml:lang="en">The NASDAQ Composite is a benchmark U.S. stock market index that tracks the performance of over 3,000 companies listed on the NASDAQ Stock Exchange</com:Description>
        </str:Code>
        <str:Code id="FISI1" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).FISI1">
          <com:Name xml:lang="en">Benchmark stock market index, US Dow Jones 30 Industrial Stocks</com:Name>
          <com:Description xml:lang="en">The Dow Jones Industrial Average (DJIA) is a benchmark U.S. stock market index that tracks the performance of 30 major publicly traded companies across various industries.</com:Description>
        </str:Code>
        <str:Code id="FISIDJ" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).FISIDJ">
          <com:Name xml:lang="en">Stock market index Dow Jones Industrial Average</com:Name>
          <com:Description xml:lang="en">The Dow Jones Industrial Average (DJIA) is a benchmark U.S. stock market index that tracks the performance of 30 major publicly traded companies across various industries.</com:Description>
        </str:Code>
        <str:Code id="ACC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).ACC">
          <com:Name xml:lang="en">Consumer confidence</com:Name>
          <com:Description xml:lang="en">Consumer confidence is an economic indicator that measures the degree of optimism consumers feel about the overall state of the economy and their personal financial situation.</com:Description>
        </str:Code>
        <str:Code id="CTP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).CTP">
          <com:Name xml:lang="en">Credit to the private sector</com:Name>
          <com:Description xml:lang="en">Credit to the private sector refers to the total amount of loans and financial resources provided by financial institutions to households and businesses, excluding government entities.</com:Description>
        </str:Code>
        <str:Code id="MS" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).MS">
          <com:Name xml:lang="en">Money supply</com:Name>
          <com:Description xml:lang="en">Money supply is the total amount of money available in an economy at a specific time; there are different measures of it, in particular broad money defined above.</com:Description>
        </str:Code>
        <str:Code id="MPE" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_MFS_INSTR(2.7.1).MPE">
          <com:Name xml:lang="en">Money policy evaluation, probability of rate change at/before next FOMC meeting</com:Name>
          <com:Description xml:lang="en">Monetary policy evaluation regarding the probability of a rate change at or before the next FOMC meeting involves assessing economic indicators and market expectations to estimate whether the Federal Reserve will adjust interest rates.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0)" agencyID="IMF" id="CL_REPORTING_PERIOD_TYPE" version="1.4.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">REPORTING_PERIOD_TYPE</com:Name>
        <com:Description xml:lang="en">It is used to identify and distinguish between different types of time periods in economic and financial reporting.  The specific start and end dates for a fiscal year (FY) can vary depending on the country, organization, or industry.
When reporting data using this codelist, it is essential to specify the exact start and end dates of the fiscal year being referenced.</com:Description>
        <str:Code id="CY" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).CY">
          <com:Name xml:lang="en">Calendar year</com:Name>
          <com:Description xml:lang="en">A 12-month period starting on January 1st and ending on December 31st.</com:Description>
        </str:Code>
        <str:Code id="FY" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).FY">
          <com:Name xml:lang="en">Fiscal year</com:Name>
          <com:Description xml:lang="en">A 12-month period that a company or government uses for accounting purposes. The fiscal year may or may not align with the calendar year. For example, a company's fiscal year could start on July 1st and end on June 30th of the following year.</com:Description>
        </str:Code>
        <str:Code id="BY" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).BY">
          <com:Name xml:lang="en">Base year</com:Name>
          <com:Description xml:lang="en">The Base Year is a specific year chosen as a reference point for constructing an index or comparing data over time.</com:Description>
        </str:Code>
        <str:Code id="SRP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).SRP">
          <com:Name xml:lang="en">Standard reference period (SRP)</com:Name>
          <com:Description xml:lang="en">Standard Reference Period (SRP) is a consistent timeframe used for comparing data over time.</com:Description>
        </str:Code>
        <str:Code id="SPR_2010" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).SPR_2010">
          <com:Name xml:lang="en">To delete</com:Name>
          <com:Description xml:lang="en">To delete</com:Description>
        </str:Code>
        <str:Code id="SRP_2010" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).SRP_2010">
          <com:Name xml:lang="en">Standard reference period (2010=100)</com:Name>
          <com:Description xml:lang="en">Standard Reference Period (SRP) is a consistent timeframe used for comparing data over time.  This series is references to 2010=100.</com:Description>
        </str:Code>
        <str:Code id="F02" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).F02">
          <com:Name xml:lang="en">Fiscal year starting in February</com:Name>
          <com:Description xml:lang="en">A 12-month period starting in February 1st that a company or government uses for accounting purposes.</com:Description>
        </str:Code>
        <str:Code id="F03" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).F03">
          <com:Name xml:lang="en">Fiscal year starting in March</com:Name>
          <com:Description xml:lang="en">A 12-month period starting in March 1st that a company or government uses for accounting purposes.</com:Description>
        </str:Code>
        <str:Code id="F04" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).F04">
          <com:Name xml:lang="en">Fiscal year starting in April</com:Name>
          <com:Description xml:lang="en">A 12-month period starting in April 1st that a company or government uses for accounting purposes.</com:Description>
        </str:Code>
        <str:Code id="F05" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_REPORTING_PERIOD_TYPE(1.4.0).F05">
          <com:Name xml:lang="en">Fiscal year starting in May</com:Name>
          <com:Description xml:lang="en">A 12-month period starting in May 1st that a company or government uses for accounting purposes.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_SOC_CONCEPTS(1.3.0)" agencyID="IMF" id="CL_SOC_CONCEPTS" version="1.3.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Social Concepts</com:Name>
        <com:Description xml:lang="en">This codelist represents a broad category encompassing various social indicators, such as tourism and labor concepts.</com:Description>
        <str:Code id="E" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).E">
          <com:Name xml:lang="en">Employed persons</com:Name>
          <com:Description xml:lang="en">Persons above the age of 15 who were in paid employment or self-employment during a specified reference period.</com:Description>
        </str:Code>
        <str:Code id="EP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).EP">
          <com:Name xml:lang="en">Employed persons index</com:Name>
          <com:Description xml:lang="en">An index that measures the level of employed persons relative to a base period, providing a quantitative measure of employment trends.</com:Description>
        </str:Code>
        <str:Code id="LF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).LF">
          <com:Name xml:lang="en">Labor force</com:Name>
          <com:Description xml:lang="en">The sum of employed and unemployed persons in an economy, actively participating in the labor market.</com:Description>
        </str:Code>
        <str:Code id="TOU" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).TOU">
          <com:Name xml:lang="en">Tourist</com:Name>
          <com:Description xml:lang="en">Persons traveling to and staying in places outside their usual environment for not more than one consecutive year for leisure, business, and other purposes.</com:Description>
        </str:Code>
        <str:Code id="TOUI" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).TOUI">
          <com:Name xml:lang="en">Tourist visitors index</com:Name>
          <com:Description xml:lang="en">A numerical representation that measures the relative changes in the number of tourist visitors over time compared to a base period.</com:Description>
        </str:Code>
        <str:Code id="TOUV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).TOUV">
          <com:Name xml:lang="en">Tourist visitors</com:Name>
          <com:Description xml:lang="en">Individuals who engage in tourism activities, including travel and stay outside their usual environment for leisure, business, and other purposes.</com:Description>
        </str:Code>
        <str:Code id="U" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).U">
          <com:Name xml:lang="en">Unemployment rate</com:Name>
          <com:Description xml:lang="en">The percentage of the labor force that is unemployed and actively seeking employment. It is calculated as the number of unemployed persons divided by the total labor force.</com:Description>
        </str:Code>
        <str:Code id="UP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).UP">
          <com:Name xml:lang="en">Unemployed persons</com:Name>
          <com:Description xml:lang="en">Persons of working age who are without work, are currently available for work, and are actively seeking employment.</com:Description>
        </str:Code>
        <str:Code id="WR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).WR">
          <com:Name xml:lang="en">Wage rate</com:Name>
          <com:Description xml:lang="en">A measure of the monetary compensation for labor services, typically expressed in terms of a fixed amount per hour, day, month, or other unit of time.</com:Description>
        </str:Code>
        <str:Code id="TOUP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SOC_CONCEPTS(1.3.0).TOUP">
          <com:Name xml:lang="en">Number of tourist visitors</com:Name>
          <com:Description xml:lang="en">The total count of individuals participating in tourism activities within a specified period.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_TRANSFORMATION(2.21.1)" agencyID="IMF" id="CL_TRANSFORMATION" version="2.21.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Transformation</com:Name>
        <com:Description xml:lang="en">This codelist represents a set of codes identifying the specific transformations or calculations applied to source data to derive new data elements or indicators. A transformation involves a computation with one or more input values (either base variables obtained by observation or derived variables from prior transformations) that results in a single output value (the value of a new derived variable).</com:Description>
        <str:Code id="1DIGITPT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).1DIGITPT">
          <com:Name xml:lang="en">Percent, 1 decimal</com:Name>
          <com:Description xml:lang="en">This refers to a percentage value that is expressed with one digit after the decimal point, providing a level of precision to the tenths place (e.g., 23.4%).</com:Description>
        </str:Code>
        <str:Code id="12MMA" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).12MMA">
          <com:Name xml:lang="en">12-month moving average</com:Name>
          <com:Description xml:lang="en">A moving average is a method for smoothing time series by calculating the average of the most recent 12 consecutive months of observations. Each new month, the oldest value is dropped and the newest value is added, producing a continuously updated average.</com:Description>
        </str:Code>
        <str:Code id="12MRB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).12MRB">
          <com:Name xml:lang="en">12-month rolling beta</com:Name>
          <com:Description xml:lang="en">A 12-month rolling beta is a statistical measure that shows the volatility of an investment compared to a benchmark index (like the S&amp;P 500) over a 12-month period. This calculation is done continuously, with each new month's data replacing the oldest month in the calculation, creating a "rolling" effect. One unit is equivalent to one standard deviation of the standardized variable.</com:Description>
        </str:Code>
        <str:Code id="C12" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).C12">
          <com:Name xml:lang="en">12-period cumulated sum</com:Name>
          <com:Description xml:lang="en">A 12-period cumulated sum is a transformation that calculates the sum of values over the most recent twelve consecutive periods. The calculation is updated each period by adding the newest observation and removing the oldest, producing a rolling cumulative total.</com:Description>
        </str:Code>
        <str:Code id="A12" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).A12">
          <com:Name xml:lang="en">12-period moving average</com:Name>
          <com:Description xml:lang="en">A 12-period moving average is a transformation that calculates the arithmetic mean of a variable over the most recent twelve consecutive periods. The calculation is updated each period by including the latest observation and excluding the oldest, resulting in a rolling average</com:Description>
        </str:Code>
        <str:Code id="C16" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).C16">
          <com:Name xml:lang="en">16-period cumulated sum</com:Name>
          <com:Description xml:lang="en">A 16-period cumulated sum is a transformation that calculates the sum of values over the most recent sixteen consecutive periods. The calculation is updated each period by adding the newest observation and removing the oldest, producing a rolling cumulative total.</com:Description>
        </str:Code>
        <str:Code id="Q1" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).Q1">
          <com:Name xml:lang="en">1st quartile</com:Name>
          <com:Description xml:lang="en">The first quartile (Q1) is the value below which 25 percent of the observations in a distribution fall. It represents the lower boundary of the second quarter of the ordered data and is a measure of dispersion and position.</com:Description>
        </str:Code>
        <str:Code id="2DIGITPT" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).2DIGITPT">
          <com:Name xml:lang="en">Percent, 2 decimals</com:Name>
          <com:Description xml:lang="en">This refers to a percentage value that is expressed with two digits after the decimal point, providing a level of precision to the hundredths place (e.g., 56.78%).</com:Description>
        </str:Code>
        <str:Code id="Q2" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).Q2">
          <com:Name xml:lang="en">2nd quartile</com:Name>
          <com:Description xml:lang="en">The second quartile (Q2) or Median is the value below which 50 percent of the observations in a distribution fall. It corresponds to the median of the ordered data.</com:Description>
        </str:Code>
        <str:Code id="C3" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_TRANSFORMATION(2.21.1).C3">
          <com:Name xml:lang="en">3-period cumulated sum</com:Name>
          <com:Description xml:lang="en">A 3-period cumulated sum is a calculation that adds up a set of values over a consecutive 3-period window. This could be 3 months, 3 quarters, or any other relevant time frame.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_FI_MATURITY(2.1.2)" agencyID="IMF" id="CL_FI_MATURITY" version="2.1.2" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Maturity of Financial Instrument</com:Name>
        <com:Description xml:lang="en">A classification of financial instruments based on their remaining time to maturity or expiration.</com:Description>
        <str:Code id="S" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2).S">
          <com:Name xml:lang="en">Short-term</com:Name>
          <com:Description xml:lang="en">The original contract specifies a maturity of one year or less, or repayment on demand (short-term maturity).</com:Description>
        </str:Code>
        <str:Code id="SRM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2).SRM">
          <com:Name xml:lang="en">Short-term, remaining maturity basis</com:Name>
          <com:Description xml:lang="en">Short term on a remaining maturity basis. Indicates residual maturity of one year or less at reference date.</com:Description>
        </str:Code>
        <str:Code id="L" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2).L">
          <com:Name xml:lang="en">Long-term</com:Name>
          <com:Description xml:lang="en">The original contract specifies a maturity of more than one year, or has no stated maturity (long-term maturity).</com:Description>
        </str:Code>
        <str:Code id="BY" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2).BY">
          <com:Name xml:lang="en">Bid yield to maturity</com:Name>
          <com:Description xml:lang="en">The bid yield is the yield to maturity corresponding to the current bid price (the price at which a bond can be purchased). YTM is calculated implicitly from the current market price, the remaining term to maturity, and the amount and frequency of coupon payments.</com:Description>
        </str:Code>
        <str:Code id="Y" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2).Y">
          <com:Name xml:lang="en">Yield to maturity</com:Name>
          <com:Description xml:lang="en">A bond’s yield to maturity (YTM) is the internal rate of return (IRR) that equates the present value of all future cash flows from the bond, including coupon payments and principal, to its current market price</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2)._T">
          <com:Name xml:lang="en">All original maturities</com:Name>
          <com:Description xml:lang="en">Financial instruments with their initial maturity at issuance.</com:Description>
        </str:Code>
        <str:Code id="TL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2).TL">
          <com:Name xml:lang="en">All original maturities with long-term residual maturity over 1 year</com:Name>
          <com:Description xml:lang="en">Financial instruments initially issued for any term, with more than one year remaining until maturity.</com:Description>
        </str:Code>
        <str:Code id="TS" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2).TS">
          <com:Name xml:lang="en">All original maturities with short-term residual maturity up to 1 year</com:Name>
          <com:Description xml:lang="en">Instruments initially issued for any term, with up to one year remaining until maturity.</com:Description>
        </str:Code>
        <str:Code id="LL" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2).LL">
          <com:Name xml:lang="en">Long-term original maturity over 1 year with long-term residual maturity over 1 year</com:Name>
          <com:Description xml:lang="en">Instruments initially issued for more than one year, with more than one year remaining until maturity.</com:Description>
        </str:Code>
        <str:Code id="LS" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_FI_MATURITY(2.1.2).LS">
          <com:Name xml:lang="en">Long-term by original maturity with payment due in one year or less</com:Name>
          <com:Description xml:lang="en">Instruments initially issued for more than one year, with one year or less remaining until maturity.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_EXRATE(1.2.1)" agencyID="IMF" id="CL_EXRATE" version="1.2.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Exchange Rate</com:Name>
        <com:Description xml:lang="en">Represents a set of codes identifying exchange rates between various currencies, including period averages, pre-Euro rates, and those involving Special Drawing Rights (SDRs).</com:Description>
        <str:Code id="ECU_XDC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).ECU_XDC">
          <com:Name xml:lang="en">European Currency Unit per domestic currency</com:Name>
          <com:Description xml:lang="en">Exchange rate between European Currency Unit (ECU) and a national currency.</com:Description>
        </str:Code>
        <str:Code id="EUR_XDC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).EUR_XDC">
          <com:Name xml:lang="en">Euro per domestic currency</com:Name>
          <com:Description xml:lang="en">Exchange rate indicating how many Euros are equivalent to one unit of domestic currency.</com:Description>
        </str:Code>
        <str:Code id="FX_EOP" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).FX_EOP">
          <com:Name xml:lang="en">End-of-period exchange rate</com:Name>
          <com:Description xml:lang="en">The end-of-period exchange rate refers to the exchange rate between two currencies at the end of a specific accounting or reporting period. This is typically the last business day of the month, quarter, or year.</com:Description>
        </str:Code>
        <str:Code id="FX_EUR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).FX_EUR">
          <com:Name xml:lang="en">Foreign currency paid in Euro</com:Name>
          <com:Description xml:lang="en">Foreign exchange payment for goods or services denominated and paid in Euros.</com:Description>
        </str:Code>
        <str:Code id="FX_USD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).FX_USD">
          <com:Name xml:lang="en">Foreign currency paid in US dollar</com:Name>
          <com:Description xml:lang="en">Foreign exchange payment for goods or services denominated and paid in US dollars.</com:Description>
        </str:Code>
        <str:Code id="FX_XDC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).FX_XDC">
          <com:Name xml:lang="en">Foreign currency paid in domestic currency</com:Name>
          <com:Description xml:lang="en">Foreign exchange payment for goods or services denominated and paid in domestic currency.</com:Description>
        </str:Code>
        <str:Code id="GBP_USD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).GBP_USD">
          <com:Name xml:lang="en">Pound sterling per US dollar</com:Name>
          <com:Description xml:lang="en">Exchange rate indicating how many Pound sterling are equivalent to one US dollar.</com:Description>
        </str:Code>
        <str:Code id="USD_XDC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).USD_XDC">
          <com:Name xml:lang="en">US dollar per domestic currency</com:Name>
          <com:Description xml:lang="en">Exchange rate indicating how many US dollars are equivalent to one unit of domestic currency. This is the inverse of the "Domestic currency per US dollar" rate.</com:Description>
        </str:Code>
        <str:Code id="USD_XDR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).USD_XDR">
          <com:Name xml:lang="en">US dollar per Special drawing rights</com:Name>
          <com:Description xml:lang="en">Exchange rate indicating how many US dollars are equivalent to one unit of Special Drawing Right (SDR).</com:Description>
        </str:Code>
        <str:Code id="XDC_ECU" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_EXRATE(1.2.1).XDC_ECU">
          <com:Name xml:lang="en">Domestic currency per European Currency Unit</com:Name>
          <com:Description xml:lang="en">Exchange rate indicating how many units of domestic currency are equivalent to one European Currency Unit (ECU).</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_SEX(1.1.0)" agencyID="IMF" id="CL_SEX" version="1.1.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Sex</com:Name>
        <com:Description xml:lang="en">This codelist represents a set of codes and definitions that classify an individual's sex based on assigned sex at birth and/or biological attributes.</com:Description>
        <str:Code id="F" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEX(1.1.0).F">
          <com:Name xml:lang="en">Female</com:Name>
          <com:Description xml:lang="en">Female sex assigned at birth.</com:Description>
        </str:Code>
        <str:Code id="M" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEX(1.1.0).M">
          <com:Name xml:lang="en">Male</com:Name>
          <com:Description xml:lang="en">Male sex assigned at birth.</com:Description>
        </str:Code>
        <str:Code id="I" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEX(1.1.0).I">
          <com:Name xml:lang="en">Intersex</com:Name>
          <com:Description xml:lang="en">An individual having innate different sex traits, 
such as chromosomes, gonads, or genitals, that fall 
outside of the typical male/female binary and/or 
have male and female sex traits.</com:Description>
        </str:Code>
        <str:Code id="X" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEX(1.1.0).X">
          <com:Name xml:lang="en">X</com:Name>
          <com:Description xml:lang="en">A category for non-binary individuals, gender non_x0002_conforming individuals, and other persons who do not wish to define themselves in terms of binary sex categories.</com:Description>
        </str:Code>
        <str:Code id="_Z" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEX(1.1.0)._Z">
          <com:Name xml:lang="en">Not applicable</com:Name>
          <com:Description xml:lang="en">Used in response to a question or a request for information that does not apply to the circumstances of the unit being surveyed. This concept is to be understood as meaning "statistically not applicable"; i.e. _Z is to be used only for statistical purposes.</com:Description>
        </str:Code>
        <str:Code id="_U" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEX(1.1.0)._U">
          <com:Name xml:lang="en">Unknown</com:Name>
          <com:Description xml:lang="en">Failure to obtain a measurement (e.g. non response, no data available, information not known by the respondent unit, etc.).</com:Description>
        </str:Code>
        <str:Code id="_T" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEX(1.1.0)._T">
          <com:Name xml:lang="en">Total</com:Name>
          <com:Description xml:lang="en">Used for expressing totals.</com:Description>
        </str:Code>
        <str:Code id="_O" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEX(1.1.0)._O">
          <com:Name xml:lang="en">Other</com:Name>
          <com:Description xml:lang="en">Used to cover residual information not contained in other categories of the code list (in some contexts, e.g. classifications, referred to as n.e.s., not elsewhere specified, n.e.c., not elsewhere classified, etc.)</com:Description>
        </str:Code>
        <str:Code id="_N" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SEX(1.1.0)._N">
          <com:Name xml:lang="en">Non response</com:Name>
          <com:Description xml:lang="en">Failure to obtain a measurement on one or more study variables for one or more elements in a survey.</com:Description>
        </str:Code>
      </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_ACCESS_SHARING_LEVEL(1.0.2)" agencyID="IMF" id="CL_ACCESS_SHARING_LEVEL" version="1.0.2" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Access and Sharing Level</com:Name>
        <com:Description xml:lang="en">This codelist defines the allowable levels of access and sharing for a particular data resource, specifying who can view, use, or distribute the data and under what conditions.</com:Description>
        <str:Code id="AUTHORIZED_IMF_STAFF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCESS_SHARING_LEVEL(1.0.2).AUTHORIZED_IMF_STAFF">
          <com:Name xml:lang="ar">موظفو صندوق النقد الدولي المعتمدون</com:Name>
          <com:Name xml:lang="ru">Уполномоченный персонал МВФ</com:Name>
          <com:Name xml:lang="pt">Funcionários autorizados do FMI</com:Name>
          <com:Name xml:lang="ja">許可されたIMF職員</com:Name>
          <com:Name xml:lang="en">Authorized IMF staff</com:Name>
          <com:Name xml:lang="fr">Personnel autorisé du FMI</com:Name>
          <com:Name xml:lang="es">Personal autorizado del FMI</com:Name>
          <com:Name xml:lang="zh">授权的国际货币基金组织工作人员</com:Name>
          <com:Description xml:lang="ar">شارك هذه البيانات فقط مع موظفي صندوق النقد الدولي المعتمدين الذين لديهم حاجة مشروعة لها. بالنسبة للبيانات الحساسة، قد يلزم الحصول على إذن كتابي من مُنشئ البيانات أو موافقة المدير.</com:Description>
          <com:Description xml:lang="ru">Предоставляйте эти данные только уполномоченным сотрудникам МВФ, которым они необходимы по долгу службы. Для конфиденциальных данных может потребоваться письменное разрешение создателя данных или утверждение руководителя.</com:Description>
          <com:Description xml:lang="pt">Compartilhe estes dados apenas com funcionários autorizados do FMI que tenham uma necessidade legítima para tal. Para dados sensíveis, pode ser necessária uma permissão por escrito do criador dos dados ou a aprovação do gestor.</com:Description>
          <com:Description xml:lang="ja">このデータは、正当な必要性を持つ許可されたIMF職員とのみ共有してください。機密データの場合、データ作成者からの書面による許可または管理者の承認が必要になる場合があります。</com:Description>
          <com:Description xml:lang="en">Share this data only with authorized IMF staff who have a need to know. For sensitive data, written permission from the data creator or manager approval may be required.</com:Description>
          <com:Description xml:lang="fr">Partagez ces données uniquement avec les membres du personnel autorisés du FMI qui en ont un besoin légitime. Pour les données sensibles, une autorisation écrite du créateur des données ou l'approbation du responsable peut être requise.</com:Description>
          <com:Description xml:lang="es">Comparta estos datos solo con el personal autorizado del FMI que tenga una necesidad legítima de ellos. Para datos confidenciales, puede requerirse permiso por escrito del creador de los datos o la aprobación del gerente.</com:Description>
          <com:Description xml:lang="zh">仅与有合法需求的授权国际货币基金组织工作人员共享此数据。 对于敏感数据，可能需要数据创建者或经理的书面许可。</com:Description>
        </str:Code>
        <str:Code id="ALL_IMF_STAFF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCESS_SHARING_LEVEL(1.0.2).ALL_IMF_STAFF">
          <com:Name xml:lang="ar">جميع موظفي صندوق النقد الدولي</com:Name>
          <com:Name xml:lang="ru">Все сотрудники МВФ</com:Name>
          <com:Name xml:lang="pt">Todos os funcionários do FMI</com:Name>
          <com:Name xml:lang="ja">IMF職員全員</com:Name>
          <com:Name xml:lang="en">All IMF staff</com:Name>
          <com:Name xml:lang="fr">Tout le personnel du FMI</com:Name>
          <com:Name xml:lang="es">Todo el personal del FMI</com:Name>
          <com:Name xml:lang="zh">所有国际货币基金组织工作人员</com:Name>
          <com:Description xml:lang="ar">شارك هذه البيانات داخل صندوق النقد الدولي، باستثناء مجلس الإدارة.</com:Description>
          <com:Description xml:lang="ru">Делитесь этими данными внутри МВФ, исключая Совет директоров.</com:Description>
          <com:Description xml:lang="pt">Compartilhe estes dados dentro do FMI, excluindo o Conselho de Administração.</com:Description>
          <com:Description xml:lang="ja">このデータは、理事会を除くIMF内で共有してください。</com:Description>
          <com:Description xml:lang="en">Share this data within the IMF, excluding the OED staff members.</com:Description>
          <com:Description xml:lang="fr">Partagez ces données au sein du FMI, à l'exclusion du Conseil d'administration.</com:Description>
          <com:Description xml:lang="es">Comparta estos datos dentro del FMI, excluyendo a la Junta Directiva.</com:Description>
          <com:Description xml:lang="zh">在国际货币基金组织内部共享此数据，但不包括董事会。</com:Description>
        </str:Code>
        <str:Code id="PUBLIC_OPEN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCESS_SHARING_LEVEL(1.0.2).PUBLIC_OPEN">
          <com:Name xml:lang="ar">الجمهور (غير مقيد)</com:Name>
          <com:Name xml:lang="ru">Общественность (без ограничений)</com:Name>
          <com:Name xml:lang="pt">Público (sem restrições)</com:Name>
          <com:Name xml:lang="ja">一般公開（無制限）</com:Name>
          <com:Name xml:lang="en">Public (Unrestricted)</com:Name>
          <com:Name xml:lang="fr">Public (sans restriction)</com:Name>
          <com:Name xml:lang="es">Público (sin restricciones)</com:Name>
          <com:Name xml:lang="zh">公众（无限制）</com:Name>
          <com:Description xml:lang="ar">شارك هذه البيانات مع الجمهور دون قيود.</com:Description>
          <com:Description xml:lang="ru">Поделитесь этими данными с общественностью без ограничений.</com:Description>
          <com:Description xml:lang="pt">Compartilhe estes dados com o público sem restrições.</com:Description>
          <com:Description xml:lang="ja">このデータを制限なく一般に公開してください。</com:Description>
          <com:Description xml:lang="en">Share this data with the public without restrictions.</com:Description>
          <com:Description xml:lang="fr">Partagez ces données avec le public sans restriction.</com:Description>
          <com:Description xml:lang="es">Comparta estos datos con el público sin restricciones.</com:Description>
          <com:Description xml:lang="zh">与公众共享此数据，不受任何限制。</com:Description>
        </str:Code>
        <str:Code id="PUBLIC_AGREEMENT_REQUIRED" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCESS_SHARING_LEVEL(1.0.2).PUBLIC_AGREEMENT_REQUIRED">
          <com:Name xml:lang="ar">الجمهور (الشروط والأحكام)</com:Name>
          <com:Name xml:lang="ru">Общественность (условия и положения)</com:Name>
          <com:Name xml:lang="pt">Público (termos e condições)</com:Name>
          <com:Name xml:lang="ja">一般公開（利用規約）</com:Name>
          <com:Name xml:lang="en">Public (Terms &amp; Conditions)</com:Name>
          <com:Name xml:lang="fr">Public (Conditions générales)</com:Name>
          <com:Name xml:lang="es">Público (términos y condiciones)</com:Name>
          <com:Name xml:lang="zh">公众（条款和条件）</com:Name>
          <com:Description xml:lang="ar">شارك هذه البيانات مع الجمهور عند موافقتهم على الشروط والأحكام لعرض البيانات وتنزيلها.</com:Description>
          <com:Description xml:lang="ru">Поделитесь этими данными с общественностью после того, как они согласятся с условиями просмотра и загрузки данных.</com:Description>
          <com:Description xml:lang="pt">Compartilhe estes dados com o público mediante a sua concordância com os termos e condições para visualizar e descarregar os dados.</com:Description>
          <com:Description xml:lang="ja">このデータは、データの閲覧およびダウンロードに関する利用規約に同意した上で、一般に公開してください。</com:Description>
          <com:Description xml:lang="en">Share this data with the public upon their agreement to the terms and conditions for viewing and downloading the data.</com:Description>
          <com:Description xml:lang="fr">Partagez ces données avec le public après qu'il a accepté les conditions générales de visualisation et de téléchargement des données.</com:Description>
          <com:Description xml:lang="es">Comparta estos datos con el público una vez que acepten los términos y condiciones para ver y descargar los datos.</com:Description>
          <com:Description xml:lang="zh">在公众同意查看和下载数据的条款和条件后，与他们共享此数据。</com:Description>
        </str:Code>
        <str:Code id="PUBLIC_SIGNIN_REQUIRED" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCESS_SHARING_LEVEL(1.0.2).PUBLIC_SIGNIN_REQUIRED">
          <com:Name xml:lang="ar">الجمهور (المسجل)</com:Name>
          <com:Name xml:lang="ru">Общественность (зарегистрированная)</com:Name>
          <com:Name xml:lang="pt">Público (registado)</com:Name>
          <com:Name xml:lang="ja">一般公開（登録済み）</com:Name>
          <com:Name xml:lang="en">Public (Registered)</com:Name>
          <com:Name xml:lang="fr">Public (Enregistré)</com:Name>
          <com:Name xml:lang="es">Público (registrado)</com:Name>
          <com:Name xml:lang="zh">公众（注册）</com:Name>
          <com:Description xml:lang="ar">شارك هذه البيانات مع الجمهور عند التسجيل وتسجيل الدخول لعرض البيانات وتنزيلها.</com:Description>
          <com:Description xml:lang="ru">Делитесь этими данными с общественностью после регистрации и входа в систему для просмотра и загрузки данных.</com:Description>
          <com:Description xml:lang="pt">Compartilhe estes dados com o público mediante registo e início de sessão para visualizar e descarregar os dados.</com:Description>
          <com:Description xml:lang="ja">このデータは、データの閲覧およびダウンロードのための登録およびサインイン後に、一般に公開してください。</com:Description>
          <com:Description xml:lang="en">Share this data with the public upon registration and sign-in for viewing and downloading the data.</com:Description>
          <com:Description xml:lang="fr">Partagez ces données avec le public après son inscription et sa connexion pour la visualisation et le téléchargement des données.</com:Description>
          <com:Description xml:lang="es">Comparta estos datos con el público tras el registro e inicio de sesión para ver y descargar los datos.</com:Description>
          <com:Description xml:lang="zh">在公众注册并登录以查看和下载数据后，与他们共享此数据。</com:Description>
        </str:Code>
        <str:Code id="AUTHORIZED_BOARD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCESS_SHARING_LEVEL(1.0.2).AUTHORIZED_BOARD">
          <com:Name xml:lang="ar">مجلس الإدارة المعتمد</com:Name>
          <com:Name xml:lang="ru">Уполномоченный совет директоров</com:Name>
          <com:Name xml:lang="pt">Conselho de Administração autorizado</com:Name>
          <com:Name xml:lang="ja">許可された理事会</com:Name>
          <com:Name xml:lang="en">Authorized Board</com:Name>
          <com:Name xml:lang="fr">Conseil d'administration autorisé</com:Name>
          <com:Name xml:lang="es">Junta Directiva autorizada</com:Name>
          <com:Name xml:lang="zh">授权董事会</com:Name>
          <com:Description xml:lang="ar">شارك هذه البيانات فقط مع أعضاء مجلس الإدارة المعتمدين الذين لديهم حاجة مشروعة لها. بالنسبة للبيانات الحساسة، قد يلزم الحصول على إذن كتابي من مُنشئ البيانات أو موافقة المدير.</com:Description>
          <com:Description xml:lang="ru">Предоставляйте эти данные только уполномоченным членам Совета директоров, которым они необходимы по долгу службы. Для конфиденциальных данных может потребоваться письменное разрешение создателя данных или утверждение руководителя.</com:Description>
          <com:Description xml:lang="pt">Compartilhe estes dados apenas com membros autorizados do Conselho de Administração que tenham uma necessidade legítima para tal. Para dados sensíveis, pode ser necessária uma permissão por escrito do criador dos dados ou a aprovação do gestor.</com:Description>
          <com:Description xml:lang="ja">このデータは、正当な必要性を持つ許可された理事会メンバーとのみ共有してください。機密データの場合、データ作成者からの書面による許可または管理者の承認が必要になる場合があります。</com:Description>
          <com:Description xml:lang="en">Share this data only with authorized OED staff members who have a need to know. For sensitive data, written permission from the data creator or manager approval may be required.</com:Description>
          <com:Description xml:lang="fr">Partagez ces données uniquement avec les membres autorisés du Conseil d'administration qui en ont un besoin légitime. Pour les données sensibles, une autorisation écrite du créateur des données ou l'approbation du responsable peut être requise.</com:Description>
          <com:Description xml:lang="es">Comparta estos datos solo con los miembros autorizados de la Junta Directiva que tengan una necesidad legítima de ellos. Para datos confidenciales, puede requerirse permiso por escrito del creador de los datos o la aprobación del gerente.</com:Description>
          <com:Description xml:lang="zh">仅与有合法需求的授权董事会成员共享此数据。 对于敏感数据，可能需要数据创建者或经理的书面许可。</com:Description>
        </str:Code>
        <str:Code id="AUTHORIZED_PARTNERS" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCESS_SHARING_LEVEL(1.0.2).AUTHORIZED_PARTNERS">
          <com:Name xml:lang="ar">شركاء معتمدون</com:Name>
          <com:Name xml:lang="ru">Уполномоченные партнеры</com:Name>
          <com:Name xml:lang="pt">Parceiros autorizados</com:Name>
          <com:Name xml:lang="ja">許可されたパートナー</com:Name>
          <com:Name xml:lang="en">Authorized partners</com:Name>
          <com:Name xml:lang="fr">Partenaires autorisés</com:Name>
          <com:Name xml:lang="es">Socios autorizados</com:Name>
          <com:Name xml:lang="zh">授权合作伙伴</com:Name>
          <com:Description xml:lang="ar">شارك هذه البيانات فقط مع الشركاء الخارجيين المعتمدين الذين لديهم حاجة مشروعة لها. بالنسبة للبيانات الحساسة، قد يلزم الحصول على إذن كتابي من مُنشئ البيانات أو موافقة المدير.</com:Description>
          <com:Description xml:lang="ru">Предоставляйте эти данные только уполномоченным внешним партнерам, которым они необходимы по долгу службы. Для конфиденциальных данных может потребоваться письменное разрешение создателя данных или утверждение руководителя.</com:Description>
          <com:Description xml:lang="pt">Compartilhe estes dados apenas com parceiros externos autorizados que tenham uma necessidade legítima para tal. Para dados sensíveis, pode ser necessária uma permissão por escrito do criador dos dados ou a aprovação do gestor.</com:Description>
          <com:Description xml:lang="ja">このデータは、正当な必要性を持つ許可された外部パートナーとのみ共有してください。機密データの場合、データ作成者からの書面による許可または管理者の承認が必要になる場合があります。</com:Description>
          <com:Description xml:lang="en">Share this data only with authorized external partners who have a need to know. For sensitive data, written permission from the data creator or manager approval may be required.</com:Description>
          <com:Description xml:lang="fr">Partagez ces données uniquement avec les partenaires externes autorisés qui en ont un besoin légitime. Pour les données sensibles, une autorisation écrite du créateur des données ou l'approbation du responsable peut être requise.</com:Description>
          <com:Description xml:lang="es">Comparta estos datos solo con socios externos autorizados que tengan una necesidad legítima de ellos. Para datos confidenciales, puede requerirse permiso por escrito del creador de los datos o la aprobación del gerente.</com:Description>
          <com:Description xml:lang="zh">仅与有合法需求的授权外部合作伙伴共享此数据。 对于敏感数据，可能需要数据创建者或经理的书面许可。</com:Description>
        </str:Code>
        <str:Code id="BOARD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_ACCESS_SHARING_LEVEL(1.0.2).BOARD">
          <com:Name xml:lang="ar">مجلس الإدارة</com:Name>
          <com:Name xml:lang="ru">Совет директоров</com:Name>
          <com:Name xml:lang="pt">Conselho de Administração</com:Name>
          <com:Name xml:lang="ja">理事会</com:Name>
          <com:Name xml:lang="en">Board</com:Name>
          <com:Name xml:lang="fr">Conseil d'administration</com:Name>
          <com:Name xml:lang="es">Junta Directiva</com:Name>
          <com:Name xml:lang="zh">董事会</com:Name>
          <com:Description xml:lang="ar">شارك هذه البيانات مع مجلس الإدارة.</com:Description>
          <com:Description xml:lang="ru">Поделитесь этими данными с Советом директоров.</com:Description>
          <com:Description xml:lang="pt">Compartilhe estes dados com o Conselho de Administração.</com:Description>
          <com:Description xml:lang="ja">このデータを理事会と共有してください。</com:Description>
          <com:Description xml:lang="en">Share this data with the OED staff members.</com:Description>
          <com:Description xml:lang="fr">Partagez ces données avec le Conseil d'administration.</com:Description>
          <com:Description xml:lang="es">Comparta estos datos con la Junta Directiva.</com:Description>
          <com:Description xml:lang="zh">与董事会共享此数据。</com:Description>
        </str:Code>
      </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_SECTOR(2.13.1)" agencyID="IMF" id="CL_SECTOR" version="2.13.1" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Institutional Sector</com:Name>
        <com:Description xml:lang="en">This codelist represents a classification of institutional units based on their economic function and role in the economy, such as households, non-financial corporations, financial corporations, or government.</com:Description>
        <str:Code id="S1A" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).S1A">
          <com:Name xml:lang="en">Affiliated entities</com:Name>
          <com:Description xml:lang="en">Enterprises linked through a direct or indirect ownership or control relationships.</com:Description>
        </str:Code>
        <str:Code id="S1G" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).S1G">
          <com:Name xml:lang="en">All resident sectors excluding financial intermediaries (CDIS)</com:Name>
          <com:Description xml:lang="en">All resident sectors excluding financial intermediaries as per Coordinated Direct Investment Survey guidelines.</com:Description>
        </str:Code>
        <str:Code id="S1ZV" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).S1ZV">
          <com:Name xml:lang="en">All sectors other than households and NPISH</com:Name>
          <com:Description xml:lang="en">All institutional sectors except households and non-profit institutions serving households.</com:Description>
        </str:Code>
        <str:Code id="BANK" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).BANK">
          <com:Name xml:lang="en">Deposit-taking corporations, except the central bank</com:Name>
          <com:Description xml:lang="en">Financial corporations, excluding the central bank, that are principally engaged in financial intermediation and incur liabilities in the form of deposits and/or close substitutes for deposits.</com:Description>
        </str:Code>
        <str:Code id="S12A" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).S12A">
          <com:Name xml:lang="en">Banks and other financial institutions headquartered in the reporting country or currency area</com:Name>
          <com:Description xml:lang="en">Financial institutions headquartered in the reporting country or currency area.</com:Description>
        </str:Code>
        <str:Code id="S12B" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).S12B">
          <com:Name xml:lang="en">Banks and other financial institutions headquartered outside the reporting country or currency area</com:Name>
          <com:Description xml:lang="en">Financial institutions headquartered outside the reporting country or currency area.</com:Description>
        </str:Code>
        <str:Code id="S122A" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).S122A">
          <com:Name xml:lang="en">Banks headquartered in the reporting country or currency area</com:Name>
          <com:Description xml:lang="en">Banks headquartered in the reporting country or currency area.</com:Description>
        </str:Code>
        <str:Code id="S122B" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).S122B">
          <com:Name xml:lang="en">Banks headquartered outside the reporting country or currency area</com:Name>
          <com:Description xml:lang="en">Banks headquartered outside the reporting country or currency area.</com:Description>
        </str:Code>
        <str:Code id="S12L3" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).S12L3">
          <com:Name xml:lang="en">Bond funds</com:Name>
          <com:Description xml:lang="en">Investment funds primarily investing in bonds.</com:Description>
        </str:Code>
        <str:Code id="S1311B" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_SECTOR(2.13.1).S1311B">
          <com:Name xml:lang="en">Budgetary central government</com:Name>
          <com:Description xml:lang="en">Central government operations financed through the general budget.</com:Description>
        </str:Code>
        </str:Codelist>
      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_GENDER(1.0.0)" agencyID="IMF" id="CL_GENDER" version="1.0.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Gender</com:Name>
        <com:Description xml:lang="en">This codelist represents the spectrum of an individual's internal and individual experience of gender, which can be the same or different from their sex assigned at birth.</com:Description>
        <str:Code id="M" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).M">
          <com:Name xml:lang="en">Men</com:Name>
          <com:Description xml:lang="en">An individual who defines themselves and lives as a male.</com:Description>
        </str:Code>
        <str:Code id="W" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).W">
          <com:Name xml:lang="en">Women</com:Name>
          <com:Description xml:lang="en">An individual who defines themselves and lives as a female.</com:Description>
        </str:Code>
        <str:Code id="TM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).TM">
          <com:Name xml:lang="en">Transgender men</com:Name>
          <com:Description xml:lang="en">An individual who defines themselves and lives as a male, who was assigned female at birth.</com:Description>
        </str:Code>
        <str:Code id="TW" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).TW">
          <com:Name xml:lang="en">Transgender women</com:Name>
          <com:Description xml:lang="en">An individual who defines themselves and lives as a female, who was assigned as male at birth.</com:Description>
        </str:Code>
        <str:Code id="CM" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).CM">
          <com:Name xml:lang="en">Cis men</com:Name>
          <com:Description xml:lang="en">An individual who defines themselves and lives as a male, who was assigned male at birth.</com:Description>
        </str:Code>
        <str:Code id="CW" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).CW">
          <com:Name xml:lang="en">Cis women</com:Name>
          <com:Description xml:lang="en">An individual who defines themselves and lives as a female, who 
was assigned female at birth.</com:Description>
        </str:Code>
        <str:Code id="NB" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).NB">
          <com:Name xml:lang="en">Non-binary</com:Name>
          <com:Description xml:lang="en">An individual who defines themselves outside the binary of man or woman, and which may include various identities located at any point on the gender spectrum.</com:Description>
        </str:Code>
        <str:Code id="GF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).GF">
          <com:Name xml:lang="en">Gender fluid</com:Name>
          <com:Description xml:lang="en">An individual who does not have a fixed gender, and whose gender moves between different points on the gender spectrum. 3</com:Description>
        </str:Code>
        <str:Code id="GNC" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).GNC">
          <com:Name xml:lang="en">Gender non-conforming</com:Name>
          <com:Description xml:lang="en">An individual who does not conform with the gender roles/norms/behaviours/expression expected from a given gender in a given society</com:Description>
        </str:Code>
        <str:Code id="GN" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_GENDER(1.0.0).GN">
          <com:Name xml:lang="en">Agender / Gender neutral</com:Name>
          <com:Description xml:lang="en">An individual who does not identify with any gender.</com:Description>
        </str:Code>
        </str:Codelist>
    </str:Codelists>
    <str:Concepts>
      <str:ConceptScheme urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.ConceptScheme=IMF:CS_MASTER_SYSTEM(1.0.2)" agencyID="IMF" id="CS_MASTER_SYSTEM" version="1.0.2" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="dataEngineSettings"/>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">CS_MASTER_SYSTEM</com:Name>
        <str:Concept id="FREQ" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_SYSTEM(1.0.2).FREQ">
          <com:Name xml:lang="ar">معدل التواتر</com:Name>
          <com:Name xml:lang="ru">Периодичность</com:Name>
          <com:Name xml:lang="pt">Frequência</com:Name>
          <com:Name xml:lang="ja">頻度</com:Name>
          <com:Name xml:lang="en">Frequency</com:Name>
          <com:Name xml:lang="fr">Fréquence</com:Name>
          <com:Name xml:lang="es">Frecuencia</com:Name>
          <com:Name xml:lang="zh">频率</com:Name>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_FREQ" version="1.2.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="SCALE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_SYSTEM(1.0.2).SCALE">
          <com:Name xml:lang="ar">عدد الخانات العشرية</com:Name>
          <com:Name xml:lang="ru">Масштаб</com:Name>
          <com:Name xml:lang="pt">Escala</com:Name>
          <com:Name xml:lang="ja">尺度</com:Name>
          <com:Name xml:lang="en">Scale</com:Name>
          <com:Name xml:lang="fr">Échelle</com:Name>
          <com:Name xml:lang="es">Escala</com:Name>
          <com:Name xml:lang="zh">规模</com:Name>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_UNIT_MULT" version="1.0.2" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="PRECISION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_SYSTEM(1.0.2).PRECISION">
          <com:Name xml:lang="ar">عدد الخانات الصحيحة والعشرية</com:Name>
          <com:Name xml:lang="ru">Точность</com:Name>
          <com:Name xml:lang="pt">Precisão</com:Name>
          <com:Name xml:lang="ja">精度</com:Name>
          <com:Name xml:lang="en">Precision</com:Name>
          <com:Name xml:lang="fr">Précision</com:Name>
          <com:Name xml:lang="es">Precisión</com:Name>
          <com:Name xml:lang="zh">精度</com:Name>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_UNIT_MULT" version="1.0.2" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="DECIMALS_DISPLAYED" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_SYSTEM(1.0.2).DECIMALS_DISPLAYED">
          <com:Name xml:lang="ar">الأعداد العشرية الموضحة</com:Name>
          <com:Name xml:lang="ru">Количество отображаемых десятичных знаков</com:Name>
          <com:Name xml:lang="pt">Decimais visíveis</com:Name>
          <com:Name xml:lang="ja">小数点表示</com:Name>
          <com:Name xml:lang="en">Decimals Displayed</com:Name>
          <com:Name xml:lang="fr">Décimales affichées</com:Name>
          <com:Name xml:lang="es">Decimales visibles</com:Name>
          <com:Name xml:lang="zh">显示的小数位数</com:Name>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_DECIMALS" version="1.0.3" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="OBS_VALUE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_SYSTEM(1.0.2).OBS_VALUE">
          <com:Name xml:lang="ar">قيمة المشاهدات</com:Name>
          <com:Name xml:lang="ru">Значение наблюдения</com:Name>
          <com:Name xml:lang="pt">Valor de observação</com:Name>
          <com:Name xml:lang="ja">観測値</com:Name>
          <com:Name xml:lang="en">Observation value</com:Name>
          <com:Name xml:lang="fr">Valeur d’observation</com:Name>
          <com:Name xml:lang="es">Valor de observación</com:Name>
          <com:Name xml:lang="zh">观测值</com:Name>
          <str:CoreRepresentation>
            <str:TextFormat textType="Decimal"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="TIME_PERIOD" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_SYSTEM(1.0.2).TIME_PERIOD">
          <com:Annotations>
            <com:Annotation id="indexed">
              <com:AnnotationTitle/>
              <com:AnnotationType>INDEX_CONCEPTS</com:AnnotationType>
            </com:Annotation>
          </com:Annotations>
          <com:Name xml:lang="ar">الفترة الزمنية</com:Name>
          <com:Name xml:lang="ru">Период времени</com:Name>
          <com:Name xml:lang="pt">Período</com:Name>
          <com:Name xml:lang="ja">期間</com:Name>
          <com:Name xml:lang="en">Time Period</com:Name>
          <com:Name xml:lang="fr">Période couverte</com:Name>
          <com:Name xml:lang="es">Período de tiempo</com:Name>
          <com:Name xml:lang="zh">时间段</com:Name>
          <str:CoreRepresentation>
            <str:TextFormat textType="ObservationalTimePeriod"/>
          </str:CoreRepresentation>
        </str:Concept>
      </str:ConceptScheme>
      <str:ConceptScheme urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.ConceptScheme=IMF:CS_MASTER(2.3.0)" agencyID="IMF" id="CS_MASTER" version="2.3.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Master Metadata Concepts</com:Name>
        <com:Description xml:lang="en">Standardized definitions for common data elements used across multiple datasets. These elements include attributes like identification and provenance, access controls, methodology and other general descriptive characteristics.</com:Description>
        <str:Concept id="DOI" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).DOI">
          <com:Name xml:lang="en">DOI</com:Name>
          <com:Description xml:lang="en">A public identifier (unique alphanumeric string) assigned to a digital object, typically a publication or dataset, to provide a persistent link to its location on the internet.Users use it for citing the resource. </com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="SERIES_NAME" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).SERIES_NAME">
          <com:Name xml:lang="en">Series Name</com:Name>
          <com:Description xml:lang="en">A  label  given to a specific series. This name helps to distinguish it from other series data and provides context for what the data represents.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="AUTHOR" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).AUTHOR">
          <com:Name xml:lang="en">Author</com:Name>
          <com:Description xml:lang="en">The person or organization responsible for resource’s substantive and intellectual content.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="PUBLISHER" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).PUBLISHER">
          <com:Name xml:lang="en">Publisher</com:Name>
          <com:Description xml:lang="en">The organization or institution responsible for making a resource available to the public or a specific audience. For datasets, the publisher is responsible for preparing and releasing the dataset for public or private use. This includes ensuring the dataset's quality, accuracy, and accessibility.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_ORGANIZATION" version="2.11.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="DEPARTMENT" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).DEPARTMENT">
          <com:Name xml:lang="en">Department</com:Name>
          <com:Description xml:lang="en">The specific division or unit within an organization (e.g., the IMF) that is ultimately accountable for the creation, maintenance, and dissemination of a resource.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_DEPARTMENT" version="1.0.2" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="CREATOR" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).CREATOR">
          <com:Name xml:lang="en">Creator</com:Name>
          <com:Description xml:lang="en">The creator is the entity primarily responsible for creating the resource. Institution responsible for producing official statistics.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_ORGANIZATION" version="2.11.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="DATA_OWNER" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).DATA_OWNER">
          <com:Name xml:lang="en">Data Owner</com:Name>
          <com:Description xml:lang="en">Institution that holds the legal ownership and accountability for the data, ensuring it aligns with national or international policies.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_ORGANIZATION" version="2.11.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="DATA_STEWARD" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).DATA_STEWARD">
          <com:Name xml:lang="en">Data Steward</com:Name>
          <com:Description xml:lang="en">Institution that ensures the quality and metadata of the data, and that it adheres to relevant standards.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_ORGANIZATION" version="2.11.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="PUBLICATION_DATE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).PUBLICATION_DATE">
          <com:Name xml:lang="en">Publication Date</com:Name>
          <com:Description xml:lang="en">The date when a resource was formally issued or made available to the public or a specific audience. This applies to datasets that have major releases, but the data may have minor updates throughout the year. In most cases where the data is regularly updated, the publication date is the same as the update date.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="DateTime"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="UPDATE_DATE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).UPDATE_DATE">
          <com:Name xml:lang="en">Update Date</com:Name>
          <com:Description xml:lang="en">The most recent date on which a resource was modified or updated, including changes to data or metadata.  For a dataset, the update date is the time when the data within a dataset was last modified, or the metadata was modified.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="DateTime"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="SOURCE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).SOURCE">
          <com:Name xml:lang="en">Source Organization</com:Name>
          <com:Description xml:lang="en">The entity responsible for producing or collecting the original data used in a resource. This could be a government agency, a research institution, a private company, or any other entity that generates data. When citing or referencing information, it is important to identify the source organization to ensure credibility and accuracy.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_ORGANIZATION" version="2.11.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="SHORT_SOURCE_CITATION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).SHORT_SOURCE_CITATION">
          <com:Name xml:lang="en">Short Source Citation</com:Name>
          <com:Description xml:lang="en">A brief reference to the source of data or information used in a resource, typically including the author, title, and year of publication.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="FULL_SOURCE_CITATION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).FULL_SOURCE_CITATION">
          <com:Name xml:lang="en">Full Source Citation </com:Name>
          <com:Description xml:lang="en">A complete reference to the source of data or information used in a resource, providing all necessary details to locate and verify the original source.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="SUGGESTED_CITATION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).SUGGESTED_CITATION">
          <com:Name xml:lang="en">Suggested Citation </com:Name>
          <com:Description xml:lang="en">A recommended format for citing a resource in academic or professional works, ensuring proper attribution and acknowledgement of the source.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="FULL_DESCRIPTION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).FULL_DESCRIPTION">
          <com:Name xml:lang="en">Full Description</com:Name>
          <com:Description xml:lang="en">A comprehensive description of the dataset, encompassing its content, scope, underlying concepts, coverage, classifications, and statistical techniques employed in its creation and analysis. This may include references to detailed methodological documents or papers that provide further elaboration on these aspects.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="TOPIC" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).TOPIC">
          <com:Name xml:lang="en">Topic</com:Name>
          <com:Description xml:lang="en">A topic of the resource. A high-level categorization of the resource's subject matter, indicating the main area or domain to which the data pertains.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_TOPIC" version="2.3.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="TOPIC_DATASET" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).TOPIC_DATASET">
          <com:Name xml:lang="en">Topic Dataset</com:Name>
          <com:Description xml:lang="en">A topic of the dataset.  A high-level categorization of the dataset's subject matter, indicating the main area or domain to which the data pertains.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_TOPIC" version="2.3.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="KEYWORDS" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).KEYWORDS">
          <com:Name xml:lang="en">Keywords</com:Name>
          <com:Description xml:lang="en">A set of words or phrases that describe the content and subject matter of a resource.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="KEYWORDS_DATASET" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).KEYWORDS_DATASET">
          <com:Name xml:lang="en">Keywords Dataset</com:Name>
          <com:Description xml:lang="en">A set of words or phrases that describe the content and subject matter of a dataset.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="KEY_INDICATOR" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).KEY_INDICATOR">
          <com:Name xml:lang="en">Key Indicator</com:Name>
          <com:Description xml:lang="en">A flag or indicator that identifies a data element or indicator as being of particular importance or significance for a specific analysis or purpose.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="Boolean"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="LANGUAGE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).LANGUAGE">
          <com:Name xml:lang="en">Language</com:Name>
          <com:Description xml:lang="en">It refers to the language of the intellectual content of the resource. It can be applied to any type of resource, including documents, datasets, images, audio recordings, etc.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_LANGUAGE" version="1.1.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="TEMPORAL_COVERAGE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).TEMPORAL_COVERAGE">
          <com:Name xml:lang="en">Temporal Coverage</com:Name>
          <com:Description xml:lang="en">This field represents the temporal coverage of the data, expressed using the ISO 8601 standard. The data spans the time interval from 1997 to 2009 (inclusive), indicated as 1997/2009.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="FREQUENCY_COVERAGE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).FREQUENCY_COVERAGE">
          <com:Name xml:lang="en">Frequency Coverage</com:Name>
          <com:Description xml:lang="en">Frequency Coverage in a dataset like annual or monthly refers to the range of time periods for which data is available. </com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_FREQ" version="1.2.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="GEOGRAPHICAL_COVERAGE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).GEOGRAPHICAL_COVERAGE">
          <com:Name xml:lang="en">Geographical Coverage</com:Name>
          <com:Description xml:lang="en">This field specifies the spatial extent of the data, detailing the geographic areas or regions included in the dataset. It may be represented by countries, continents, coordinates, or specific boundaries such as cities, regions, or global coverage.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="METHODOLOGY" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).METHODOLOGY">
          <com:Name xml:lang="en">Methodology</com:Name>
          <com:Description xml:lang="en">Reference to the conceptual statistical framework and underlying statistical methodology  used for the dataset (e.g. country specific).</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_METHODOLOGY" version="2.8.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="METHODOLOGY_NOTES" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).METHODOLOGY_NOTES">
          <com:Name xml:lang="en">Methodology Notes</com:Name>
          <com:Description xml:lang="en">Additional details or explanations regarding the methodology used for a specific dataset or indicator. These notes outline the conceptual frameworks and statistical methods used to collect, process, and analyze the data, and can vary in level of detail depending on the data's complexity. For example: a) At the country level, methodology notes describe the specific methods used by each country to calculate particular indicators. b) At the time series level, methodology notes provide a detailed explanation of how an indicator is generated for a specific country.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="CONTACT_POINT" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).CONTACT_POINT">
          <com:Name xml:lang="en">Contact Point</com:Name>
          <com:Description xml:lang="en">The primary individual or group responsible for handling inquiries and providing information about a resource. For datasets published on the IMF data portal, the point of contact shown to public users is standardized as a common help email address.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="SECURITY_CLASSIFICATION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).SECURITY_CLASSIFICATION">
          <com:Name xml:lang="en">Security Classification</com:Name>
          <com:Description xml:lang="en">A data classification assigned to data based on its sensitivity, value, and the potential impact of unauthorized access, disclosure, alteration, or destruction, resulting in the assignment of a tag that designates the data's sensitivity level.  This attribute is assigned at lower levels of data when a dataset contains a mix of data access levels, with some series designated as public and others as confidential.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_SEC_CLASSIFICATION" version="1.0.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="ACCESS_SHARING_LEVEL" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).ACCESS_SHARING_LEVEL">
          <com:Annotations>
            <com:Annotation id="indexed">
              <com:AnnotationType>INDEX_CONCEPTS</com:AnnotationType>
            </com:Annotation>
          </com:Annotations>
          <com:Name xml:lang="en">Access and Sharing Level</com:Name>
          <com:Description xml:lang="en">A classification that specifies the extent to which a resource can be shared with others, including restrictions on access, use, and distribution.  It specifies who can access the data (e.g., public, specific groups, authorized personnel) and what actions they can take with it. The appropriate sharing level depends on the sensitivity and intended use of the data, ranging from open access for public data to restricted access for confidential information. This attribute is assigned at lower levels of data when a dataset contains a mix of data access levels, with some series designated as public and others as restricted.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_ACCESS_SHARING_LEVEL" version="1.0.2" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="ACCESS_SHARING_NOTES" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).ACCESS_SHARING_NOTES">
          <com:Name xml:lang="en">Access and Sharing Notes</com:Name>
          <com:Description xml:lang="en">Additional notes involves documenting any нюances or complexities beyond the standard access and sharing levels.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="ACCESS_INSTRUCTIONS" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).ACCESS_INSTRUCTIONS">
          <com:Name xml:lang="en">Access Instructions</com:Name>
          <com:Description xml:lang="en">Detailed guidance on how to obtain or access a resource, particularly relevant for datasets. </com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="USAGE_RIGHTS_NOTES" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).USAGE_RIGHTS_NOTES">
          <com:Name xml:lang="en">Usage Rights Notes</com:Name>
          <com:Description xml:lang="en">Additional notes or explanations regarding the licensing terms for the source data used in a dataset.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="LICENSE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).LICENSE">
          <com:Name xml:lang="en">License</com:Name>
          <com:Description xml:lang="en">Information on the licence for distribution /  legal agreement that defines the terms under which a resource can be used, shared, or distributed.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="URL" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).URL">
          <com:Name xml:lang="en">URL</com:Name>
          <com:Description xml:lang="en">Direct link to the dataset on the external source's platform.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="CLASSIFICATION_TYPE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER(2.3.0).CLASSIFICATION_TYPE">
          <com:Name xml:lang="en">Standard Classification Type</com:Name>
          <com:Description xml:lang="en">Identifies the standard classifications used for the data.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_CLASSIFICATION_TYPE" version="1.0.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
      </str:ConceptScheme>
      <str:ConceptScheme urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.ConceptScheme=IMF.STA:CS_MASTER(1.0.0)" agencyID="IMF.STA" id="CS_MASTER" version="1.0.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">STA: Master Concepts</com:Name>
        <com:Description xml:lang="en">A standardized set of concepts and definitions that classify and describe the data elements used within STA.</com:Description>
        <str:Concept id="STATUS" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF.STA:CS_MASTER(1.0.0).STATUS">
          <com:Name xml:lang="en">Status</com:Name>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="COMMON_REFERENCE_PERIOD" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF.STA:CS_MASTER(1.0.0).COMMON_REFERENCE_PERIOD">
          <com:Name xml:lang="en">Common Reference Period</com:Name>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="IFS_FLAG" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF.STA:CS_MASTER(1.0.0).IFS_FLAG">
          <com:Name xml:lang="en">IFS flag</com:Name>
          <com:Description xml:lang="en">A key indicator flag is used to identify and mark indicators that were part of the IFS data product. </com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="Boolean"/>
          </str:CoreRepresentation>
        </str:Concept>
      </str:ConceptScheme>
      <str:ConceptScheme urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.ConceptScheme=SDMX:SDMX_CONCEPT_ROLES(1.0)" agencyID="SDMX" id="SDMX_CONCEPT_ROLES" version="1.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">SDMX Concept Scheme for Concept Roles</com:Name>
        <com:Description xml:lang="en">A concept role gives a particular context to a concept for easy and systematic interpretation by machine processing and visualization tools. For example, the concepts REPORTING_AREA and COUNTERPART_AREA are different concepts but they are both geographical characteristics, therefore they can be associated with the same concept role ID: “GEO”. This allows visualization systems to interpret these concepts as geographical data in order to generate maps. For any question, comment or correction, feel free to contact the SDMX Statistical Working Group (SWG) at the following address: swg@sdmx.org.</com:Description>
        <str:Concept id="GEO" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=SDMX:SDMX_CONCEPT_ROLES(1.0).GEO">
          <com:Name xml:lang="en">Geographical</com:Name>
          <com:Description xml:lang="en">Geographic area to which the measured statistical phenomenon relates.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="FLAG" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=SDMX:SDMX_CONCEPT_ROLES(1.0).FLAG">
          <com:Name xml:lang="en">Flag</com:Name>
          <com:Description xml:lang="en">Coded attribute in a data set that represents qualitative information for the cell or partial key (e.g. series) value.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="FREQ" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=SDMX:SDMX_CONCEPT_ROLES(1.0).FREQ">
          <com:Name xml:lang="en">Frequency</com:Name>
          <com:Description xml:lang="en">Time interval at which the source data are collected.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="ENTITY" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=SDMX:SDMX_CONCEPT_ROLES(1.0).ENTITY">
          <com:Name xml:lang="en">Entity</com:Name>
          <com:Description xml:lang="en">Describes the subject of the data set (e.g. a country).</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="COMMENT" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=SDMX:SDMX_CONCEPT_ROLES(1.0).COMMENT">
          <com:Name xml:lang="en">Comment</com:Name>
          <com:Description xml:lang="en">Descriptive text which can be attached to data or metadata.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="VARIABLE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=SDMX:SDMX_CONCEPT_ROLES(1.0).VARIABLE">
          <com:Name xml:lang="en">Variable</com:Name>
          <com:Description xml:lang="en">Characteristic of a unit being observed that may assume more than one of a set of values to which a numerical measure or a category from a classification can be assigned.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="OPERATION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=SDMX:SDMX_CONCEPT_ROLES(1.0).OPERATION">
          <com:Name xml:lang="en">Statistical operation</com:Name>
          <com:Description xml:lang="en">Signifies statistical operations have been done on the observations.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
      </str:ConceptScheme>
      <str:ConceptScheme urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.ConceptScheme=IMF:CS_MASTER_DATA(1.0.0)" agencyID="IMF" id="CS_MASTER_DATA" version="1.0.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Master Data Concepts</com:Name>
        <com:Description xml:lang="en">Standardized concepts and definitions for describing data elements across datasets, covering cross-cutting data attributes such as temporal information, country, unit of measure, transformation. </com:Description>
        <str:Concept id="COMMENTS" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).COMMENTS">
          <com:Name xml:lang="en">Comments</com:Name>
          <com:Description xml:lang="en">Additional notes, explanations, or remarks regarding the data, methodology, or other aspects of an observation.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="OBS_STATUS" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).OBS_STATUS">
          <com:Name xml:lang="en">Observation Status</com:Name>
          <com:Description xml:lang="en">Indicates the status of an observation within a dataset, such as whether it is a provisional value, an estimated value, a final figure, or a value where a time series break occurs. (Source: SDMX)</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_OBS_STATUS" version="1.1.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="DERIVATION_TYPE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).DERIVATION_TYPE">
          <com:Name xml:lang="en">Derivation Type</com:Name>
          <com:Description xml:lang="en">Identifies the specific method used to derive a new data element or indicator from source data. </com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_DERIVATION_TYPE" version="1.2.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="OVERLAP" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).OVERLAP">
          <com:Name xml:lang="en">IMF Data Overlap</com:Name>
          <com:Description xml:lang="en">Indicates the potential for overlap within IMF data.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_OVERLAP" version="1.0.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="CONF_STATUS" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).CONF_STATUS">
          <com:Name xml:lang="en">Confidentiality Status</com:Name>
          <com:Description xml:lang="en">This classification provides information about the sensitivity and confidentiality status of the data. (Source:SDMX)</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_CONF_STATUS" version="1.0.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="REPORTING_PERIOD_TYPE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).REPORTING_PERIOD_TYPE">
          <com:Name xml:lang="en">Reporting Period Type</com:Name>
          <com:Description xml:lang="en">It is used to identify and distinguish between different types of time periods in economic and financial reporting.  The specific start and end dates for a fiscal year (FY) can vary depending on the country, organization, or industry. When reporting data using this codelist, it is essential to specify the exact start and end dates of the fiscal year being referenced.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_REPORTING_PERIOD_TYPE" version="1.4.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="REFERENCE_PERIOD" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).REFERENCE_PERIOD">
          <com:Name xml:lang="en">Reference Period</com:Name>
          <com:Description xml:lang="en">A time interval defined by a start date and an end date, used to constrain and specify the timeframe for reporting data. </com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="BASE_YEAR" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).BASE_YEAR">
          <com:Name xml:lang="en">Base year</com:Name>
          <com:Description xml:lang="en">The reference year used for comparison in the calculation of index numbers or other statistical measures. Changes in values over time are typically expressed as percentage deviations from the base year.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="CALENDAR_YEAR" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).CALENDAR_YEAR">
          <com:Name xml:lang="en">Calendar year</com:Name>
          <com:Description xml:lang="en">A period of twelve consecutive months starting on January 1st and ending on December 31st, as per the Gregorian calendar.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="FISCAL_YEAR" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).FISCAL_YEAR">
          <com:Name xml:lang="en">Fiscal year</com:Name>
          <com:Description xml:lang="en">A twelve-month period used by governments and businesses for accounting and financial reporting purposes. The start and end dates of a fiscal year can vary depending on the organization and country but often differ from the calendar year.</com:Description>
          <str:CoreRepresentation>
            <str:TextFormat textType="String"/>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="COUNTRY" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).COUNTRY">
          <com:Annotations>
            <com:Annotation id="indexed">
              <com:AnnotationType>INDEX_CONCEPTS</com:AnnotationType>
            </com:Annotation>
          </com:Annotations>
          <com:Name xml:lang="en">Country</com:Name>
          <com:Description xml:lang="en">The country or region for which the data or statistics in a resource are collected or reported.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_COUNTRY" version="1.6.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="COUNTERPART_COUNTRY" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).COUNTERPART_COUNTRY">
          <com:Name xml:lang="en">Counterpart Country</com:Name>
          <com:Description xml:lang="en">The country or region with which a transaction or interaction occurs in the context of international statistics or data.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_COUNTRY" version="1.6.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="UNIT" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).UNIT">
          <com:Name xml:lang="en">Unit of Measure</com:Name>
          <com:Description xml:lang="en">The standard unit used to quantify a particular data element or indicator.I It encompasses various units, including currency, physical units, percentages, and other standardized measures.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_UNIT" version="2.13.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="CURRENCY" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).CURRENCY">
          <com:Name xml:lang="en">Currency</com:Name>
          <com:Description xml:lang="en">Denominated in Currency specifies the currency in which a financial instrument is valued and settled.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_CURRENCY" version="2.3.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="TRANSFORMATION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).TRANSFORMATION">
          <com:Name xml:lang="en">Transformation</com:Name>
          <com:Description xml:lang="en">Represents a set of codes identifying the specific transformations or calculations applied to source data to derive new data elements or indicators. A transformation involves a computation with one or more input values (either base variables obtained by observation or derived variables from prior transformations) that results in a single output value (the value of a new derived variable).</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_TRANSFORMATION" version="2.21.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="S_ADJUSTMENT" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).S_ADJUSTMENT">
          <com:Name xml:lang="en">Seasonal Adjustment</com:Name>
          <com:Description xml:lang="en">Specific adjustment for the time series (e.g. seasonally adjusted).</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_S_ADJUSTMENT" version="1.0.2" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="GENDER" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).GENDER">
          <com:Name xml:lang="en">Gender</com:Name>
          <com:Description xml:lang="en">Gender identity refers to each person’s internal and individual experience of gender. One's gender identity can be the same or different from their sex assigned at birth. (Source: UNECE 2023 Gender and salutation code lists)</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_GENDER" version="1.0.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="SEX" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).SEX">
          <com:Name xml:lang="en">Sex</com:Name>
          <com:Description xml:lang="en">An individual’s sex may be defined by one’s assigned sex at birth and/or one’s biological attributes which includes a combination of hormones, chromosomes, physiology, and anatomy. It  includes both binary options as well as X and intersex. (Source: UNECE 2023 Gender and salutation code lists)</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_SEX" version="1.1.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="CIVIL_STATUS" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DATA(1.0.0).CIVIL_STATUS">
          <com:Name xml:lang="en">Civil (or Marital) Status</com:Name>
          <com:Description xml:lang="en">The legal status of an individual regarding marriage, such as single, married, widowed, or divorced.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_CIVIL_STATUS" version="1.0.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
      </str:ConceptScheme>
      <str:ConceptScheme urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.ConceptScheme=IMF:CS_MASTER_DOMAIN(1.0.0)" agencyID="IMF" id="CS_MASTER_DOMAIN" version="1.0.0" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Master Domain Concepts</com:Name>
        <com:Description xml:lang="en">Standardized definitions for data elements specific to particular domains or subject areas. This includes concepts and attributes related to macroeconomics, finance, socio-demographics, and other specialized fields.</com:Description>
        <str:Concept id="ACCOUNTING_ENTRY" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).ACCOUNTING_ENTRY">
          <com:Name xml:lang="en">Accounting Entry</com:Name>
          <com:Description xml:lang="en">A classification that identifies whether a transaction represents a use of resources, a source of funds, an asset, a liability, or a change in equity.  </com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_ACCOUNTING_ENTRY" version="2.2.2" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="COMMODITY" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).COMMODITY">
          <com:Name xml:lang="en">Commodity</com:Name>
          <com:Description xml:lang="en"> Comprehensive list of all the different commodity codes used in IMF.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_COMMODITY" version="2.2.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="SECTOR" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).SECTOR">
          <com:Name xml:lang="en">Sector</com:Name>
          <com:Description xml:lang="en">A classification of economic entities based on their primary function and economic behavior, such as households, corporations, government, or non-profit institutions.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_SECTOR" version="2.13.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="COUNTERPART_SECTOR" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).COUNTERPART_SECTOR">
          <com:Name xml:lang="en">Counterpart Sector</com:Name>
          <com:Description xml:lang="en">In the context of a specific transaction or economic flow, the counterpart sector refers to the institutional sector on the opposite side of the transaction.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_SECTOR" version="2.13.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="EXRATE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).EXRATE">
          <com:Name xml:lang="en">Exchange Rate</com:Name>
          <com:Description xml:lang="en">Represents a set of codes identifying the exchange rate between two currencies. An exchange rate indicates how much of one currency is needed to buy one unit of another currency.  It is derived by comparing the value of one currency to another, often influenced by economic factors like interest rates, inflation, and government policy. This codelist includes various exchange rate calculations, such as period averages, pre-Euro rates, and those involving Special Drawing Rights (SDRs).</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_EXRATE" version="1.2.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="FLOW_STOCK_ENTRY" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).FLOW_STOCK_ENTRY">
          <com:Name xml:lang="en">Flow or stock entry</com:Name>
          <com:Description xml:lang="en">A classification that indicates whether a data point represents a flow (a quantity measured over a period of time) or a stock (a quantity measured at a specific point in time).</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_FSENTRY" version="2.2.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="FUNCTIONAL_CAT" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).FUNCTIONAL_CAT">
          <com:Name xml:lang="en">Functional category</com:Name>
          <com:Description xml:lang="en">A classification used to categorize investments based on their purpose or function, such as equity investments, debt investments, or other investments.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_FUNCTIONAL_CAT" version="2.4.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="GFS_STO" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).GFS_STO">
          <com:Name xml:lang="en">GFS Stocks, Transactions, Other Flows</com:Name>
          <com:Description xml:lang="en">A classification of data items used in the Government Finance Statistics (GFS) framework, distinguishing between stocks (levels at a point in time), transactions (changes over a period), and other flows.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_GFS_STO" version="2.9.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="INDEX_TYPE" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).INDEX_TYPE">
          <com:Name xml:lang="en">Index type</com:Name>
          <com:Description xml:lang="en">Type of index prices. </com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_INDEX_TYPE" version="2.6.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="INT_TTC" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).INT_TTC">
          <com:Name xml:lang="en">Interest Rate types, Terms and Conditions</com:Name>
          <com:Description xml:lang="en">A classification of interest rates based on their type (fixed or floating), terms (maturity), and other conditions (e.g., collateralization, reference rates).</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_INT_TTC" version="2.7.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="INSTR_ASSET" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).INSTR_ASSET">
          <com:Name xml:lang="en">Instrument and Assets Classification</com:Name>
          <com:Description xml:lang="en">Because of the symmetry of financial assets and liabilities, the term ‘instrument’ is used to relate to both the asset and the liability aspect of financial transactions, other flows and financial balance sheets.  (Source: Handbook of National Accounting, 2013)</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_INSTR_ASSET" version="2.15.2" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="INT_ACC_ITEM" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).INT_ACC_ITEM">
          <com:Name xml:lang="en">International Accounts Item</com:Name>
          <com:Description xml:lang="en">A classification of transactions in the balance of payments, such as trade in goods, services, income, and financial flows.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_INT_ACC_ITEM" version="2.8.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="ACCOUNTS" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).ACCOUNTS">
          <com:Name xml:lang="en">Macroeconomic and Financial Accounts</com:Name>
          <com:Description xml:lang="en">A framework for organizing macroeconomic and financial data into a set of integrated accounts and tables that provide a comprehensive overview of an economy.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_ACCOUNTS" version="2.5.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="FI_MATURITY" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).FI_MATURITY">
          <com:Name xml:lang="en">Maturity of Financial Instrument</com:Name>
          <com:Description xml:lang="en">A classification of financial instruments based on their remaining time to maturity or expiration.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_FI_MATURITY" version="2.1.2" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="MFS_INSTR" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).MFS_INSTR">
          <com:Name xml:lang="en">Monetary and Financial Instruments</com:Name>
          <com:Description xml:lang="en">A classification of financial instruments used in monetary and financial statistics, including currency, deposits, loans, securities, and derivatives.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_MFS_INSTR" version="2.7.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="NA_STO" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).NA_STO">
          <com:Name xml:lang="en">Stocks, Transactions, Other Flows</com:Name>
          <com:Description xml:lang="en">A classification of data items used in the System of National Accounts (SNA) framework, distinguishing between stocks (levels at a point in time), transactions (changes over a period), and other flows.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_NA_STO" version="2.5.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="PRICES" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).PRICES">
          <com:Name xml:lang="en">Prices</com:Name>
          <com:Description xml:lang="en">Represents different types of prices or price adjustments, including those that have been adjusted for inflation (real or constant prices) and those that have not (nominal or current prices). It also includes various methods for adjusting prices for inflation, such as using deflators or converting to a constant base period.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_PRICES" version="2.3.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="STATISTICAL_MEASURES" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).STATISTICAL_MEASURES">
          <com:Name xml:lang="en">Statistical Measures</com:Name>
          <com:Description xml:lang="en">Describe characteristics of a group of data. They summarize the distribution, central tendency, or spread of multiple values.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_STATISTICAL_MEASURES" version="1.7.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="TRADE_FLOW" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).TRADE_FLOW">
          <com:Name xml:lang="en">Trade flow</com:Name>
          <com:Description xml:lang="en">Data related to the movement of goods and services between countries, including exports and imports.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_TRADE_FLOW" version="2.1.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="VALUATION" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).VALUATION">
          <com:Name xml:lang="en">Valuation</com:Name>
          <com:Description xml:lang="en">Valuation refers to the rules and conventions used for recording monetary flows and stocks in macroeconomic statistics. Standard national accounts valuations include the basic price (what the seller receives) and the purchaser's price (what the purchaser pays). The purchaser's price is the basic price, plus taxes less subsidies on products, plus invoiced transportation and insurance services, plus distribution margin. International trade in goods considers the free on board (fob) price and cost-insurance-freight price, among others. Other valuation types include prices used in financial markets (e.g., buy and sell prices).</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_VALUATION" version="2.4.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="SOC_CONCEPTS" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).SOC_CONCEPTS">
          <com:Name xml:lang="en">Social Concepts</com:Name>
          <com:Description xml:lang="en">A broad category encompassing various social indicators, such as tourism and labor concepts.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_SOC_CONCEPTS" version="1.3.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="COFOG" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).COFOG">
          <com:Name xml:lang="en">COFOG</com:Name>
          <com:Description xml:lang="en">The Classification of the Functions of Government, a standardized system for classifying government expenditures by purpose.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_COFOG" version="2.0.0" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="COICOP_1999" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).COICOP_1999">
          <com:Name xml:lang="en">Expenditure Category</com:Name>
          <com:Description xml:lang="en">The Classification of Individual Consumption According to Purpose (COICOP) 1999 is a standardized classification system developed by the United Nations Statistics Division to categorize household consumption expenditures by purpose. It includes 14 divisions, 47 groups, and 117 classes.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_COICOP_1999" version="1.1.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
        <str:Concept id="COICOP_2018" urn="urn:sdmx:org.sdmx.infomodel.conceptscheme.Concept=IMF:CS_MASTER_DOMAIN(1.0.0).COICOP_2018">
          <com:Name xml:lang="en">Expenditure Category (COICOP 2018)</com:Name>
          <com:Description xml:lang="en">The Classification of Individual Consumption According to Purpose (COICOP) 2018 is an updated and expanded version of the COICOP classification system, designed to better reflect the evolving consumption patterns of the 21st century. It includes 14 divisions, 50 groups, 153 classes, and 449 subclasses.</com:Description>
          <str:CoreRepresentation>
            <str:Enumeration>
              <Ref agencyID="IMF" id="CL_COICOP_2018" version="1.0.1" package="codelist" class="Codelist"/>
            </str:Enumeration>
          </str:CoreRepresentation>
        </str:Concept>
      </str:ConceptScheme>
