          <com:Name xml:lang="es">Departamento de Servicios Corporativos e Instalaciones (CSF)</com:Name>
          <com:Name xml:lang="zh">企业服务和设施部 (Qǐyè fúwù hé shèshī bù)</com:Name>
        </str:Code>
        <str:Code id="DMD" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DEPARTMENT(1.0.2).DMD">
          <com:Name xml:lang="ar">مكتب نائب المدير العام (DMD)</com:Name>
          <com:Name xml:lang="ru">Канцелярия заместителя управляющего директора (DMD)</com:Name>
