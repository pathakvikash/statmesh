      <str:Codelist urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=IMF:CL_DEPARTMENT(1.0.2)" agencyID="IMF" id="CL_DEPARTMENT" version="1.0.2" isFinal="true" isExternalReference="false" isPartial="false">
        <com:Annotations>
          <com:Annotation id="origin"/>
          <com:Annotation id="isFinal"/>
          <com:Annotation id="lastUpdatedAt"/>
        </com:Annotations>
        <com:Name xml:lang="en">Department</com:Name>
        <com:Description xml:lang="en">This codelist identifies the internal departments or organizational units within an institution (e.g., the IMF) that are primarily responsible for the creation, maintenance, or dissemination of a specific data resource.</com:Description>
        <str:Code id="AFR" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DEPARTMENT(1.0.2).AFR">
          <com:Name xml:lang="ar">الإدارة الأفريقية (AFR)</com:Name>
          <com:Name xml:lang="ru">Африканский департамент (AFR)</com:Name>
          <com:Name xml:lang="pt">Departamento Africano (AFR)</com:Name>
