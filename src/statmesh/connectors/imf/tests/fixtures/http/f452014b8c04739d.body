          <com:Name xml:lang="en">Communications Department (COM)</com:Name>
          <com:Name xml:lang="fr">Département de la communication (COM)</com:Name>
          <com:Name xml:lang="es">Departamento de Comunicaciones (COM)</com:Name>
          <com:Name xml:lang="zh">传播部 (Chuánbō Bù)</com:Name>
        </str:Code>
        <str:Code id="CSF" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=IMF:CL_DEPARTMENT(1.0.2).CSF">
          <com:Name xml:lang="ar">إدارة الخدمات المؤسسية والمرافق (CSF)</com:Name>
          <com:Name xml:lang="ru">Департамент корпоративных услуг и объектов (CSF)</com:Name>
          <com:Name xml:lang="pt">Departamento de Serviços Corporativos e Instalações (CSF)</com:Name>
