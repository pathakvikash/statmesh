        <com:Name xml:lang="en">Currency Composition of the International Investment Position (IIPCC)</com:Name>
        <com:Description xml:lang="en">The Currency Composition of International Investment Positions dataset provides a snapshot of the currency breakdown of a country's foreign financial assets and liabilities at a specific date. This includes debt, financial derivatives, and reserve-related assets and liabilities, categorized by sector and currency (domestic, US dollar, Euro, Yen, and others). This data complements the standard International Investment Position (IIP) statistics.</com:Description>
        <str:Structure>
          <Ref agencyID="IMF.STA" id="DSD_IIPCC" version="16.0.0" package="datastructure" class="DataStructure"/>
        </str:Structure>
      </str:Dataflow>
