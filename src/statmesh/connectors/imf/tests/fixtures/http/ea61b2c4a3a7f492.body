        <com:Name xml:lang="en">Structural Reform Database (SRD)</com:Name>
        <com:Description xml:lang="en">The SRD contains data on a wide range of structural policies across different countries. These policies are things that affect how markets function, like labor laws, regulations on businesses, and trade policies.</com:Description>
        <str:Structure>
          <Ref agencyID="IMF.RES" id="DSD_SRD" version="1.0.0" package="datastructure" class="DataStructure"/>
        </str:Structure>
