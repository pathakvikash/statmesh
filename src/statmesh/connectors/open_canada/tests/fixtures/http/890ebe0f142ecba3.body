{"help": "https://open.canada.ca/data/api/3/action/help_show?name=package_search", "success": true, "result": {"count": 15895, "facets": {}, "facet_ranges": {"portal_release_date": {"counts": ["1926-11-19T00:00:00Z", 3353], "gap": "+100YEARS", "start": "1926-11-19T00:00:00Z", "end": "2126-11-19T00:00:00Z"}}, "facet_queries": {}, "results": [{"association_type": [], "audience": [], "author": null, "author_email": null, "collection": "primary", "contributor": {"fr": "", "en": ""}, "creator": "", "creator_user_id": "4cfa9a9c-1d95-40eb-86f9-bc0c8ec45d1f", "data_series_issue_identification": {"fr": "", "en": ""}, "data_series_name": {"fr": "", "en": ""}, "date_published": "2019-02-11 00:00:00", "digital_object_identifier": "", "display_flags": [], "frequency": "P1D", "geographic_region": [], "id": "933c7f9d-deb0-4367-940d-06c38f494153", "imso_approval": "true", "isopen": false, "jurisdiction": "federal", "keywords": {"fr": ["minist\u00e8res"], "en": ["departments"]}, "license_id": "ca-ogl-lgo", "license_title": "Open Government Licence - Canada", "license_url": "https://open.canada.ca/en/open-government-licence-canada", "maintainer": null, "maintainer_email": "ian.ward@tbs-sct.gc.ca", "metadata_created": "2019-02-11T21:30:28.918018", "metadata_modified": "2026-11-19T06:52:31.389957", "name": "933c7f9d-deb0-4367-940d-06c38f494153", "notes": "List of departments and organizations registered on the Open Government Portal. Columns include:\r\n\r\n* `uuid`\r\n* `title_en`: Title in English\r\n* `title_fr`: Title in French\r\n* `short_form_en`: Short form in English\r\n* `short_form_fr`: Short form in French\r\n* `department_number`: Historical department number\r\n* `umd_number`: Unified department number\r\n* `open_canada_id`: Department identifier on https://open.canada.ca", "notes_translated": {"fr": "Liste des minist\u00e8res et organismes inscrits sur le Portail ouvert aux gouvernements. Les colonnes incluent :\r\n\r\n* `uuid`\r\n* `title_fr` : Titre en fran\u00e7ais\r\n* `title_fr` : Titre en fran\u00e7ais\r\n* `short_form_fr` : Formulaire abr\u00e9g\u00e9 en anglais\r\n* `short_form_fr` : Version abr\u00e9g\u00e9e en fran\u00e7ais\r\n* `department_number` : num\u00e9ro du d\u00e9partement historique\r\n* `umd_number` : Num\u00e9ro de d\u00e9partement unifi\u00e9\r\n* `open_canada_id` : Identificateur du minist\u00e8re sur https://ouvert.canada.ca", "en": "List of departments and organizations registered on the Open Government Portal. Columns include:\r\n\r\n* `uuid`\r\n* `title_en`: Title in English\r\n* `title_fr`: Title in French\r\n* `short_form_en`: Short form in English\r\n* `short_form_fr`: Short form in French\r\n* `department_number`: Historical department number\r\n* `umd_number`: Unified department number\r\n* `open_canada_id`: Department identifier on https://open.canada.ca"}, "num_resources": 1, "num_tags": 0, "org_section": {"fr": "", "en": ""}, "org_title_at_publication": {"fr": "Secr\u00e9tariat du Conseil du Tr\u00e9sor du Canada", "en": "Treasury Board of Canada Secretariat"}, "organization": {"id": "81765FCD-32B3-4708-A593-3AA00705E62B", "name": "tbs-sct", "title": "Treasury Board of Canada Secretariat | Secr\u00e9tariat du Conseil du Tr\u00e9sor du Canada", "type": "organization", "description": "", "image_url": "", "created": "2016-09-23T17:26:17.294681", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "81765FCD-32B3-4708-A593-3AA00705E62B", "place_of_publication": [], "portal_release_date": "2019-02-11", "private": false, "program_page_url": {"fr": "", "en": ""}, "ready_to_publish": "true", "restrictions": "unrestricted", "spatial": "", "spatial_representation_type": [], "state": "active", "subject": ["government_and_politics"], "title": "Open Government Portal Department List", "title_translated": {"fr": "Liste des minist\u00e8res du portail du gouvernement ouvert", "en": "Open Government Portal Department List"}, "topic_category": [], "type": "dataset", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "character_set": "UTF-8", "created": "2019-02-11T21:30:29.387875", "data_quality": [], "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "date_published": "", "description": null, "format": "CSV", "hash": "303dc59fca8af9c5664b8094fbe42715", "id": "04cbec5c-5a3d-4d34-927d-e41c9e6e3736", "ignore_hash": false, "language": ["en", "fr"], "last_modified": "2026-11-19T06:10:06.222397", "metadata_modified": "2026-11-19T06:12:24.731905", "mimetype": null, "mimetype_inner": null, "name": "Government of Canada Department List", "name_translated": {"fr": "Liste des minist\u00e8res du gouvernement du Canada", "en": "Government of Canada Department List"}, "original_url": "/dataset/933c7f9d-deb0-4367-940d-06c38f494153/resource/04cbec5c-5a3d-4d34-927d-e41c9e6e3736/download/orgs.csv", "package_id": "933c7f9d-deb0-4367-940d-06c38f494153", "position": 0, "resource_id": "04cbec5c-5a3d-4d34-927d-e41c9e6e3736", "resource_type": "dataset", "set_url_type": false, "size": 47221, "state": "active", "task_created": "2026-10-14 06:10:40.260378", "unique_identifier": "", "url": "/data/dataset/933c7f9d-deb0-4367-940d-06c38f494153/resource/04cbec5c-5a3d-4d34-927d-e41c9e6e3736/download/orgs.csv", "url_type": "upload", "validation_status": "success", "validation_timestamp": "2026-11-19T06:10:14.841024"}], "tags": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}, {"association_type": [], "audience": ["business", "educators", "general_public", "government", "media", "nongovernmental_organizations"], "author": null, "author_email": null, "collection": "primary", "contributor": {"en": "", "fr": ""}, "creator": "", "creator_user_id": "4cfa9a9c-1d95-40eb-86f9-bc0c8ec45d1f", "data_series_issue_identification": {"en": "", "fr": ""}, "data_series_name": {"en": "Government of Canada - Consultations", "fr": "Gouvernement du Canada - Consultations "}, "date_published": "2018-11-26 00:00:00", "digital_object_identifier": "", "display_flags": [], "frequency": "continual", "geographic_region": [], "id": "7c03f039-3753-4093-af60-74b0f7b2385d", "imso_approval": "true", "isopen": false, "jurisdiction": "federal", "keywords": {"en": ["Public engagement", "Consultations", "Open dialogue"], "fr": ["Mobilisation du public", "Consultations", "Dialogue ouvert"]}, "license_id": "ca-ogl-lgo", "license_title": "Open Government Licence - Canada", "license_url": "https://open.canada.ca/en/open-government-licence-canada", "maintainer": null, "maintainer_email": "consultation@pco-bcp.gc.ca", "metadata_created": "2018-11-26T22:00:35.138219", "metadata_modified": "2026-11-19T06:52:29.808630", "name": "7c03f039-3753-4093-af60-74b0f7b2385d", "notes": "**This dataset consolidates all the consultations submitted by departments and agencies in the Government of Canada.**\r\n\r\nPlease note that consultations that were entered before January 2018 may be missing information such as description and subject(s). In spring of 2018, consultation information from Government of Canada departments and agencies was migrated to this dataset and new values and fields were added.", "notes_translated": {"en": "**This dataset consolidates all the consultations submitted by departments and agencies in the Government of Canada.**\r\n\r\nPlease note that consultations that were entered before January 2018 may be missing information such as description and subject(s). In spring of 2018, consultation information from Government of Canada departments and agencies was migrated to this dataset and new values and fields were added.", "fr": "**Cette base de donn\u00e9es regroupe toutes les consultations soumises par les minist\u00e8res et agences du Gouvernement du Canada.**\r\n\r\nRemarque : Vous remarquerez peut-\u00eatre des renseignements manquants (description, sujet, etc.) pour les consultations entr\u00e9es dans le syst\u00e8me avant janvier 2018. C\u2019est qu\u2019au printemps 2018, les renseignements sur les consultations des minist\u00e8res et organismes f\u00e9d\u00e9raux ont \u00e9t\u00e9 transf\u00e9r\u00e9s dans ce jeu de donn\u00e9es et de nouveaux champs et de nouvelles valeurs ont \u00e9t\u00e9 ajout\u00e9s."}, "num_resources": 4, "num_tags": 0, "org_section": {"en": "Consultations and Public Engagement ", "fr": "Communications et Mobilisations du public"}, "org_title_at_publication": {"en": "Privy Council Office", "fr": "Bureau du Conseil priv\u00e9"}, "organization": {"id": "26DF0856-0FA2-404C-87E9-21443F333990", "name": "pco-bcp", "title": "Privy Council Office | Bureau du Conseil priv\u00e9", "type": "organization", "description": "", "image_url": "", "created": "2016-09-23T17:25:56.403987", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "26DF0856-0FA2-404C-87E9-21443F333990", "place_of_publication": ["0", "3506"], "portal_release_date": "2018-11-26", "private": false, "program_page_url": {"en": "https://www.canada.ca/en/government/system/consultations/consultingcanadians.html", "fr": "https://www.canada.ca/fr/gouvernement/systeme/consultations/consultationdescanadiens.html"}, "ready_to_publish": "true", "restrictions": "unrestricted", "spatial": "", "spatial_representation_type": [], "state": "active", "subject": ["government_and_politics"], "time_period_coverage_start": "2016-04-01 00:00:00", "title": "Government of Canada - Consultations", "title_translated": {"en": "Government of Canada - Consultations", "fr": "Gouvernement du Canada - Consultations "}, "topic_category": [], "type": "dataset", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "character_set": "UTF-8", "created": "2019-02-05T15:21:04.591199", "data_quality": ["data_includes_links"], "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "date_published": "2018-11-26", "description": null, "format": "CSV", "hash": "a53df19d130cf7d4f455bdf1e081359b", "id": "92bec4b7-6feb-4215-a5f7-61da342b2354", "ignore_hash": false, "language": ["en", "fr"], "last_modified": "2026-11-18T21:43:06.110167", "metadata_modified": "2026-11-18T21:52:20.680656", "mimetype": null, "mimetype_inner": null, "name": "Consultations - All ", "name_translated": {"fr": "Consultations - Toutes", "en": "Consultations - All "}, "original_url": "/dataset/7c03f039-3753-4093-af60-74b0f7b2385d/resource/92bec4b7-6feb-4215-a5f7-61da342b2354/download/consultations.csv", "package_id": "7c03f039-3753-4093-af60-74b0f7b2385d", "position": 0, "resource_id": "92bec4b7-6feb-4215-a5f7-61da342b2354", "resource_type": "dataset", "set_url_type": false, "size": 6792419, "state": "active", "task_created": "2026-11-18 21:43:13.741059", "unique_identifier": "", "url": "/data/dataset/7c03f039-3753-4093-af60-74b0f7b2385d/resource/92bec4b7-6feb-4215-a5f7-61da342b2354/download/consultations.csv", "url_type": "upload", "validation_status": "success", "validation_timestamp": "2026-11-18T21:43:12.438064"}, {"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-02-10T14:21:58.312063", "data_quality": [], "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": null, "format": "JSON", "hash": "", "id": "0c7b6e2d-2887-484a-a385-34536e6cdb6f", "language": ["en", "fr"], "last_modified": null, "metadata_modified": "2026-08-07T16:52:00.913666", "mimetype": null, "mimetype_inner": null, "name": "Data Schema", "name_translated": {"en": "Data Schema", "fr": "Sch\u00e9ma"}, "package_id": "7c03f039-3753-4093-af60-74b0f7b2385d", "position": 1, "resource_type": "specification", "state": "active", "unique_identifier": "", "url": "https://open.canada.ca/data/recombinant-published-schema/consultations.json", "url_type": "", "validation_status": "", "validation_timestamp": "", "relationship": [{"related_relationship": "defines", "related_url": {"en": "https://open.canada.ca/data/en/dataset/7c03f039-3753-4093-af60-74b0f7b2385d/resource/92bec4b7-6feb-4215-a5f7-61da342b2354", "fr": "https://ouvert.canada.ca/data/fr/dataset/7c03f039-3753-4093-af60-74b0f7b2385d/resource/92bec4b7-6feb-4215-a5f7-61da342b2354"}, "resource_type": "dataset"}]}, {"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2019-02-04T15:40:41.694560", "data_quality": [], "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": null, "format": "XLSX", "hash": "", "id": "334ecc4d-ce7e-4a8e-93c3-a89ee7c1efe9", "language": ["en", "fr"], "last_modified": null, "metadata_modified": "2026-08-07T16:52:00.913717", "mimetype": null, "mimetype_inner": null, "name": "Data Dictionary", "name_translated": {"en": "Data Dictionary", "fr": "Dictionnaire de donn\u00e9es"}, "package_id": "7c03f039-3753-4093-af60-74b0f7b2385d", "position": 2, "resource_type": "data_dictionary", "size": 23006, "state": "active", "unique_identifier": "", "url": "https://open.canada.ca/data/recombinant-published-dictionary/consultations", "url_type": "", "validation_status": "failure", "validation_timestamp": "2023-12-08T07:12:32.138236"}, {"cache_last_updated": null, "cache_url": null, "character_set": "UTF-8", "created": "2019-03-01T16:33:04.753752", "data_quality": [], "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": null, "format": "CSV", "hash": "", "id": "aa606d25-4387-4bc6-89eb-12d66f5e9044", "language": ["en", "fr"], "last_modified": "2026-11-18T21:42:01", "metadata_modified": "2026-11-18T21:52:20.680828", "mimetype": null, "mimetype_inner": null, "name": "Consultations - Last two years", "name_translated": {"fr": "Consultations - Deux derni\u00e8res ann\u00e9es", "en": "Consultations - Last two years"}, "package_id": "7c03f039-3753-4093-af60-74b0f7b2385d", "position": 3, "resource_type": "dataset", "state": "active", "unique_identifier": "", "url": "https://open.canada.ca/static/current_consultations_open.csv", "url_type": null}], "tags": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}, {"association_type": [], "audience": ["government"], "author": null, "author_email": null, "collection": "primary", "contributor": {"en": "", "fr": ""}, "creator": "", "creator_user_id": "2dc5a12f-2a6f-4822-8514-165ea6bb05d9", "data_series_issue_identification": {"en": "", "fr": ""}, "data_series_name": {"en": "", "fr": ""}, "date_published": "2026-11-17 00:00:00", "digital_object_identifier": "", "display_flags": [], "frequency": "as_needed", "geographic_region": [], "id": "acf1b0f9-1c52-43f2-8729-db918d769873", "imso_approval": "true", "isopen": false, "jurisdiction": "federal", "keywords": {"en": ["data maturity", "data management", "data governance", "self-assessment", "maturity model", "Government of Canada"], "fr": ["maturit\u00e9 des donn\u00e9es", "gestion des donn\u00e9es", "gouvernance des donn\u00e9es", "auto\u00e9valuation", "mod\u00e8le de maturit\u00e9", "gouvernement du Canada"]}, "license_id": "ca-ogl-lgo", "license_title": "Open Government Licence - Canada", "license_url": "https://open.canada.ca/en/open-government-licence-canada", "maintainer": null, "maintainer_email": "gcdc-cdgc@csps-efpc.gc.ca", "metadata_created": "2026-11-18T20:12:15.990319", "metadata_modified": "2026-11-19T06:52:26.839565", "name": "acf1b0f9-1c52-43f2-8729-db918d769873", "notes": "The Data Maturity Assessment Tool (DMAT) is a voluntary, non-proprietary assessment developed by the Canada School of Public Service (CSPS) for the Government of Canada. DMAT is designed to help federal organizations evaluate their current data capabilities, identify priorities for improvement, and inform organizational planning. The DMAT was developed under the leadership of the GC Data Community (GCDC) in collaboration with more than 20 partner organizations, and its framing aligns with the 2023\u20132026 Data Strategy for the Federal Public Service.\r\n\r\nThe assessment contains four pillars of activity with 244 components:\r\n\r\n- Governance: rules and resourcing, decision-making and authorities\r\n- Practices: operations and implementation, stewardship of data assets\r\n- People: talent management, skills development\r\n- Tools: software and hardware, systems and storage\r\n\r\nComponents are organized hierarchically in up to four levels: high-level assessment areas (Level 1), sub-components (Level 2), detailed requirements (Level 3), and specific indicators and evidence questions (Level 4). Each component is linked to its sub-pillar and, where applicable, to the relevant Government of Canada policy instrument. Components marked \u201cM\u201d reflect mandatory policy requirements; the others are maturity indicators and leading practices.\r\n\r\nThe Excel (XLS) version is an interactive tool. Users answer each component Yes or No from a drop-down menu, and scores update automatically. A lower-level component counts toward the score only if its parent component is answered Yes. Each Level 1 component is worth 1 point, and lower-level components receive a proportional share of their parents\u2019 value. Pillar scores are normalized to 100%, regardless of how many components each pillar contains. Results are displayed as percentage scores for each pillar and overall, along with a spider graph of pillar-level maturity. Responses should reflect current documented practices, supported by evidence where possible.\r\n\r\nThe assessment is designed for departments and agencies of all sizes. It is best completed collaboratively by teams responsible for data governance, data management, analytics, digital transformation, information management, and business operations. Organizations retain ownership of their results, which are not shared with the GC Data Community, other departments, or the public. Organizations are encouraged to reassess periodically, for example, annually or as part of planning cycles, to monitor progress. Results should always be interpreted within the context of an organization's mandate, operating environment, size, and level of complexity.\r\n\r\nThe CSV files contain the assessment components, the points assigned to each component, the user instructions and a legend of acronyms, column definitions and methodology notes.", "notes_translated": {"en": "The Data Maturity Assessment Tool (DMAT) is a voluntary, non-proprietary assessment developed by the Canada School of Public Service (CSPS) for the Government of Canada. DMAT is designed to help federal organizations evaluate their current data capabilities, identify priorities for improvement, and inform organizational planning. The DMAT was developed under the leadership of the GC Data Community (GCDC) in collaboration with more than 20 partner organizations, and its framing aligns with the 2023\u20132026 Data Strategy for the Federal Public Service.\r\n\r\nThe assessment contains four pillars of activity with 244 components:\r\n\r\n- Governance: rules and resourcing, decision-making and authorities\r\n- Practices: operations and implementation, stewardship of data assets\r\n- People: talent management, skills development\r\n- Tools: software and hardware, systems and storage\r\n\r\nComponents are organized hierarchically in up to four levels: high-level assessment areas (Level 1), sub-components (Level 2), detailed requirements (Level 3), and specific indicators and evidence questions (Level 4). Each component is linked to its sub-pillar and, where applicable, to the relevant Government of Canada policy instrument. Components marked \u201cM\u201d reflect mandatory policy requirements; the others are maturity indicators and leading practices.\r\n\r\nThe Excel (XLS) version is an interactive tool. Users answer each component Yes or No from a drop-down menu, and scores update automatically. A lower-level component counts toward the score only if its parent component is answered Yes. Each Level 1 component is worth 1 point, and lower-level components receive a proportional share of their parents\u2019 value. Pillar scores are normalized to 100%, regardless of how many components each pillar contains. Results are displayed as percentage scores for each pillar and overall, along with a spider graph of pillar-level maturity. Responses should reflect current documented practices, supported by evidence where possible.\r\n\r\nThe assessment is designed for departments and agencies of all sizes. It is best completed collaboratively by teams responsible for data governance, data management, analytics, digital transformation, information management, and business operations. Organizations retain ownership of their results, which are not shared with the GC Data Community, other departments, or the public. Organizations are encouraged to reassess periodically, for example, annually or as part of planning cycles, to monitor progress. Results should always be interpreted within the context of an organization's mandate, operating environment, size, and level of complexity.\r\n\r\nThe CSV files contain the assessment components, the points assigned to each component, the user instructions and a legend of acronyms, column definitions and methodology notes.", "fr": "L\u2019outil d\u2019\u00e9valuation du niveau de maturit\u00e9 en mati\u00e8re de donn\u00e9es (OEMD) est une ressource non exclusive \u00e0 utilisation volontaire con\u00e7ue par l\u2019\u00c9cole de la fonction publique du Canada pour le gouvernement du Canada. Il vise \u00e0 aider les organisations f\u00e9d\u00e9rales \u00e0 \u00e9valuer leurs capacit\u00e9s actuelles en mati\u00e8re de donn\u00e9es, \u00e0 cibler des priorit\u00e9s d\u2019am\u00e9lioration et \u00e0 orienter la planification organisationnelle. Cet outil, dont le cadre est align\u00e9 sur la Strat\u00e9gie relative aux donn\u00e9es de 2023-2026 pour la fonction publique f\u00e9d\u00e9rale, a \u00e9t\u00e9 cr\u00e9\u00e9 sous la direction de la Communaut\u00e9 des donn\u00e9es du GC, en collaboration avec plus de 20 organisations partenaires.\r\n\r\nL\u2019\u00e9valuation porte sur quatre piliers d\u2019activit\u00e9 et comprend un total de 244 composantes :\r\n\r\n- Gouvernance : r\u00e8gles et affectation des ressources, prise de d\u00e9cisions et pouvoirs\r\n- Pratiques : op\u00e9rations et mise en \u0153uvre, et intendance des actifs de donn\u00e9es\r\n- Personnes : gestion des talents et perfectionnement des comp\u00e9tences\r\n- Outils : logiciels et mat\u00e9riel, syst\u00e8mes et stockage\r\n\r\nLes composantes sont organis\u00e9es selon une structure hi\u00e9rarchique comportant jusqu\u2019\u00e0 quatre niveaux : les grands domaines d\u2019\u00e9valuation (niveau 1), les sous-composantes (niveau 2), les exigences d\u00e9taill\u00e9es (niveau 3) ainsi que les indicateurs pr\u00e9cis et les questions relatives aux \u00e9l\u00e9ments probants (niveau 4). Chaque composante est associ\u00e9e \u00e0 son sous-pilier et, le cas \u00e9ch\u00e9ant, \u00e0 l\u2019instrument de politique pertinent du gouvernement du Canada. Les composantes marqu\u00e9es \u00ab O \u00bb repr\u00e9sentent des exigences obligatoires d\u00e9coulant des politiques; les autres sont des indicateurs de maturit\u00e9 ou des pratiques de pointe.\r\n\r\nLa version de l\u2019OEMD est interactive. Il suffit, pour chaque composante, de r\u00e9pondre \u00ab Oui \u00bb ou \u00ab Non \u00bb \u00e0 partir d\u2019un menu d\u00e9roulant, et les scores sont actualis\u00e9s automatiquement. Une composante de niveau inf\u00e9rieur n\u2019est prise en compte dans le calcul du pointage que si la r\u00e9ponse \u00e0 la composante dont elle rel\u00e8ve est \u00ab Oui \u00bb. Chaque composante de niveau 1 vaut un point, et les composantes de niveau inf\u00e9rieur se voient attribuer une part proportionnelle de la valeur de leur composante parente. Les scores des piliers sont normalis\u00e9s sur une \u00e9chelle de 100 %, quel que soit le nombre de composantes compris dans chaque pilier. Les r\u00e9sultats sont pr\u00e9sent\u00e9s sous forme de pointages en pourcentage, tant pour l\u2019ensemble de l\u2019\u00e9valuation que pour chaque pilier. Ils sont \u00e9galement accompagn\u00e9s d\u2019un graphique en toile d\u2019araign\u00e9e illustrant le niveau de maturit\u00e9 des piliers. Les r\u00e9ponses doivent refl\u00e9ter les pratiques actuelles document\u00e9es et, dans la mesure du possible, \u00eatre \u00e9tay\u00e9es par des \u00e9l\u00e9ments probants.\r\n\r\nCette \u00e9valuation convient aux minist\u00e8res et aux organismes de toutes tailles. On recommande aux \u00e9quipes responsables de la gouvernance des donn\u00e9es, de la gestion des donn\u00e9es, des analyses, de la transformation num\u00e9rique, de la gestion de l\u2019information et des activit\u00e9s op\u00e9rationnelles de la r\u00e9aliser de mani\u00e8re collaborative pour garantir de meilleurs r\u00e9sultats. Les organisations conservent la propri\u00e9t\u00e9 de leurs r\u00e9sultats; ils ne sont pas communiqu\u00e9s \u00e0 la Communaut\u00e9 des donn\u00e9es du GC, aux autres minist\u00e8res ni au public. On encourage les organisations \u00e0 \u00e9valuer leurs progr\u00e8s de mani\u00e8re p\u00e9riodique, par exemple chaque ann\u00e9e, ou encore dans le cadre des cycles de planification. Il faut toujours interpr\u00e9ter les r\u00e9sultats dans le contexte du mandat de l\u2019organisation, de l\u2019environnement op\u00e9rationnel, de la taille et du niveau de complexit\u00e9 des organisations.\r\n\r\nLes fichiers CSV contiennent les composantes de l\u2019\u00e9valuation, les points accord\u00e9s \u00e0 chacune d\u2019elles, les instructions d\u2019utilisation ainsi qu\u2019une l\u00e9gende avec des abr\u00e9viations, une d\u00e9finition des colonnes et des remarques sur la m\u00e9thodologie."}, "num_resources": 8, "num_tags": 0, "org_section": {"en": "Government of Canada Data Community (GCDC)", "fr": "Communaut\u00e9 des donn\u00e9es du gouvernement du Canada (CDGC)"}, "org_title_at_publication": {"en": "Canada School of Public Service", "fr": "\u00c9cole de la fonction publique du Canada"}, "organization": {"id": "892B1E0C-3389-4C9F-A6F0-92FE653016C1", "name": "csps-efpc", "title": "Canada School of Public Service | \u00c9cole de la fonction publique du Canada", "type": "organization", "description": "", "image_url": "", "created": "2016-09-23T17:25:18.557093", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "892B1E0C-3389-4C9F-A6F0-92FE653016C1", "place_of_publication": ["0"], "portal_release_date": "2026-11-18", "private": false, "program_page_url": {"en": "", "fr": ""}, "ready_to_publish": "true", "restrictions": "unrestricted", "spatial": "", "spatial_representation_type": [], "state": "active", "subject": ["government_and_politics", "information_and_communications"], "title": "Data Maturity Assessment Tool (DMAT) 2026", "title_translated": {"en": "Data Maturity Assessment Tool (DMAT) 2026", "fr": "Outil d\u2019\u00e9valuation du niveau de maturit\u00e9 en mati\u00e8re de donn\u00e9es (OEMD) 2026"}, "topic_category": [], "type": "dataset", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-11-18T20:12:16.081976", "data_quality": [], "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "XLS", "hash": "", "id": "9bafd95e-6006-426d-a655-10bbafca7c33", "language": ["en"], "last_modified": "2026-11-18T15:18:22.841672", "metadata_modified": "2026-11-18T20:12:15.967842", "mimetype": null, "mimetype_inner": null, "name": "DMAT 2026 Tool (XLS)", "name_translated": {"en": "DMAT 2026 Tool (XLS)", "fr": "Outil OEMD 2026 (XLS)"}, "package_id": "acf1b0f9-1c52-43f2-8729-db918d769873", "position": 0, "resource_type": "application", "state": "active", "unique_identifier": 