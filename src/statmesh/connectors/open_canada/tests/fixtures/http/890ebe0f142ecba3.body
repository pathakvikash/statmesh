pe": null, "mimetype_inner": null, "name": "DMAT 2026 Instructions (CSV)", "name_translated": {"en": "DMAT 2026 Instructions (CSV)", "fr": "Aper\u00e7u de l\u2019OEMD 2026 (CSV)"}, "original_url": "/dataset/acf1b0f9-1c52-43f2-8729-db918d769873/resource/860d2d29-e661-4e29-8d71-190bbe56e34e/download/gcdmat2.csv", "package_id": "acf1b0f9-1c52-43f2-8729-db918d769873", "position": 5, "resource_id": "860d2d29-e661-4e29-8d71-190bbe56e34e", "resource_type": "guide", "set_url_type": false, "state": "active", "task_created": "2026-11-18 17:02:52.690940", "unique_identifier": "", "url": "/data/dataset/acf1b0f9-1c52-43f2-8729-db918d769873/resource/860d2d29-e661-4e29-8d71-190bbe56e34e/download/gcdmat2.csv", "url_type": "upload", "validation_status": "success", "validation_timestamp": "2026-11-18T15:34:45.618530"}, {"cache_last_updated": null, "cache_url": null, "character_set": "UTF-8", "created": "2026-11-18T20:12:16.081993", "data_quality": [], "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "date_published": "", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "CSV", "hash": "c84b6c0ddebde0048341e17387b25d28", "id": "2662d879-e802-4de6-ac39-df05ab33cb52", "ignore_hash": true, "language": ["en"], "last_modified": "2026-11-18T15:22:22.153319", "metadata_modified": "2026-11-18T20:12:15.984227", "mimetype": null, "mimetype_inner": null, "name": "DMAT 2026 Legend (CSV)", "name_translated": {"en": "DMAT 2026 Legend (CSV)", "fr": "L\u00e9gende de l\u2019OEMD 2026 (CSV)"}, "original_url": "/dataset/acf1b0f9-1c52-43f2-8729-db918d769873/resource/2662d879-e802-4de6-ac39-df05ab33cb52/download/gcdmat3.csv", "package_id": "acf1b0f9-1c52-43f2-8729-db918d769873", "position": 6, "resource_id": "2662d879-e802-4de6-ac39-df05ab33cb52", "resource_type": "guide", "set_url_type": false, "state": "active", "task_created": "2026-11-18 17:04:51.624193", "unique_identifier": "", "url": "/data/dataset/acf1b0f9-1c52-43f2-8729-db918d769873/resource/2662d879-e802-4de6-ac39-df05ab33cb52/download/gcdmat3.csv", "url_type": "upload", "validation_status": "success", "validation_timestamp": "2026-11-18T15:35:56.384274"}, {"cache_last_updated": null, "cache_url": null, "character_set": "UTF-8", "created": "2026-11-18T20:12:16.081995", "data_quality": [], "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "date_published": "", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "CSV", "hash": "f2c33ab9136e1984baca8f0f836565f6", "id": "12a622f3-e8d4-4e7e-a00e-3938be7a34e0", "ignore_hash": true, "language": ["fr"], "last_modified": "2026-11-18T15:27:00.660728", "metadata_modified": "2026-11-18T20:12:15.987049", "mimetype": null, "mimetype_inner": null, "name": "DMAT 2026 Legend (CSV)", "name_translated": {"en": "DMAT 2026 Legend (CSV)", "fr": "L\u00e9gende de l\u2019OEMD 2026 (CSV)"}, "original_url": "/dataset/acf1b0f9-1c52-43f2-8729-db918d769873/resource/12a622f3-e8d4-4e7e-a00e-3938be7a34e0/download/gcdmat3.csv", "package_id": "acf1b0f9-1c52-43f2-8729-db918d769873", "position": 7, "resource_id": "12a622f3-e8d4-4e7e-a00e-3938be7a34e0", "resource_type": "guide", "set_url_type": false, "state": "active", "task_created": "2026-11-18 17:05:55.835274", "unique_identifier": "", "url": "/data/dataset/acf1b0f9-1c52-43f2-8729-db918d769873/resource/12a622f3-e8d4-4e7e-a00e-3938be7a34e0/download/gcdmat3.csv", "url_type": "upload", "validation_status": "success", "validation_timestamp": "2026-11-18T15:32:41.165646"}], "tags": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}, {"association_type": [], "audience": [], "author": null, "author_email": null, "collection": "primary", "contributor": {"en": "", "fr": ""}, "creator": "", "creator_user_id": "2dc5a12f-2a6f-4822-8514-165ea6bb05d9", "data_series_issue_identification": {"en": "", "fr": ""}, "data_series_name": {"en": "S-211: Fighting Against Forced Labour in Supply Chains Act", "fr": "S-211: Loi sur la lutte contre le travail forc\u00e9 dans les cha\u00eenes d'approvisionnement"}, "date_modified": "2026-09-18 00:00:00", "date_published": "2026-09-18 00:00:00", "digital_object_identifier": "", "display_flags": [], "frequency": "as_needed", "geographic_region": [], "id": "8d4c1f24-c6b3-4a5a-8e20-00f487e27af8", "imso_approval": "true", "isopen": false, "jurisdiction": "federal", "keywords": {"en": ["S-211", "Supply Chains Act", "Labour standards", "Working conditions"], "fr": ["S-211", "Loi sur les cha\u00eenes d'approvisionnement", "Normes du travail", "Conditions de travail"]}, "license_id": "ca-ogl-lgo", "license_title": "Open Government Licence - Canada", "license_url": "https://open.canada.ca/en/open-government-licence-canada", "maintainer": null, "maintainer_email": "", "metadata_created": "2026-09-18T17:32:04.673424", "metadata_modified": "2026-11-19T06:52:23.206823", "name": "8d4c1f24-c6b3-4a5a-8e20-00f487e27af8", "notes": "This collection includes all 2024 reports submitted under the Supply Chains Act that meet the guidance's requirements. Reports submitted under the Supply Chains Act were subject to a high-level quality assurance review prior to publication. Public Safety Canada is not responsible for content submitted by entities, which may not meet federal standards related to accessibility and official languages. If you have questions about accessibility or the information in a specific report, contact the reporting entity or government institution directly.\r\n>Disclaimer: Public Safety Canada is not responsible for the contents of reports posted within the Supply Chains Act repository, other than the report(s) submitted on behalf of Public Safety Canada. Some reports contained in this repository originate from external sources and are not subject to the Government of Canada's Web Standards, the _Privacy Act_ or the _Official Languages Act_. Consequently, reports are available only in the language in which they were submitted. Public Safety Canada does not ensure the accuracy or reliability of the content. Any member of the public with questions relating to the accessibility, language or content of any third-party report should direct their questions to the respective entity or government institution, directly.", "notes_translated": {"en": "This collection includes all 2024 reports submitted under the Supply Chains Act that meet the guidance's requirements. Reports submitted under the Supply Chains Act were subject to a high-level quality assurance review prior to publication. Public Safety Canada is not responsible for content submitted by entities, which may not meet federal standards related to accessibility and official languages. If you have questions about accessibility or the information in a specific report, contact the reporting entity or government institution directly.\r\n>Disclaimer: Public Safety Canada is not responsible for the contents of reports posted within the Supply Chains Act repository, other than the report(s) submitted on behalf of Public Safety Canada. Some reports contained in this repository originate from external sources and are not subject to the Government of Canada's Web Standards, the _Privacy Act_ or the _Official Languages Act_. Consequently, reports are available only in the language in which they were submitted. Public Safety Canada does not ensure the accuracy or reliability of the content. Any member of the public with questions relating to the accessibility, language or content of any third-party report should direct their questions to the respective entity or government institution, directly.", "fr": "Cette collection contient tous les rapports soumis en 2024 vertu de la Loi sur les cha\u00eenes d\u2019approvisionnement qui satisfont aux exigences des linges directires. Les rapports remis en vertu de la Loi sur les cha\u00eenes d\u2019approvisionnement furent assujettis \u00e0 une revue d\u2019assurance qualit\u00e9 de haut niveau avant d\u2019\u00eatre publi\u00e9s. S\u00e9curit\u00e9 publique Canada n'est pas responsable du contenu des rapports soumis par les entit\u00e9s, qui peuvent ou non respecter les normes f\u00e9d\u00e9rales en mati\u00e8re d'accessibilit\u00e9 et de langues officielles. Si vous avez des questions \u00e0 propos de l'accessibilit\u00e9 ou des renseignements dans un rapport distinct, veuillez communiquer directement avec l'entit\u00e9 ou l'institution f\u00e9d\u00e9rale.\r\n>Avertissement: S\u00e9curit\u00e9 publique Canada n'est pas responsable du contenu des rapports publi\u00e9s dans le r\u00e9f\u00e9rentiel de la Loi sur les cha\u00eenes d'approvisionnement, autre que le(s) rapport(s) soumis au nom de S\u00e9curit\u00e9 publique Canada. Certains rapports contenus dans ce r\u00e9f\u00e9rentiel proviennent de sources externes et ne sont pas assujettis aux normes Web du Gouvernement du Canada, \u00e0 la _Loi sur la protection des renseignements personnels_ ou \u00e0 la _Loi sur les langues officielles_. Par cons\u00e9quent, les rapports sont disponibles uniquement dans la langue dans lesquels ils ont \u00e9t\u00e9 remis. S\u00e9curit\u00e9 publique Canada ne garantit pas l'exactitude ou la fiabilit\u00e9 du contenu. Tout membre du public ayant des questions concernant l\u2019accessibilit\u00e9, la langue ou le contenu de tout rapport tiers doit adresser ses questions directement \u00e0 l\u2019entit\u00e9 ou \u00e0 l\u2019institution f\u00e9d\u00e9rale concern\u00e9e."}, "num_resources": 2, "num_tags": 0, "org_section": {"en": "", "fr": ""}, "org_title_at_publication": {"en": "Public Safety Canada", "fr": "S\u00e9curit\u00e9 publique Canada"}, "organization": {"id": "7C0AF243-753A-465F-8D46-C4FF7397D9B6", "name": "ps-sp", "title": "Public Safety Canada | S\u00e9curit\u00e9 publique Canada", "type": "organization", "description": "", "image_url": "", "created": "2016-09-23T17:26:00.579110", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "7C0AF243-753A-465F-8D46-C4FF7397D9B6", "place_of_publication": [], "portal_release_date": "2026-09-18", "private": false, "program_page_url": {"en": "", "fr": ""}, "ready_to_publish": "true", "restrictions": "unrestricted", "spatial": "", "spatial_representation_type": [], "state": "active", "subject": ["information_and_communications"], "time_period_coverage_end": "2025-05-31 00:00:00", "time_period_coverage_start": "2024-01-01 00:00:00", "title": "2024 S-211: Fighting Against Forced Labour and Child Labour in Supply Chains Act", "title_translated": {"en": "2024 S-211: Fighting Against Forced Labour and Child Labour in Supply Chains Act", "fr": "2024 S-211: Loi sur la lutte contre le travail forc\u00e9 et le travail des enfants dans les cha\u00eenes d'approvisionnement"}, "topic_category": [], "type": "dataset", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-09-18T17:32:04.718752", "data_quality": ["data_includes_uris", "data_includes_links"], "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "date_published": "2026-07-27", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "CSV", "hash": "4f1235a517d5845763de2ad4b0e191b5", "id": "b305afc0-bf51-4762-acd9-e2d6d29cebe1", "ignore_hash": false, "language": ["fr"], "last_modified": "2026-11-18T18:52:20.841367", "metadata_modified": "2026-11-18T19:02:12.068945", "mimetype": null, "mimetype_inner": null, "name": "2024 Data", "name_translated": {"en": "2024 Data", "fr": "2024 Donn\u00e9es"}, "original_url": "/dataset/8d4c1f24-c6b3-4a5a-8e20-00f487e27af8/resource/b305afc0-bf51-4762-acd9-e2d6d29cebe1/download/s-211-2024-data.csv", "package_id": "8d4c1f24-c6b3-4a5a-8e20-00f487e27af8", "position": 0, "resource_id": "b305afc0-bf51-4762-acd9-e2d6d29cebe1", "resource_type": "dataset", "set_url_type": false, "size": 3491532, "state": "active", "task_created": "2026-11-18 18:52:28.335576", "unique_identifier": "", "url": "/data/dataset/8d4c1f24-c6b3-4a5a-8e20-00f487e27af8/resource/b305afc0-bf51-4762-acd9-e2d6d29cebe1/download/s-211-2024-data.csv", "url_type": "upload", "validation_status": "success", "validation_timestamp": "2026-11-18T18:52:26.984071"}, {"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-09-18T17:32:04.718756", "data_quality": ["data_includes_uris", "data_includes_links"], "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "date_published": "2026-07-27", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "CSV", "hash": "4f1235a517d5845763de2ad4b0e191b5", "id": "6e4303f4-8928-4bbe-b1e5-0d4d49936190", "ignore_hash": false, "language": ["en"], "last_modified": "2026-11-18T18:54:59.274671", "metadata_modified": "2026-11-18T19:02:12.069032", "mimetype": null, "mimetype_inner": null, "name": "2024 Data", "name_translated": {"en": "2024 Data", "fr": "2024 Donn\u00e9es"}, "original_url": "/dataset/8d4c1f24-c6b3-4a5a-8e20-00f487e27af8/resource/6e4303f4-8928-4bbe-b1e5-0d4d49936190/download/s-211-2024-data.csv", "package_id": "8d4c1f24-c6b3-4a5a-8e20-00f487e27af8", "position": 1, "resource_id": "6e4303f4-8928-4bbe-b1e5-0d4d49936190", "resource_type": "dataset", "set_url_type": false, "size": 3491532, "state": "active", "task_created": "2026-11-18 18:55:06.486141", "unique_identifier": "", "url": "/data/dataset/8d4c1f24-c6b3-4a5a-8e20-00f487e27af8/resource/6e4303f4-8928-4bbe-b1e5-0d4d49936190/download/s-211-2024-data.csv", "url_type": "upload", "validation_status": "success", "validation_timestamp": "2026-11-18T18:55:05.203355"}], "tags": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}, {"association_type": [], "audience": [], "author": null, "author_email": null, "collection": "primary", "contributor": {"en": "", "fr": ""}, "creator": "", "creator_user_id": "aa584ab4-544c-4c5c-81da-d1cff9bd96fa", "data_series_issue_identification": {"en": "", "fr": ""}, "data_series_name": {"en": "Canada Learning Bond", "fr": "Bon d\u2019\u00e9tudes canadien"}, "date_modified": "2026-05-13 00:00:00", "date_published": "2024-03-14 00:00:00", "digital_object_identifier": "", "display_flags": [], "frequency": "P6M", "geographic_region": [], "id": "ce99c2c9-c224-43eb-aef0-1f379b70c91d", "imso_approval": "true", "isopen": false, "jurisdiction": "federal", "keywords": {"en": ["Canada Education Savings Program - CESP", "Registered Education Savings Plan - RESP", "Canada Education Savings Grant - CESG", "Canada Learning Bond - CLB", "Post-Secondary Education - PSE", "Contributions", "Beneficiaries"], "fr": ["Programme canadien pour l'\u00e9pargne-\u00e9tudes - PCEE", "r\u00e9gime enregistr\u00e9 d'\u00e9pargne-\u00e9tudes - REEE", "subvention canadienne pour l'\u00e9pargne-\u00e9tudes - SCEE", "bon d'\u00e9tudes canadien - BEC", "\u00e9tudes postsecondaires - EPS", "contributions", "b\u00e9n\u00e9ficiaires"]}, "license_id": "ca-ogl-lgo", "license_title": "Open Government Licence - Canada", "license_url": "https://open.canada.ca/en/open-government-licence-canada", "maintainer": null, "maintainer_email": "ESDC.CESP.DARE-DARE.PCEE.EDSC@hrsdc-rhdcc.gc.ca", "metadata_created": "2016-09-25T12:01:15.878319", "metadata_modified": "2026-11-19T06:52:18.021878", "name": "ce99c2c9-c224-43eb-aef0-1f379b70c91d", "notes": "The CLB is available to children born on or after January 1, 2004, who are from low-income families or getting benefits under the *Children\u2019s Special Allowance Act*. \r\n\r\nThe CLB provides an initial payment of $500, and $100 for each year of eligibility up to age 15 (to a maximum of $2,000) and is retroactive. This means CLB payments can be requested for years the beneficiary was eligible, even for years before they were named in an RESP.  Personal contributions are not required to receive the CLB.\r\n\r\nThe table consists of quarterly data beginning with the period ending on December 31, 2006.  The first column presents the number of children who have ever received the CLB, the second column presents the number of eligible children in the given Forward Sortation Area (sourced from the Canada Revenue Agency), and the third column presents the participation rate or the proportion of children receiving the CLB in relation to the eligible population.\r\n\r\nAll population counts of 30 or below are censored due to privacy issues.\r\n*********************************************************\r\nA methodological note on the cumulative CLB file \r\n- as of March 14, 2024\r\n\r\nThe cumulative CLB file is an update of the CLB data from consecutive editions of the Quarterly National CLB report by Forward Sortation Area (FSA). The current file is updated using CLB data from the last four quarters (Q1 2025 through to Q4 2025) that can be found in the Q4 2025 National CLB report. The Q4 2025 report also contains the updated FSA values from the March 2026 release of Statistics Canada\u2019s Postal Code Conversion File. In this edition one new FSA value was created (L3E) and no FSA values were removed. Updates of the historical and recent CLB data, in the cumulative file, are adjusted to reflect the new and old FSA values. All counts of 30 or under are not included and are represented with an asterisk in the Quarterly National CLB report by FSA. The Quarterly National CLB report by FSA presents CLB data by FSA and does not include the CLB aggregated data at either the national or province and territory levels.\r\n\r\nAs of January 1, 2022, individuals eligible for the CLB who were born in 2004 or after but did not receive it yet can apply for the benefit when they turn 18. As a result, adult beneficiaries (i.e., those who receive it between the ages of 18 and 20) are included in beneficiary counts from 2022 onward.\r\n\r\nThe primary source of data that is used to produce these numbers comes from the Canada Education Savings Program\u2019s administrative data. Some updates (e.g., reversals, repayments, data errors, and reporting delays) may have been introduced in the Canada Education Savings Program\u2019s administrative data that could affect the previous reporting periods. As a result, the values in the latest quarterly report supersede the previous quarterly reports.\r\n\r\n**Please note that the Open Government Portal provides data that add to those already available in the Canada Education Savings Program Annual Statistical Review. The most recent version of the report, which includes data up to 2024, was published on August 5, 2024 and can be found here:** https://www.canada.ca/en/employment-social-development/services/student-financial-aid/education-savings/reports/statistical-review.html\r\n\r\n", "notes_translated": {"en": "The CLB is available to children born on or after January 1, 2004, who are from low-income families or getting benefits under the *Children\u2019s Special Allowance Act*. \r\n\r\nThe CLB provides an initial payment of $500, and $100 for each year of eligibility up to age 15 (to a maximum of $2,000) and is retroactive. This means CLB payments can be requested for years the beneficiary was eligible, even for years before they were named in an RESP.  Personal contributions are not required to receive the CLB.\r\n\r\nThe table consists of quarterly data beginning with the period ending on December 31, 2006.  The first column presents the number of children who have ever received the CLB, the second column presents the number of eligible children in the given Forward Sortation Area (sourced from the Canada Revenue Agency), and the third column presents the participation rate or the proportion of children receiving the CLB in relation to the eligible population.\r\n\r\nAll population counts of 30 or below are censored due to privacy issues.\r\n*********************************************************\r\nA methodological note on the cumulative CLB file \r\n- as of March 14, 2024\r\n\r\nThe cumulative CLB file is an update of the CLB data from consecutive editions of the Quarterly National CLB report by Forward Sortation Area (FSA). The current file is updated using CLB data from the last four quarters (Q1 2025 through to Q4 2025) that can be found in the Q4 2025 National CLB report. The Q4 2025 report also contains the updated FSA values from the March 2026 release of Statistics Canada\u2019s Postal Code Conversion File. In this edition one new FSA value was created (L3E) and no FSA values were removed. Updates of the historical and recent CLB data, in the cumulative file, are adjusted to reflect the new and old FSA values. All counts of 30 or under are not included and are represented with an asterisk in the Quarterly National CLB report by FSA. The Quarterly National CLB report by FSA presents CLB data by FSA and does not include the CLB aggregated data at either the national or province and territory levels.\r\n\r\nAs of January 1, 2022, individuals eligible for the CLB who were born in 2004 or after but did not receive it yet can apply for the benefit when they turn 18. As a result, adult beneficiaries (i.e., those who receive it between the ages of 18 and 20) are included in beneficiary counts from 2022 onward.\r\n\r\nThe primary source of data that is used to produce these numbers comes from the Canada Education Savings Program\u2019s administrative data. Some updates (e.g., reversals, repayments, data errors, and reporting delays) may have been introduced in the Canada Education Savings Program\u2019s administrative data that could affect the previous reporting periods. As a result, the values in the latest quarterly report supersede the previous quarterly reports.\r\n\r\n**Please note that the Open Government Portal provides data that add to those already available in the Canada Education Savings Program Annual Statistical Review. The most recent version of the report, which includes data up to 2024, was published on August 5, 2024 and can be found here:** https://www.canada.ca/en/employment-social-development/services/student-financial-aid/education-savings/reports/statistical-review.html\r\n\r\n", "fr": "Le BEC est offert aux b\u00e9n\u00e9ficiaires n\u00e9s le 1er janvier 2004 ou apr\u00e8s et qui proviennent de familles \u00e0 faible revenu ou obtiennent des prestations en vertu de la *Loi sur les allocations sp\u00e9ciales pour enfants*.\r\n\r\nLe BEC fournit un paiement initial de 500 $, suivi de paiements de 100 $ pour chaque ann\u00e9e d'admissibilit\u00e9 du b\u00e9n\u00e9ficiaire jusqu'\u00e0 l'\u00e2ge de 15 ans (pour un maximum de 2 000 $) et est r\u00e9troactif. Cela signifie que les paiements du BEC peuvent \u00eatre demand\u00e9s pour des ann\u00e9es o\u00f9 le b\u00e9n\u00e9ficiaire \u00e9tait admissible, m\u00eame pour des ann\u00e9es avant qu'ils ne soient nomm\u00e9s dans un REEE. Les contributions personnelles ne sont pas n\u00e9cessaires pour recevoir le BEC.\r\n\r\nLe tableau pr\u00e9sente des donn\u00e9es trimestrielles commen\u00e7ant \u00e0 la p\u00e9riode se terminant le 31 d\u00e9cembre 2006. La premi\u00e8re colonne pr\u00e9sente le nombre d'enfants qui ont d\u00e9j\u00e0 re\u00e7u le BEC, la deuxi\u00e8me colonne pr\u00e9sente le nombre d'enfants admissibles dans la r\u00e9gion de tri d'acheminement donn\u00e9e (provenant de l'Agence du revenu du Canada) et la troisi\u00e8me colonne pr\u00e9sente le taux de participation ou la proportion d'enfants recevant le BEC par rapport \u00e0 la population admissible.\r\n\r\nLes comptes de 30 ou moins sont censur\u00e9s pour des raisons de confidentialit\u00e9.\r\n********************************************************\r\nUne note m\u00e9thodologique sur le fichier cumulatif BEC \r\n- au 14 mars 2024\r\n\r\nLe fichier du BEC cumulatif est une mise \u00e0 jour des donn\u00e9es d'\u00e9ditions cons\u00e9cutives du Rapport national trimestriel du BEC par r\u00e9gion de tri d'acheminement (RTA). Le fichier actuel est mis \u00e0 jour \u00e0 l'aide des donn\u00e9es du BEC des quatre derniers trimestres (du T1 2025 au T4 2025) figurant dans le rapport sur le BEC du T4 2025. Le rapport du quatri\u00e8me trimestre de 2025 contient \u00e9galement les valeurs RTA mises \u00e0 jour de la version de mars 2026 du fichier de conversion des codes postaux de Statistique Canada. Dans cette \u00e9dition, une valeur RTA a \u00e9t\u00e9 cr\u00e9\u00e9e (L3E) et aucune valeur RTA n'a \u00e9t\u00e9 supprim\u00e9e. Les mises \u00e0 jour des donn\u00e9es historiques et r\u00e9centes du BEC, dans le fichier cumulatif, sont ajust\u00e9es pour refl\u00e9ter les valeurs anciennes ainsi que les nouvelles. Tous les comptes de 30 ou moins ne sont pas inclus et sont repr\u00e9sent\u00e9s par un ast\u00e9risque dans le Rapport national trimestriel sur le BEC par RTA. Le Rapport national trimestriel sur le BEC par RTA pr\u00e9sente les donn\u00e9es relatives au BEC par RTA et n'inclut pas les donn\u00e9es agr\u00e9g\u00e9es sur le BEC au niveau national, provincial ou territorial.\r\n\r\n\u00c0 compter du 1er janvier 2022, les personnes admissibles au BEC n\u00e9es en 2004 ou apr\u00e8s, mais qui n\u2019ont pas encore re\u00e7u le b\u00e9n\u00e9fice peuvent en faire la demande \u00e0 18 ans. Par cons\u00e9quent, les b\u00e9n\u00e9ficiaires adultes (c.-\u00e0-d. ceux et celles qui le re\u00e7oivent entre 18 et 20 ans) sont inclus dans le nombre de b\u00e9n\u00e9ficiaires \u00e0 partir de 2022.\r\n\r\nLa principale source de donn\u00e9es utilis\u00e9e pour produire ces chiffres provient des donn\u00e9es administratives du Programme canadien pour l\u2019\u00e9pargne-\u00e9tudes. Certaines mises \u00e0 jour (annulations, remboursements, erreurs de donn\u00e9es et retards de d\u00e9claration, par exemple) peuvent avoir \u00e9t\u00e9 introduites dans les donn\u00e9es administratives du Programme canadien pour l\u2019\u00e9pargne-\u00e9tudes, ce qui pourrait avoir une incidence sur les chiffres des p\u00e9riodes pr\u00e9c\u00e9dentes. Par cons\u00e9quent, les valeurs du dernier rapport trimestriel remplacent les rapports trimestriels pr\u00e9c\u00e9dents.\r\n\r\n**Veuillez noter que le Portail du gouvernement ouvert fournit des donn\u00e9es qui viennent compl\u00e9ter celles qui se trouvent dans le rapport statistique annuel du Programme Canadien pour l\u2019\u00e9pargne-\u00e9tudes. La version la plus r\u00e9cente du rapport, qui comprend des donn\u00e9es jusqu'en 2024, a \u00e9t\u00e9 publi\u00e9e le 5 ao\u00fbt 2025 et peut \u00eatre consult\u00e9e ici :** https://www.canada.ca/fr/emploi-developpement-social/services/aide-financiere-etudiants/epargne-etudes/rapports/rapport-statistique.html"}, "num_resources": 4, "num_tags": 0, "org_section": {"en": "", "fr": ""}, "org_title_at_publication": {"en": "Employment and Social Development Canada", "fr": "Emploi et D\u00e9veloppement social Canada"}, "organization": {"id": "055ADCD8-8FDA-40DA-A5B7-689FF7DB57A6", "name": "esdc-edsc", "title": "Employment and Social Development Canada | Emploi et D\u00e9veloppement social Canada", "type": "organization", "description": "", "image_url": "", "created": "2016-09-23T17:25:26.246118", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "055ADCD8-8FDA-40DA-A5B7-689FF7DB57A6", "place_of_publication": [], "portal_release_date": "2014-11-05", "private": false, "program_page_url": {"en": "", "fr": ""}, "ready_to_publish": "true", "restrictions": "unrestricted", "spatial": "", "spatial_representation_type": [], "state": "active", "subject": ["education_and_training", "government_and_politics"], "time_period_coverage_end": "2025-06-30 00:00:00", "time_period_coverage_start": "2006-12-31 00:00:00", "title": "Canada Learning Bond (CLB) Participation Rate (percentage), Cumulative Number of Beneficiaries, and Cumulative Number of Eligible Children by Forward Sortation Area (FSA; i.e., the first three characters of the postal code)", "title_translated": {"en": "Canada Learning Bond (CLB) Participation Rate (percentage), Cumulative Number of Beneficiaries, and Cumulative Number of Eligible Children by Forward Sortation Area (FSA; i.e., the first three characters of the postal code)", "fr": "Bon d'\u00e9tudes canadien (BEC) taux de participation par r\u00e9gion de tri d'acheminement (RTA; \u00e0 savoir les trois premiers caract\u00e8res du code postal) (pourcentage)"}, "topic_category": [], "type": "dataset", "url": null, "version": null, "credit": [{"credit_name": {"en": "", "fr": ""}}], "resources": [{"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2016-12-01T12:08:05.038201", "data_quality": [], "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "date_published": "2026-11-18", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "CSV", "hash": "1b00d13ac0a05c700283b9191727de8c", "id": "4e2e681f-0a39-49be-9783-5b20a1806d12", "ignore_hash": false, "language": ["en"], "last_modified": "2026-11-18T15:40:09.016099", "metadata_modified": "2026-11-18T15:42:06.024126", "mimetype": null, "mimetype_inner": null, "name": "Canada Learning Bond (CLB) Participation Rate (percentage), Cumulative Number of Beneficiaries, and Cumulative Number of Eligible Children by Forward Sortation Area (FSA; i.e., the first three characters of the postal code)", "name_translated": {"en": "Canada Learning Bond (CLB) Participation Rate (percentage), Cumulative Number of Beneficiaries, and Cumulative Number of Eligible Children by Forward Sortation Area (FSA; i.e., the first three characters of the postal code)", "fr": "Bon d'\u00e9tudes canadien (BEC) taux de participation par r\u00e9gion de tri d'acheminement (RTA; \u00e0 savoir les trois premiers caract\u00e8res du code postal) (pourcentage)"}, "original_url": "/dataset/ce99c2c9-c224-43eb-aef0-1f379b70c91d/resource/4e2e681f-0a39-49be-9783-5b20a1806d12/download/national_report_up_to_20260630_en.csv", "package_id": "ce99c2c9-c224-43eb-aef0-1f379b70c91d", "position": 0, "resource_id": "