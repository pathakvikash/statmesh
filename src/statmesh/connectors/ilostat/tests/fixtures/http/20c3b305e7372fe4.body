          <common:Annotation>
            <common:AnnotationTitle>FREQ=A,endPeriod=2027-12-31,AGE=AGE_YTHADULT_YGE15+AGE_YTHADULT_Y15-64+AGE_YTHADULT_Y15-24+AGE_YTHADULT_YGE25,SEX=SEX_T,LASTNOBSERVATIONS=1</common:AnnotationTitle>
            <common:AnnotationType>DEFAULT</common:AnnotationType>
          </common:Annotation>
          <common:Annotation>
            <common:AnnotationTitle>366500</common:AnnotationTitle>
            <common:AnnotationType>ORDER</common:AnnotationType>
