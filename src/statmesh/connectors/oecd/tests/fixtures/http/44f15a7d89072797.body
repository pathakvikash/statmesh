      <structure:Dataflow id="DSD_FUA_CLIM@DF_TEMPERATURES" agencyID="OECD.CFE.EDS" version="1.6" isFinal="false">
        <common:Annotations>
          <common:Annotation>
            <common:AnnotationType>NonProductionDataflow</common:AnnotationType>
