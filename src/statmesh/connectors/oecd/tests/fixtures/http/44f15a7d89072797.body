            <common:AnnotationTitle>REF_AREA=AUT+AT001F+AT002F+AT003F+AT004F+AT005F+AT006F+AT001C+AT002C+AT003C+AT004C+AT005C+AT006C,MEASURE=FIRE_LAND_EXP</common:AnnotationTitle>
