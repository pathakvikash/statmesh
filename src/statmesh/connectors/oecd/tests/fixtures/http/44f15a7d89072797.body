            <common:AnnotationTitle>REF_AREA=AUT+AT001F+AT002F+AT003F+AT004F+AT005F+AT006F+AT001C+AT002C+AT003C+AT004C+AT005C+AT006C,RET_PERIOD=Y_100,MEASURE=RF_POP_EXP,TIME_PERIOD_START=2000</common:AnnotationTitle>
