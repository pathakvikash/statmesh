            <common:AnnotationType>LAYOUT_COLUMN</common:AnnotationType>
          </common:Annotation>
          <common:Annotation id="@SDMX">
            <common:AnnotationTitle>MEASURE,METHODOLOGY,TRANSFORMATION,ADJUSTMENT</common:AnnotationTitle>
