{
 "openapi": "3.1.0",
 "info": {
  "title": "statmesh",
  "version": "0.1.0"
 },
 "paths": {
  "/shares": {
   "post": {
    "summary": "Create a share link",
    "operationId": "create_share",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Create Share Shares Post"
        }
       }
      }
     }
    },
    "description": "Stores one answer and returns its id; the public read-only link is /a/{id}. Answers over the size cap get 413."
   }
  },
  "/shares/{share_id}": {
   "get": {
    "summary": "Read a shared answer",
    "operationId": "get_share",
    "parameters": [
     {
      "name": "share_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Share Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "title": "Response Get Share Shares  Share Id  Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "description": "The stored answer behind a share link."
   }
  },
  "/series/{series_id}/observations.csv": {
   "get": {
    "summary": "Download observations as CSV",
    "description": "Streams the observations of one series as text/csv. The row cap is in X-Statmesh-Row-Cap; compare it with the rows received.",
    "operationId": "download_observations_csv",
    "parameters": [
     {
      "name": "series_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Series Id"
      }
     },
     {
      "name": "start",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ],
       "title": "Start"
      }
     },
     {
      "name": "end",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ],
       "title": "End"
      }
     },
     {
      "name": "geo",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Geo"
      }
     },
     {
      "name": "filter",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "default": [],
       "title": "Filter"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/healthz": {
   "get": {
    "summary": "Health check",
    "operationId": "get_health",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Healthz Healthz Get"
        }
       }
      }
     }
    },
    "description": "Returns {\"ok\": true} when the API process is up. Does not check the catalog."
   }
  },
  "/llms.txt": {
   "get": {
    "summary": "Agent guide (llms.txt)",
    "operationId": "get_llms_txt",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "text/plain": {
        "schema": {
         "type": "string"
        }
       }
      }
     }
    },
    "description": "Plain-text guide for AI agents: what statmesh is, the MCP tools, the REST endpoints, citation rules and how to report missing data."
   }
  },
  "/search": {
   "get": {
    "summary": "Search series",
    "description": "Keyword search over the series catalog. Filters combine. Returns the matching series with citations. `q` may be empty when a filter is set.",
    "operationId": "search_series",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "examples": [
        "unemployment India"
       ],
       "default": "",
       "title": "Q"
      }
     },
     {
      "name": "geo",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Geo"
      }
     },
     {
      "name": "freq",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Freq"
      }
     },
     {
      "name": "source",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        {
         "type": "null"
        }
       ],
       "title": "Source"
      }
     },
     {
      "name": "topic",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        {
         "type": "null"
        }
       ],
       "title": "Topic"
      }
     },
     {
      "name": "start_year",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "title": "Start Year"
      }
     },
     {
      "name": "end_year",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "title": "End Year"
      }
     },
     {
      "name": "updated_since",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Updated Since"
      }
     },
     {
      "name": "redistribute",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Redistribute"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100,
       "minimum": 1,
       "default": 10,
       "title": "Limit"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SearchResult"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/sources": {
   "get": {
    "summary": "List sources",
    "description": "Sources with freshness, key status and topics. `q` matches a substring of name, id or dataset titles; `auth` is keyless|key; `status` is data|catalogue.",
    "operationId": "list_sources",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Q"
      }
     },
     {
      "name": "kind",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Kind"
      }
     },
     {
      "name": "topic",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        {
         "type": "null"
        }
       ],
       "title": "Topic"
      }
     },
     {
      "name": "redistribute",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Redistribute"
      }
     },
     {
      "name": "auth",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Auth"
      }
     },
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Status"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/SourceStatus"
         },
         "title": "Response Sources Sources Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/schema": {
   "get": {
    "summary": "SQL view schema",
    "operationId": "get_schema",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SchemaResult"
        }
       }
      }
     }
    },
    "description": "Columns, types, descriptions, examples and join hints of every SQL view that POST /query can read."
   }
  },
  "/query": {
   "post": {
    "summary": "Run a read-only SQL query",
    "operationId": "run_sql",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/SqlRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SqlResult"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "description": "One allowlisted SELECT over the views listed by GET /schema. Times out with 504."
   }
  },
  "/series/{series_id}/observations": {
   "get": {
    "summary": "Get series observations",
    "description": "Observations of one series, fetched on demand for remote datasets (may return 429 with Retry-After). `filter` takes key=value pairs for connector filters.",
    "operationId": "get_observations",
    "parameters": [
     {
      "name": "series_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Series Id"
      }
     },
     {
      "name": "start",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ],
       "title": "Start"
      }
     },
     {
      "name": "end",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ],
       "title": "End"
      }
     },
     {
      "name": "geo",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Geo"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 10000,
         "minimum": 1
        },
        {
         "type": "null"
        }
       ],
       "title": "Limit"
      }
     },
     {
      "name": "filter",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "default": [],
       "title": "Filter"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ObservationsResult"
        }
       }
      }
     },
     "403": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ObservationsResult"
        }
       }
      },
      "description": "Forbidden"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ObservationsResult"
        }
       }
      },
      "description": "Not Found"
     },
     "429": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ObservationsResult"
        }
       }
      },
      "description": "Too Many Requests"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/series/{series_id}": {
   "get": {
    "summary": "Get series metadata",
    "operationId": "get_series",
    "parameters": [
     {
      "name": "series_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Series Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SeriesDetail"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "description": "Metadata, dimensions, licence and citation of one series."
   }
  }
 },
 "components": {
  "schemas": {
   "Citation": {
    "properties": {
     "source_id": {
      "type": "string",
      "title": "Source Id"
     },
     "source_name": {
      "type": "string",
      "title": "Source Name"
     },
     "dataset_id": {
      "type": "string",
      "title": "Dataset Id"
     },
     "series_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Series Id"
     },
     "licence_name": {
      "type": "string",
      "title": "Licence Name"
     },
     "licence_url": {
      "type": "string",
      "title": "Licence Url"
     },
     "redistribute": {
      "type": "string",
      "enum": [
       "yes",
       "no",
       "review"
      ],
      "title": "Redistribute"
     },
     "attribution": {
      "type": "string",
      "title": "Attribution"
     },
     "source_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Url"
     },
     "retrieved_at": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Retrieved At"
     },
     "vintage": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "Vintage"
     }
    },
    "type": "object",
    "required": [
     "source_id",
     "source_name",
     "dataset_id",
     "licence_name",
     "licence_url",
     "redistribute",
     "attribution"
    ],
    "title": "Citation"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ObservationsResult": {
    "properties": {
     "series_id": {
      "type": "string",
      "title": "Series Id"
     },
     "status": {
      "type": "string",
      "enum": [
       "ok",
       "rate_limited",
       "not_found",
       "forbidden"
      ],
      "title": "Status"
     },
     "columns": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Columns"
     },
     "rows": {
      "items": {
       "items": {},
       "type": "array"
      },
      "type": "array",
      "title": "Rows"
     },
     "truncated": {
      "type": "boolean",
      "title": "Truncated",
      "default": false
     },
     "retry_after": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Retry After"
     },
     "citations": {
      "items": {
       "$ref": "#/components/schemas/Citation"
      },
      "type": "array",
      "title": "Citations"
     },
     "warning": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Warning"
     }
    },
    "type": "object",
    "required": [
     "series_id",
     "status",
     "columns",
     "rows",
     "citations"
    ],
    "title": "ObservationsResult"
   },
   "SchemaColumn": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "type": {
      "type": "string",
      "title": "Type"
     },
     "description": {
      "type": "string",
      "title": "Description"
     },
     "example": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Example"
     }
    },
    "type": "object",
    "required": [
     "name",
     "type",
     "description"
    ],
    "title": "SchemaColumn"
   },
   "SchemaResult": {
    "properties": {
     "views": {
      "items": {
       "$ref": "#/components/schemas/SchemaView"
      },
      "type": "array",
      "title": "Views"
     }
    },
    "type": "object",
    "required": [
     "views"
    ],
    "title": "SchemaResult"
   },
   "SchemaView": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "description": {
      "type": "string",
      "title": "Description"
     },
     "joins": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Joins"
     },
     "columns": {
      "items": {
       "$ref": "#/components/schemas/SchemaColumn"
      },
      "type": "array",
      "title": "Columns"
     }
    },
    "type": "object",
    "required": [
     "name",
     "description",
     "joins",
     "columns"
    ],
    "title": "SchemaView"
   },
   "SearchResult": {
    "properties": {
     "query": {
      "type": "string",
      "title": "Query"
     },
     "hits": {
      "items": {
       "$ref": "#/components/schemas/SeriesHit"
      },
      "type": "array",
      "title": "Hits"
     }
    },
    "type": "object",
    "required": [
     "query",
     "hits"
    ],
    "title": "SearchResult"
   },
   "SeriesDetail": {
    "properties": {
     "series_id": {
      "type": "string",
      "title": "Series Id"
     },
     "title": {
      "type": "string",
      "title": "Title"
     },
     "unit": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Unit"
     },
     "freq": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Freq"
     },
     "geo": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Geo"
     },
     "start": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "Start"
     },
     "end": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "End"
     },
     "source_id": {
      "type": "string",
      "title": "Source Id"
     },
