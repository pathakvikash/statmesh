# Names only; set real values in the host's env settings (Vercel: Project Settings > Environment Variables).
# Validate with web/src/lib/env.ts (`envProblems()`) or scripts/env-check.sh from the repo root.

# ---- Required on a public deployment -------------------------------------
# Base URL of the statmesh Python API (server-side only; http/https; default http://localhost:8000).
# Hosted: must not be localhost.
STATMESH_API_URL=https://api.example.com
# Public origin of this web app (sitemap, robots, share links; default http://localhost:3000).
STATMESH_SITE_URL=https://statmesh.example.com
# "hosted" on any public deployment (also implied when VERCEL is set): turns off /api/ondemand,
# live triggers, /sql/ask and the server-key fallback.
STATMESH_MODE=hosted

# ---- Hosted-mode switches -------------------------------------------------
# Hosted only: set to 1 to let /chat and /sql/ask use the server's own provider keys below.
# Leave unset on a public site.
STATMESH_ALLOW_SERVER_KEY=

# ---- Optional: server-side provider keys for /chat -----------------------
# Used self-hosted, or hosted with STATMESH_ALLOW_SERVER_KEY=1.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LM Studio and Ollama need no env: pick them in the chat settings.

# ---- Optional: free shared assistant for /chat (visitors need no key) -----
# Available only with STATMESH_ALLOW_SERVER_KEY=1 AND STATMESH_FREE_LLM_KEY set. The browser can never
# choose the URL, key or model for it. Probe with GET /api/chat/free-status -> {"available": true|false}.
STATMESH_FREE_LLM_KEY=
# STATMESH_FREE_LLM_BASE_URL=https://api.groq.com/openai/v1
# STATMESH_FREE_LLM_MODEL=openai/gpt-oss-120b
# Fallback, tried once on a primary 429/5xx. Unset key = no fallback.
STATMESH_FREE_LLM_FALLBACK_KEY=
# STATMESH_FREE_LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# STATMESH_FREE_LLM_FALLBACK_MODEL=openrouter/free
# Limits per user turn (defaults shown). Over a limit: HTTP 429 {code:"free_quota_exhausted", message, resetAt}.
# STATMESH_FREE_LIMIT_IP_MIN=5
# STATMESH_FREE_LIMIT_IP_DAY=30
# STATMESH_FREE_LIMIT_GLOBAL_MIN=25
# STATMESH_FREE_LIMIT_GLOBAL_DAY=900
# Per-IP limits key on x-vercel-forwarded-for (set by Vercel). Set 1 ONLY behind your own proxy that overwrites
# x-forwarded-for / x-real-ip; otherwise those client-writable headers are ignored and only the global limits apply.
# STATMESH_TRUST_PROXY=
# Salt for hashing client IPs into counter keys (default: derived from the free key).
# STATMESH_FREE_LIMIT_SALT=
# Shared counters (Upstash Redis REST). Unset = in-memory, per instance and best-effort on serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cache catalogue reads (search, sources, series metadata) for 5 min. Default: on when VERCEL is set,
# off otherwise so a local install sees fresh counts and citation dates. 1 = force on, 0 = force off.
STATMESH_WEB_CACHE=

# ---- Local only ------------------------------------------------------------
# Path to the claude CLI if not on PATH
STATMESH_CLAUDE_BIN=

# ---- Optional: "Request this data" button on empty search results ---------
# https URL of your repo's new-issue page (server-side). Unset = no button.
STATMESH_ISSUES_URL=https://github.com/OWNER/REPO/issues/new

# ---- Optional: "Sign in with Google" (all three set = enabled; any missing = hidden and inert) ----
# Stateless signed-cookie sessions (30 days), no database. Redirect URI to register in Google Cloud:
#   https://<host>/api/auth/callback/google   (http://localhost:3000/api/auth/callback/google for local dev)
# Scopes: openid email profile. Stored in the session: sub, name, email, picture. Nothing else.
# Production requires STATMESH_SITE_URL (above) to be an https URL, or sign-in stays off; it is the only origin used for redirect_uri/cookies.
# Sessions cannot be revoked except by rotating AUTH_SECRET.
# AUTH_SECRET: random, >= 32 chars (e.g. `openssl rand -base64 32`).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Free-assistant turns per signed-in user per UTC day (default 100). Read by lib/auth-core.ts freeLimitUserDay().
# STATMESH_FREE_LIMIT_USER_DAY=100   (clamped to 10% of GLOBAL_DAY)
# STATMESH_FREE_LIMIT_IP_DAY_SIGNED=90   (per-IP daily cap for signed-in users; default 3x IP_DAY)

# ---- Optional: Orrery integration (docs: README "Using StatMesh from Orrery") ----
# NEXT_PUBLIC_ORRERY_URL=https://your-orrery.vercel.app   # shows a "Part of Orrery" strip; unset = hidden
# ORRERY_APP_SECRET=      # same secret as on the API; REQUIRED for /sso (the manifest advertises sso when the API has ORRERY_BASE_URL)
# ORRERY_APP_ID=statmesh  ORRERY_ISSUER=orrery   # defaults shown
