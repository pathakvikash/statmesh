# Names only; set real values in the host's env settings (Vercel: Project Settings > Environment Variables).

# Base URL of the statmesh Python API (server-side only; the browser never calls it).
STATMESH_API_URL=https://api.example.com
# Public origin of this web app (sitemap, robots, share links).
STATMESH_SITE_URL=https://statmesh.example.com
# "hosted" on any public deployment: turns off /api/ondemand, live triggers, /sql/ask and the server-key fallback.
STATMESH_MODE=hosted
# Hosted only: set to 1 to let /chat use the server's own provider keys below. Leave unset on a public site.
STATMESH_ALLOW_SERVER_KEY=
# Server-side provider keys for /chat (self-hosted, or hosted with STATMESH_ALLOW_SERVER_KEY=1).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
