# Copy to .env. Every key is free; sources work without theirs where they have a keyless mode.
STATMESH_CONTACT_EMAIL=          # required by SEC EDGAR (sent in the User-Agent)
FRED_API_KEY=
BLS_API_KEY=
COMTRADE_API_KEY=
DATAGOVIN_API_KEY=
CENSUS_API_KEY=
BEA_API_KEY=
EIA_API_KEY=
COMPANIES_HOUSE_API_KEY=
DATACOMMONS_API_KEY=
# STATMESH_MODE=self_host        # or hosted: serves only redistributable data
# STATMESH_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,api:*  # MCP Host allow-list (DNS rebinding); * disables
# STATMESH_SQL_MAX_BYTES=50000000   # abort a /query result larger than this
# STATMESH_PYTHON_SANDBOX=1      # enables /python and run_python; root-equivalent Docker socket, single-operator machines only (docs/sandbox.md)
