# Copy to .env (gitignored). Placeholders only; never commit real values.
# Load it: `uv run --env-file .env statmesh ...` (docker compose reads it itself).
# Check it:  scripts/env-check.sh [local|hosted]

# ---- Required -------------------------------------------------------------
# Sent in the User-Agent; serve/worker/mcp refuse to start with sec_edgar enabled and this empty
# (or add sec_edgar to STATMESH_DISABLE).
STATMESH_CONTACT_EMAIL=

# ---- Mode and hosted-mode settings ---------------------------------------
# STATMESH_MODE=self_host         # or hosted: serves only redistribute:yes data, no on-demand fetch
# STATMESH_PUBLIC_URL=            # hosted mirror: public origin, no path (OpenAPI servers entry)
# STATMESH_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,api:*  # MCP Host allow-list; set your hostname behind a proxy
# STATMESH_CORS_ORIGINS=          # comma-separated https://host[:port] origins, or *
# STATMESH_CACHE_MAX_AGE=0        # seconds; 300 when hosted
# STATMESH_ONDEMAND=1             # live fetch; off when hosted
# STATMESH_SHARES=1
# STATMESH_SHARE_MAX_BYTES=512000
# STATMESH_SHARE_TTL_DAYS=0       # 0 = forever; 90 when hosted

# ---- Optional runtime settings -------------------------------------------
# STATMESH_DATA_DIR=./data
# STATMESH_DISABLE=               # comma-separated source ids, e.g. datagovin,fred
# STATMESH_CONNECTORS_DIR=
# STATMESH_SQL_TIMEOUT_S=20
# STATMESH_SQL_MAX_ROWS=10000
# STATMESH_SQL_MAX_BYTES=50000000
# STATMESH_FETCH_TIMEOUT_S=30
# STATMESH_FETCH_MAX_ROWS=200000
# STATMESH_FETCH_MAX_WAIT_S=5
# STATMESH_DUCKDB_MEMORY=2GB
# STATMESH_EXPORT_MAX_ROWS=5000000
# STATMESH_PYTHON_SANDBOX=1       # /python and run_python; root-equivalent Docker socket, self-host only (docs/sandbox.md)
# STATMESH_URL=http://localhost:8000   # SDK and CLI without --local

# ---- Connector keys (all free) -------------------------------------------
# Required by their source:
FRED_API_KEY=
DATAGOVIN_API_KEY=
CENSUS_API_KEY=
BEA_API_KEY=
EIA_API_KEY=
DATACOMMONS_API_KEY=
# Optional (keyless mode at a lower limit):
BLS_API_KEY=
COMTRADE_API_KEY=
COMPANIES_HOUSE_API_KEY=

# ---- Benchmark only ------------------------------------------------------
# ANTHROPIC_API_KEY=              # `statmesh bench` LLM judge, if used
# STATMESH_BENCH_MODEL=
