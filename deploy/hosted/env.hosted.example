# Copy to .env.hosted (same directory). Never commit it. Shared by api and worker; no secrets here.
# Source API keys go in .env.worker (see env.worker.example).
STATMESH_SITE_URL=https://stats.example.org   # public URL, no trailing slash (sitemap, robots)
STATMESH_ALLOWED_HOSTS=stats.example.org,api:*  # public hostname + the internal name web uses
STATMESH_CONTACT_EMAIL=ops@example.org          # required while sec_edgar is enabled
# STATMESH_PUBLIC_URL=https://stats.example.org  # origin for the ChatGPT Action server URL; default = first ALLOWED_HOSTS name over https
# STATMESH_CORS_ORIGINS=https://stats.example.org  # comma list; empty = no CORS headers
STATMESH_DUCKDB_MEMORY=1GB                      # api mem_limit is 2g; keep this well below it
# STATMESH_DISABLE=comtrade,imf                 # sources that must never touch this box's disk
# STATMESH_HTTP_BIND=127.0.0.1:8080             # nginx port; put a TLS proxy in front
# STATMESH_DATA=./data                          # host path for the data volume
